@model CompletenessChecklistViewModel
@{
    var c = Model.Completeness;
    var matchVariant = c.TotalScore >= CandidateProfileRules.DiscoverableCompletenessThreshold
        ? "c-match--strong"
        : c.TotalScore >= CandidateProfileRules.ApplyCompletenessThreshold
            ? "c-match--good"
            : "c-match--partial";

    var pointsToApply = Math.Max(0, CandidateProfileRules.ApplyCompletenessThreshold - c.TotalScore);
    var pointsToDiscover = Math.Max(0, CandidateProfileRules.DiscoverableCompletenessThreshold - c.TotalScore);
    var hasDeferredPending = c.Items.Any(i => i.IsDeferred && !i.IsComplete);
}

<section id="completeness-checklist" class="c-card" aria-labelledby="completeness-checklist-heading">
    <div class="c-card__header" style="align-items: flex-start; flex-wrap: wrap; gap: 16px;">
        <div style="flex: 1 1 300px;">
            <h2 id="completeness-checklist-heading" style="font-size: 20px; margin-bottom: 4px;">Profile Completion Checklist</h2>
            @if (c.NextBestStep is not null)
            {
                <div class="p-sg-row" style="gap: 8px; margin-top: 6px;">
                    <p class="c-hint" style="margin: 0;">
                        <strong>Next best step:</strong> @c.NextBestStep.Label (<strong>+@c.NextBestStep.Points</strong>)
                    </p>
                    <a asp-controller="Candidate"
                       asp-action="Onboarding"
                       asp-route-step="@c.NextBestStep.OnboardingStep"
                       class="c-btn c-btn--primary c-btn--sm">
                        Fix in Step @c.NextBestStep.OnboardingStep &rarr;
                    </a>
                </div>
            }
            else if (c.TotalScore >= 100)
            {
                <p class="c-hint" style="margin: 4px 0 0 0;">
                    Your profile is <strong>100% complete</strong> across every matching and verification signal.
                </p>
            }
            else if (hasDeferredPending)
            {
                <p class="c-hint" style="margin: 4px 0 0 0;">
                    All active profile items are complete (<strong>@c.TotalScore%</strong> &mdash; above both the 60% apply and 70% studio search gates). Phone OTP (+10) unlocks in an upcoming release.
                </p>
            }
        </div>

        <div class="c-threshold-meter" style="min-width: 280px; flex: 0 1 360px;">
            <div class="c-match @matchVariant">
                <div class="c-match__top">
                    <span>
                        @(c.MeetsDiscoverabilityThreshold
                            ? "Studio-discoverable (≥ 70%)"
                            : c.MeetsApplyThreshold
                                ? "Apply-ready (≥ 60%)"
                                : "Below 60% apply threshold")
                    </span>
                    <span class="c-match__score">@c.TotalScore%</span>
                </div>
                <div class="c-threshold-track-wrap">
                    <div class="c-match__track">
                        <div class="c-match__fill" style="width: @(c.TotalScore)%;"></div>
                    </div>
                    <span class="c-threshold-marker" style="left: 60%;" title="60% minimum to apply to jobs" aria-hidden="true"></span>
                    <span class="c-threshold-marker c-threshold-marker--discover" style="left: 70%;" title="70% minimum to appear in studio searches" aria-hidden="true"></span>
                </div>
            </div>

            <div class="c-threshold-gates">
                <div class="c-threshold-gate @(c.MeetsApplyThreshold ? "is-unlocked" : null)">
                    <span class="u-mono" style="font-weight: 700;">60% to apply</span>
                    <span class="c-hint" style="margin: 0;">
                        @(c.MeetsApplyThreshold ? "Unlocked ✓" : $"+{pointsToApply} pts needed")
                    </span>
                </div>
                <div class="c-threshold-gate @(c.MeetsDiscoverabilityThreshold ? "is-unlocked" : null)">
                    <span class="u-mono" style="font-weight: 700;">70% studio search</span>
                    <span class="c-hint" style="margin: 0;">
                        @(c.MeetsDiscoverabilityThreshold ? "Unlocked ✓" : $"+{pointsToDiscover} pts needed")
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.IsCompact)
    {
        <div class="c-table-wrap">
            <table class="c-table">
                <thead>
                    <tr>
                        <th scope="col">Completeness Signal</th>
                        <th scope="col">Points</th>
                        <th scope="col">Status</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in c.Items)
                    {
                        <tr>
                            <td>
                                @item.Label
                                @if (c.NextBestStep is not null && string.Equals(c.NextBestStep.Key, item.Key, StringComparison.Ordinal))
                                {
                                    <span class="c-badge c-badge--accent" style="margin-left: 6px;">Next best step</span>
                                }
                            </td>
                            <td class="u-mono">+@item.Points</td>
                            <td>
                                @if (item.IsComplete)
                                {
                                    <span class="c-badge c-badge--success">Complete</span>
                                }
                                else if (item.IsDeferred)
                                {
                                    <span class="c-badge c-badge--info">Coming soon</span>
                                }
                                else
                                {
                                    <span class="c-badge c-badge--neutral">Pending</span>
                                }
                            </td>
                            <td>
                                @if (item.IsDeferred && !item.IsComplete)
                                {
                                    <span class="c-hint">Phone OTP coming soon</span>
                                }
                                else
                                {
                                    <a asp-controller="Candidate"
                                       asp-action="Onboarding"
                                       asp-route-step="@item.OnboardingStep"
                                       class="c-btn c-btn--ghost c-btn--sm">
                                        @(item.IsComplete ? "Review" : "Fix") (Step @item.OnboardingStep)
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
