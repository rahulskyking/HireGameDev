@model ResumeImportPageViewModel
@{
    ViewData["Title"] = "Import from Resume or LinkedIn PDF";
    var quota = Model.Quota;
    var quotaExhausted = quota.RemainingToday <= 0;
    var r = Model.Review;

    var selectedCity = Model.Cities.FirstOrDefault(c => c.Id == r.CityId);
    var selectedCityLabel = selectedCity is null
        ? string.Empty
        : $"{selectedCity.Name}, {selectedCity.StateCode}";

    (DisciplineCategory Value, string Title, string Subtitle)[] disciplines =
    [
        (DisciplineCategory.Programming, "Programming", "Gameplay, Engine, Tools, Network, AI"),
        (DisciplineCategory.Art, "Art & Tech Art", "2D/3D, Shaders, VFX, Rigging, Animation"),
        (DisciplineCategory.Design, "Game Design", "Systems, Combat, Level, Economy, Narrative"),
        (DisciplineCategory.Audio, "Audio", "Sound Design, Music, Wwise, FMOD"),
        (DisciplineCategory.Qa, "QA", "Functionality, Automation, Cert, Performance"),
        (DisciplineCategory.Production, "Production", "Producer, LiveOps, Project Management")
    ];

    (string Value, string Label)[] platformOptions =
    [
        ("pc", "PC"),
        ("android", "Android"),
        ("ios", "iOS"),
        ("console", "Console"),
        ("web", "Web")
    ];
}

<div class="p-sg-stack">
    <header class="p-sg-section">
        <div class="c-card__header" style="align-items: flex-start; gap: 16px; flex-wrap: wrap;">
            <div>
                <div class="p-hero__eyebrow">
                    <span class="p-hero__dot" aria-hidden="true"></span>
                    <span>Candidate Onboarding &middot; Privacy-First PDF Extraction</span>
                </div>
                <h1 style="margin-bottom: 6px;">Import from Resume or LinkedIn PDF</h1>
                <p class="u-muted" style="margin: 0; max-width: 720px;">
                    Upload a text-based PDF resume or LinkedIn &ldquo;Save to PDF&rdquo; export to pre-fill an editable draft.
                    <strong>Nothing is saved to your profile until you review and confirm below.</strong>
                </p>
            </div>

            <div class="c-btn-group">
                <span class="c-badge @(quotaExhausted ? "c-badge--warning" : "c-badge--info")"
                      title="Daily AI parse allowance resets at 00:00 UTC">
                    @quota.RemainingToday / @quota.DailyLimit imports left today
                </span>
                @if (Model.HasExistingProfile)
                {
                    <a asp-controller="Candidate" asp-action="Profile" class="c-btn c-btn--secondary c-btn--sm">Back to Profile</a>
                }
                else
                {
                    <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="1" class="c-btn c-btn--secondary c-btn--sm">Back to Onboarding</a>
                }
            </div>
        </div>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="c-alert c-alert--success" role="status">
                <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 10.5 8 14.5 16 6.5" /></svg>
                <div class="c-alert__content"><p>@statusMessage</p></div>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="c-alert c-alert--danger" role="alert"></div>
        }
    </header>

    <!-- Upload & Privacy Card -->
    <section class="c-card" aria-labelledby="resume-upload-heading">
        <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
            <div>
                <h2 id="resume-upload-heading" style="font-size: 20px; margin: 0 0 4px 0;">1. Upload Resume or LinkedIn PDF</h2>
                <p class="c-hint" style="margin: 0;">
                    On LinkedIn, open your profile &rarr; click <strong>Resources</strong> (or <strong>More</strong>) &rarr; <strong>Save to PDF</strong>, then upload that file here. We never scrape LinkedIn URLs.
                </p>
            </div>
            <span class="c-badge c-badge--neutral">PDF only &middot; Max 2 MB</span>
        </div>

        <div class="c-resume-privacy" role="note" aria-label="Resume privacy guarantees">
            <div class="c-resume-privacy__item">
                <span class="c-badge c-badge--success">PII Stripped</span>
                <span>Emails, phone numbers, Aadhaar, and PAN identifiers are redacted before extraction.</span>
            </div>
            <div class="c-resume-privacy__item">
                <span class="c-badge c-badge--info">Zero Retention</span>
                <span>Your PDF and raw resume text are processed in memory and discarded immediately after parsing.</span>
            </div>
            <div class="c-resume-privacy__item">
                <span class="c-badge c-badge--accent">Review Gate</span>
                <span>Imported skills start as <em>Self-declared</em> until backed by shipped titles or portfolio proof.</span>
            </div>
        </div>

        <form asp-controller="Candidate"
              asp-action="ParseResume"
              method="post"
              enctype="multipart/form-data"
              class="c-form"
              data-resume-pdf-uploader>
            <div class="c-resume-dropzone">
                <div class="c-field" style="margin: 0; flex: 1 1 280px;">
                    <label for="resume-pdf-input" class="c-label">Select PDF document</label>
                    <input id="resume-pdf-input"
                           name="resumePdf"
                           type="file"
                           accept=".pdf,application/pdf"
                           class="c-input"
                           data-resume-pdf-input
                           data-max-bytes="@ResumePdfUploadRules.MaxPdfUploadBytes"
                           disabled="@(quotaExhausted ? "disabled" : null)" />
                    <p class="c-hint" style="margin-top: 6px;">
                        Text-selectable PDFs only (at least @ResumePdfUploadRules.MinExtractedTextChars characters). Scanned image PDFs are rejected without counting against your daily quota.
                    </p>
                </div>

                <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
                    <span class="c-avatar-modal__filename" data-resume-pdf-filename hidden></span>
                    <button type="submit"
                            class="c-btn c-btn--primary"
                            data-resume-pdf-submit
                            disabled="@(quotaExhausted ? "disabled" : null)">
                        @(Model.HasParsedDraft ? "Re-parse Another PDF" : "Extract & Review Draft")
                    </button>
                </div>
            </div>
            <p class="c-avatar-modal__error" data-resume-pdf-error role="alert" hidden></p>
        </form>
    </section>

    @if (Model.HasParsedDraft)
    {
        <form asp-controller="Candidate" asp-action="ApplyResumeImport" method="post" class="p-sg-stack" novalidate>
            <!-- Draft Status Banner -->
            <section class="c-alert c-alert--info" role="status">
                <div class="c-alert__content" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; width: 100%;">
                    <div>
                        <strong>Draft ready for review</strong>
                        @if (Model.DetectedSource == ResumeParseSource.LinkedinPdf)
                        {
                            <span> &middot; Detected LinkedIn PDF export</span>
                        }
                        else if (Model.DetectedSource == ResumeParseSource.Pdf)
                        {
                            <span> &middot; Standard PDF resume</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ProviderName))
                        {
                            <span class="u-muted"> (@Model.ProviderName extractor)</span>
                        }
                        <p class="c-hint" style="margin: 4px 0 0 0;">
                            Edit any field or uncheck items you want to skip. Duplicate skills, experience, education, and shipped titles already on your profile are skipped automatically.
                        </p>
                    </div>
                    <button type="submit" class="c-btn c-btn--primary c-btn--sm">Confirm &amp; Apply Selected</button>
                </div>
            </section>

            @if (!Model.HasExistingProfile)
            {
                <!-- First-Time Candidate Basics (Required when no profile exists yet) -->
                <section class="c-card" aria-labelledby="import-basics-heading">
                    <div class="c-card__header">
                        <div>
                            <h2 id="import-basics-heading" style="font-size: 20px; margin: 0 0 4px 0;">2. Core Profile Basics (Required First Time)</h2>
                            <p class="c-hint" style="margin: 0;">Choose your primary game dev discipline and Indian city hub so we can create your profile along with this import.</p>
                        </div>
                        <span class="c-badge c-badge--accent">Step 1 Basics</span>
                    </div>

                    <div class="c-form">
                        <div class="c-field">
                            <label class="c-label" for="review-fullname">Full Name</label>
                            <input id="review-fullname"
                                   name="Review.FullName"
                                   value="@r.FullName"
                                   class="c-input"
                                   maxlength="120"
                                   placeholder="Aarav Sharma" />
                        </div>

                        <fieldset class="c-field" style="border: 0; padding: 0; margin: 0;">
                            <legend class="c-label" style="margin-bottom: 8px;">Primary Discipline</legend>
                            <div class="p-sg-grid-3">
                                @foreach (var d in disciplines)
                                {
                                    var isChecked = r.PrimaryCategory == d.Value;
                                    <label class="c-role-card @(isChecked ? "is-selected" : string.Empty)">
                                        <input type="radio"
                                               name="Review.PrimaryCategory"
                                               value="@d.Value"
                                               checked="@(isChecked ? "checked" : null)"
                                               data-discipline-radio />
                                        <span class="c-role-card__title">@d.Title</span>
                                        <span class="c-role-card__desc">@d.Subtitle</span>
                                    </label>
                                }
                            </div>
                        </fieldset>

                        <div class="c-field" data-combobox>
                            <label class="c-label" for="import-city-search">Primary City (India)</label>
                            <input id="import-city-search"
                                   class="c-input"
                                   type="text"
                                   value="@selectedCityLabel"
                                   placeholder="Search city (e.g. Bengaluru, Pune, Hyderabad, Mumbai, Chennai...)"
                                   autocomplete="off"
                                   data-combobox-input />
                            <input type="hidden" name="Review.CityId" value="@r.CityId" data-combobox-value />
                            <ul class="c-combobox__list" role="listbox" aria-label="Indian cities" style="max-height: 220px; overflow-y: auto;">
                                @foreach (var city in Model.Cities)
                                {
                                    var isSelected = city.Id == r.CityId;
                                    var displayLabel = $"{city.Name}, {city.StateCode}";
                                    var aliasKeywords = string.Join(' ', city.Aliases) + " " + city.State + " " + (city.MetroGroup ?? string.Empty);
                                    <li class="c-combobox__option"
                                        role="option"
                                        aria-selected="@(isSelected ? "true" : "false")"
                                        data-combobox-option
                                        data-value="@city.Id"
                                        data-label="@displayLabel"
                                        data-search-keywords="@aliasKeywords">
                                        <span>@city.Name, @city.State</span>
                                        <span class="c-combobox__option-meta">@(city.IsHub ? $"Gaming Hub · {city.StateCode}" : city.StateCode)</span>
                                    </li>
                                }
                            </ul>
                            <p class="c-combobox__empty" data-combobox-empty hidden>No matching Indian city found.</p>
                        </div>
                    </div>
                </section>
            }

            <!-- Headline & Experience Summary -->
            <section class="c-card" aria-labelledby="import-summary-heading">
                <div class="c-card__header">
                    <div>
                        <h2 id="import-summary-heading" style="font-size: 20px; margin: 0 0 4px 0;">Headline &amp; Total Experience</h2>
                        <p class="c-hint" style="margin: 0;">Toggle whether to update your profile headline and years of game/software experience.</p>
                    </div>
                </div>

                <div class="p-sg-grid-2">
                    <div class="c-field">
                        <label class="c-check" style="margin-bottom: 8px;">
                            <input type="checkbox"
                                   name="Review.ApplyHeadline"
                                   value="true"
                                   checked="@(r.ApplyHeadline ? "checked" : null)" />
                            <span><strong>Apply Headline</strong> (3–80 characters)</span>
                        </label>
                        <input type="text"
                               name="Review.Headline"
                               value="@r.Headline"
                               maxlength="80"
                               class="c-input"
                               placeholder="e.g. Senior Gameplay Programmer · Unreal Engine 5 & C++" />
                    </div>

                    <div class="c-field">
                        <label class="c-check" style="margin-bottom: 8px;">
                            <input type="checkbox"
                                   name="Review.ApplyYearsExperience"
                                   value="true"
                                   checked="@(r.ApplyYearsExperience ? "checked" : null)" />
                            <span><strong>Apply Years of Experience</strong> (0–50, 0.5 increments)</span>
                        </label>
                        <input type="number"
                               name="Review.YearsExperience"
                               value="@(r.YearsExperience?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                               min="0"
                               max="50"
                               step="0.5"
                               class="c-input"
                               placeholder="e.g. 3.5" />
                    </div>
                </div>
            </section>

            <!-- Matched Taxonomy Skills + Unmatched Suggestions -->
            <section class="c-card" aria-labelledby="import-skills-heading" data-import-group>
                <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                    <div>
                        <h2 id="import-skills-heading" style="font-size: 20px; margin: 0 0 4px 0;">Matched Taxonomy Skills (@r.Skills.Count)</h2>
                        <p class="c-hint" style="margin: 0;">
                            Mapped strictly against our canonical game-dev skill catalog. Adjust proficiency, years used, or primary highlights (up to 5 total).
                        </p>
                    </div>
                    @if (r.Skills.Count > 0)
                    {
                        <div class="c-btn-group">
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="true">Select all</button>
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="false">Clear all</button>
                        </div>
                    }
                </div>

                @if (r.Skills.Count == 0)
                {
                    <p class="u-muted" style="margin: 0;">No canonical taxonomy skills were detected in this PDF. You can add skills manually in Step 3.</p>
                }
                else
                {
                    <div class="c-table-wrap">
                        <table class="c-table">
                            <thead>
                                <tr>
                                    <th style="width: 64px;">Import</th>
                                    <th>Skill</th>
                                    <th>Proficiency</th>
                                    <th style="width: 120px;">Years</th>
                                    <th style="width: 130px;">Last Used</th>
                                    <th style="width: 90px;">Primary</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < r.Skills.Count; i++)
                                {
                                    var s = r.Skills[i];
                                    <tr>
                                        <td>
                                            <input type="checkbox"
                                                   name="Review.Skills[@i].Include"
                                                   value="true"
                                                   checked="@(s.Include ? "checked" : null)"
                                                   data-import-item-check
                                                   aria-label="Import @s.SkillName" />
                                            <input type="hidden" name="Review.Skills[@i].SkillId" value="@s.SkillId" />
                                            <input type="hidden" name="Review.Skills[@i].SkillName" value="@s.SkillName" />
                                            <input type="hidden" name="Review.Skills[@i].Category" value="@s.Category" />
                                            <input type="hidden" name="Review.Skills[@i].MatchKind" value="@s.MatchKind" />
                                            <input type="hidden" name="Review.Skills[@i].RawExtractedName" value="@s.RawExtractedName" />
                                        </td>
                                        <td>
                                            <div style="font-weight: 600;">@s.SkillName</div>
                                            <div class="c-badge-row" style="margin-top: 4px;">
                                                <span class="c-badge c-badge--neutral">@s.Category</span>
                                                @if (!string.Equals(s.SkillName, s.RawExtractedName, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(s.RawExtractedName))
                                                {
                                                    <span class="c-badge c-badge--info" title="Matched via @s.MatchKind">from &ldquo;@s.RawExtractedName&rdquo;</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <select name="Review.Skills[@i].Proficiency" class="c-select" aria-label="@s.SkillName proficiency">
                                                @foreach (var level in Enum.GetValues<SkillProficiency>())
                                                {
                                                    <option value="@level" selected="@(s.Proficiency == level ? "selected" : null)">@level</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="Review.Skills[@i].YearsUsed"
                                                   value="@(s.YearsUsed?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                                   min="0"
                                                   max="50"
                                                   step="0.5"
                                                   class="c-input"
                                                   placeholder="—" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="Review.Skills[@i].LastUsedYear"
                                                   value="@s.LastUsedYear"
                                                   min="1990"
                                                   max="2100"
                                                   step="1"
                                                   class="c-input"
                                                   placeholder="YYYY" />
                                        </td>
                                        <td>
                                            <input type="checkbox"
                                                   name="Review.Skills[@i].IsPrimary"
                                                   value="true"
                                                   checked="@(s.IsPrimary ? "checked" : null)"
                                                   aria-label="Mark @s.SkillName as primary skill" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (r.UnmatchedSkillSuggestions.Count > 0)
                {
                    <div class="c-alert c-alert--warning" style="margin-top: 12px;" role="note">
                        <div class="c-alert__content">
                            <strong>Unmatched terms skipped (@r.UnmatchedSkillSuggestions.Count)</strong>
                            <p style="margin: 4px 0 8px 0;">
                                These terms did not match our canonical game-dev skill taxonomy and will not pollute your structured skill tags (you can mention them in your bio or experience bullets):
                            </p>
                            <div class="c-badge-row">
                                @for (var u = 0; u < r.UnmatchedSkillSuggestions.Count; u++)
                                {
                                    var term = r.UnmatchedSkillSuggestions[u];
                                    <span class="c-badge c-badge--neutral">@term</span>
                                    <input type="hidden" name="Review.UnmatchedSkillSuggestions[@u]" value="@term" />
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>

            <!-- Work Experiences -->
            <section class="c-card" aria-labelledby="import-exp-heading" data-import-group>
                <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                    <div>
                        <h2 id="import-exp-heading" style="font-size: 20px; margin: 0 0 4px 0;">Work Experience (@r.Experiences.Count)</h2>
                        <p class="c-hint" style="margin: 0;">Verify studio/company names, titles, and dates. Experience descriptions also count toward skill evidence matching.</p>
                    </div>
                    @if (r.Experiences.Count > 0)
                    {
                        <div class="c-btn-group">
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="true">Select all</button>
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="false">Clear all</button>
                        </div>
                    }
                </div>

                @if (r.Experiences.Count == 0)
                {
                    <p class="u-muted" style="margin: 0;">No structured work experience rows were extracted from this PDF.</p>
                }
                else
                {
                    <div class="p-sg-section">
                        @for (var i = 0; i < r.Experiences.Count; i++)
                        {
                            var exp = r.Experiences[i];
                            <div class="c-repeat-card" data-repeat-card>
                                <div class="c-card__header" style="margin-bottom: 10px;">
                                    <label class="c-check">
                                        <input type="checkbox"
                                               name="Review.Experiences[@i].Include"
                                               value="true"
                                               checked="@(exp.Include ? "checked" : null)"
                                               data-import-item-check />
                                        <span><strong>Import Experience #@(i + 1)</strong></span>
                                    </label>
                                    <label class="c-check">
                                        <input type="checkbox"
                                               name="Review.Experiences[@i].IsCurrent"
                                               value="true"
                                               checked="@(exp.IsCurrent ? "checked" : null)"
                                               data-exp-current />
                                        <span>Currently working here</span>
                                    </label>
                                </div>

                                <div class="p-sg-grid-2">
                                    <div class="c-field">
                                        <label class="c-label">Company / Studio Name</label>
                                        <input type="text"
                                               name="Review.Experiences[@i].CompanyName"
                                               value="@exp.CompanyName"
                                               maxlength="160"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Role / Title</label>
                                        <input type="text"
                                               name="Review.Experiences[@i].Title"
                                               value="@exp.Title"
                                               maxlength="160"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Start Date</label>
                                        <input type="date"
                                               name="Review.Experiences[@i].StartDate"
                                               value="@(exp.StartDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">End Date</label>
                                        <input type="date"
                                               name="Review.Experiences[@i].EndDate"
                                               value="@(exp.IsCurrent ? string.Empty : exp.EndDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))"
                                               data-field="EndDate"
                                               disabled="@(exp.IsCurrent ? "disabled" : null)"
                                               class="c-input" />
                                    </div>
                                </div>

                                <div class="c-field" style="margin-top: 10px;">
                                    <label class="c-label">Summary / Key Contributions (Optional)</label>
                                    <textarea name="Review.Experiences[@i].Description"
                                              rows="3"
                                              maxlength="1500"
                                              class="c-textarea">@exp.Description</textarea>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Education -->
            <section class="c-card" aria-labelledby="import-edu-heading" data-import-group>
                <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                    <div>
                        <h2 id="import-edu-heading" style="font-size: 20px; margin: 0 0 4px 0;">Education (@r.Education.Count)</h2>
                        <p class="c-hint" style="margin: 0;">Degrees, diplomas, or game dev programs (unlocks +15 completeness points for Freshers).</p>
                    </div>
                    @if (r.Education.Count > 0)
                    {
                        <div class="c-btn-group">
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="true">Select all</button>
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="false">Clear all</button>
                        </div>
                    }
                </div>

                @if (r.Education.Count == 0)
                {
                    <p class="u-muted" style="margin: 0;">No structured education entries were extracted from this PDF.</p>
                }
                else
                {
                    <div class="p-sg-section">
                        @for (var i = 0; i < r.Education.Count; i++)
                        {
                            var edu = r.Education[i];
                            <div class="c-repeat-card">
                                <div class="c-card__header" style="margin-bottom: 10px;">
                                    <label class="c-check">
                                        <input type="checkbox"
                                               name="Review.Education[@i].Include"
                                               value="true"
                                               checked="@(edu.Include ? "checked" : null)"
                                               data-import-item-check />
                                        <span><strong>Import Education #@(i + 1)</strong></span>
                                    </label>
                                </div>

                                <div class="p-sg-grid-3">
                                    <div class="c-field">
                                        <label class="c-label">Institution</label>
                                        <input type="text"
                                               name="Review.Education[@i].Institution"
                                               value="@edu.Institution"
                                               maxlength="200"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Degree / Program</label>
                                        <input type="text"
                                               name="Review.Education[@i].Degree"
                                               value="@edu.Degree"
                                               maxlength="160"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Field of Study (Optional)</label>
                                        <input type="text"
                                               name="Review.Education[@i].Field"
                                               value="@edu.Field"
                                               maxlength="160"
                                               class="c-input" />
                                    </div>
                                </div>

                                <div class="p-sg-grid-2" style="margin-top: 10px;">
                                    <div class="c-field">
                                        <label class="c-label">Start Year (Optional)</label>
                                        <input type="number"
                                               name="Review.Education[@i].StartYear"
                                               value="@edu.StartYear"
                                               min="1950"
                                               max="2100"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">End / Graduation Year (Optional)</label>
                                        <input type="number"
                                               name="Review.Education[@i].EndYear"
                                               value="@edu.EndYear"
                                               min="1950"
                                               max="2100"
                                               class="c-input" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Shipped Titles -->
            <section class="c-card" aria-labelledby="import-titles-heading" data-import-group>
                <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                    <div>
                        <h2 id="import-titles-heading" style="font-size: 20px; margin: 0 0 4px 0;">Shipped Titles &amp; Game Credits (@r.ShippedTitles.Count)</h2>
                        <p class="c-hint" style="margin: 0;">Confirm studio/team name, your role, engine, and target platforms. You can add store URLs or NDA flags afterwards in Step 4.</p>
                    </div>
                    @if (r.ShippedTitles.Count > 0)
                    {
                        <div class="c-btn-group">
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="true">Select all</button>
                            <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-import-toggle-all="false">Clear all</button>
                        </div>
                    }
                </div>

                @if (r.ShippedTitles.Count == 0)
                {
                    <p class="u-muted" style="margin: 0;">No shipped game titles were detected in this PDF.</p>
                }
                else
                {
                    <div class="p-sg-section">
                        @for (var i = 0; i < r.ShippedTitles.Count; i++)
                        {
                            var t = r.ShippedTitles[i];
                            <div class="c-repeat-card">
                                <div class="c-card__header" style="margin-bottom: 10px;">
                                    <label class="c-check">
                                        <input type="checkbox"
                                               name="Review.ShippedTitles[@i].Include"
                                               value="true"
                                               checked="@(t.Include ? "checked" : null)"
                                               data-import-item-check />
                                        <span><strong>Import Title #@(i + 1)</strong></span>
                                    </label>
                                </div>

                                <div class="p-sg-grid-3">
                                    <div class="c-field">
                                        <label class="c-label">Game / Project Name</label>
                                        <input type="text"
                                               name="Review.ShippedTitles[@i].GameName"
                                               value="@t.GameName"
                                               maxlength="160"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Studio / Team Name</label>
                                        <input type="text"
                                               name="Review.ShippedTitles[@i].StudioName"
                                               value="@t.StudioName"
                                               maxlength="160"
                                               placeholder="e.g. Indie / Studio Name"
                                               class="c-input" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Your Role</label>
                                        <input type="text"
                                               name="Review.ShippedTitles[@i].Role"
                                               value="@t.Role"
                                               maxlength="120"
                                               placeholder="e.g. Gameplay Programmer"
                                               class="c-input" />
                                    </div>
                                </div>

                                <div class="p-sg-grid-2" style="margin-top: 10px;">
                                    <div class="c-field">
                                        <label class="c-label">Primary Engine (Optional)</label>
                                        <select name="Review.ShippedTitles[@i].EngineSkillId" class="c-select">
                                            <option value="">— Select engine —</option>
                                            @foreach (var eng in Model.EngineSkills)
                                            {
                                                <option value="@eng.Id" selected="@(t.EngineSkillId == eng.Id ? "selected" : null)">@eng.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Release Year (Optional)</label>
                                        <input type="number"
                                               name="Review.ShippedTitles[@i].ReleaseYear"
                                               value="@t.ReleaseYear"
                                               min="1990"
                                               max="2100"
                                               class="c-input" />
                                    </div>
                                </div>

                                <div class="c-field" style="margin-top: 10px;">
                                    <span class="c-label">Platforms (Optional)</span>
                                    <div class="p-sg-row" style="margin-top: 4px;">
                                        @foreach (var plat in platformOptions)
                                        {
                                            var hasPlat = t.Platforms.Any(p => string.Equals(p, plat.Value, StringComparison.OrdinalIgnoreCase));
                                            <label class="c-check">
                                                <input type="checkbox"
                                                       name="Review.ShippedTitles[@i].Platforms"
                                                       value="@plat.Value"
                                                       checked="@(hasPlat ? "checked" : null)" />
                                                <span>@plat.Label</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Bottom Action Bar -->
            <div class="c-card" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;">
                <p class="c-hint" style="margin: 0;">
                    Confirming applies only checked items and recomputes your completeness &amp; skill evidence levels automatically.
                </p>
                <div class="c-btn-group">
                    @if (Model.HasExistingProfile)
                    {
                        <a asp-controller="Candidate" asp-action="Profile" class="c-btn c-btn--ghost">Discard Draft</a>
                    }
                    else
                    {
                        <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="1" class="c-btn c-btn--ghost">Discard Draft</a>
                    }
                    <button type="submit" class="c-btn c-btn--primary">Confirm &amp; Apply to Profile</button>
                </div>
            </div>
        </form>
    }
</div>
