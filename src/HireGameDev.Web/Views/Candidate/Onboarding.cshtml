@model CandidateOnboardingWizardViewModel
@{
    ViewData["Title"] = $"Developer Onboarding · Step {Model.ActiveStep} of 5";
    var breakdown = Model.OnboardingState.CompletenessBreakdown;
    var score = breakdown.TotalScore;
    var matchVariant = score >= 70 ? "c-match--strong" : score >= 60 ? "c-match--good" : "c-match--partial";
    var highestStep = Model.HighestReachedStep.Value;

    var selectedCity = Model.Cities.FirstOrDefault(c => c.Id == Model.Step1.CityId);
    var selectedCityLabel = selectedCity is null
        ? string.Empty
        : $"{selectedCity.Name}, {selectedCity.StateCode}";

    var allowedSeniorities = CandidateProfileRules.GetAllowedSeniorityLevels(Model.Step2.YearsExperience);
    var suggestedSeniority = CandidateProfileRules.SuggestSeniorityFromYears(Model.Step2.YearsExperience);

    (DisciplineCategory Value, string Title, string Subtitle)[] disciplines =
    [
        (DisciplineCategory.Programming, "Programming", "Gameplay, Engine, Tools, Network, AI"),
        (DisciplineCategory.Art, "Art & Tech Art", "2D/3D, Shaders, VFX, Rigging, Animation"),
        (DisciplineCategory.Design, "Game Design", "Systems, Combat, Level, Economy, Narrative"),
        (DisciplineCategory.Audio, "Audio", "Sound Design, Music, Wwise, FMOD"),
        (DisciplineCategory.Qa, "QA", "Functionality, Automation, Cert, Performance"),
        (DisciplineCategory.Production, "Production", "Producer, LiveOps, Project Management")
    ];
}

<div class="p-sg-stack">
    <header class="p-sg-section">
        <div class="c-card__header" style="align-items: flex-start; gap: 16px; flex-wrap: wrap;">
            <div>
                <div class="p-hero__eyebrow">
                    <span class="p-hero__dot" aria-hidden="true"></span>
                    <span>Candidate Onboarding &middot; Draft Saved Every Step</span>
                </div>
                <h1 style="margin-bottom: 6px;">Build your game developer profile</h1>
                <p class="u-muted" style="margin: 0;">
                    Structured signals power hard-filter matching. Reach <strong>60%</strong> to apply to roles and <strong>70%</strong> to appear in studio searches.
                </p>
            </div>

            <div class="c-card" style="min-width: 260px; padding: 14px 16px;">
                <div class="c-match @matchVariant" style="width: 100%;">
                    <div class="c-match__top">
                        <span>Profile completeness</span>
                        <span class="c-match__score">@score%</span>
                    </div>
                    <div class="c-match__track">
                        <div class="c-match__fill" style="width: @(score)%;"></div>
                    </div>
                </div>
                <div class="c-badge-row" style="margin-top: 10px;">
                    <span class="c-badge @(breakdown.MeetsApplyThreshold ? "c-badge--success" : "c-badge--neutral")">
                        60% Apply @(breakdown.MeetsApplyThreshold ? "✓" : "gate")
                    </span>
                    <span class="c-badge @(breakdown.MeetsDiscoverabilityThreshold ? "c-badge--success" : "c-badge--neutral")">
                        70% Search @(breakdown.MeetsDiscoverabilityThreshold ? "✓" : "gate")
                    </span>
                </div>
            </div>
        </div>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="c-alert c-alert--success" role="status">
                <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 10.5 8 14.5 16 6.5" /></svg>
                <div class="c-alert__content"><p>@statusMessage</p></div>
            </div>
        }

        <ol class="c-stepper" aria-label="Candidate onboarding steps">
            @{
                (short Step, string Label)[] steps =
                [
                    (1, "Basics"),
                    (2, "Experience"),
                    (3, "Skills"),
                    (4, "Proof"),
                    (5, "Preferences")
                ];
            }
            @foreach (var item in steps)
            {
                var isCurrent = Model.ActiveStep == item.Step;
                var isComplete = Model.HasExistingProfile && highestStep > item.Step && !isCurrent;
                var canNavigate = Model.HasExistingProfile || item.Step == 1;
                var stateClass = isCurrent ? "is-current" : isComplete ? "is-complete" : string.Empty;

                <li class="c-stepper__item @stateClass">
                    <span class="c-stepper__index">@(isComplete ? "✓" : item.Step.ToString())</span>
                    @if (canNavigate && !isCurrent)
                    {
                        <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="@item.Step" style="text-decoration: none; color: inherit;">
                            @item.Label
                        </a>
                    }
                    else
                    {
                        <span>@item.Label</span>
                    }
                </li>
            }
        </ol>
    </header>

    @if (Model.ActiveStep == 1)
    {
        <section class="c-card" aria-labelledby="step1-heading">
            <div class="c-card__header">
                <div>
                    <h2 id="step1-heading" style="font-size: 22px; margin-bottom: 4px;">Step 1 &middot; Core Basics</h2>
                    <p class="c-hint">Your discipline, role headline, and primary Indian city hub.</p>
                </div>
                @if (Model.HasExistingProfile)
                {
                    <a asp-controller="Candidate" asp-action="Profile" class="c-btn c-btn--ghost c-btn--sm">View Profile Hub</a>
                }
            </div>

            <form asp-controller="Candidate" asp-action="SaveStep1" method="post" class="c-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

                <div class="p-sg-grid-2">
                    <div class="c-field">
                        <label asp-for="Step1.FullName" class="c-label"></label>
                        <input asp-for="Step1.FullName" class="c-input" autocomplete="name" placeholder="Aarav Sharma" />
                        <span asp-validation-for="Step1.FullName"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="Step1.Headline" class="c-label"></label>
                        <input asp-for="Step1.Headline" class="c-input" placeholder="e.g. Unity Gameplay Programmer · C# & Netcode" />
                        <p class="c-hint">3–80 characters (+5 completeness points).</p>
                        <span asp-validation-for="Step1.Headline"></span>
                    </div>
                </div>

                <fieldset class="c-field" style="border: 0; padding: 0; margin: 0;">
                    <legend class="c-label" style="margin-bottom: 8px;">Primary Discipline</legend>
                    <div class="p-sg-grid-3">
                        @foreach (var d in disciplines)
                        {
                            var isChecked = Model.Step1.PrimaryCategory == d.Value;
                            <label class="c-role-card @(isChecked ? "is-selected" : string.Empty)">
                                <input type="radio"
                                       name="Step1.PrimaryCategory"
                                       value="@d.Value"
                                       checked="@(isChecked ? "checked" : null)"
                                       data-discipline-radio />
                                <span class="c-role-card__title">@d.Title</span>
                                <span class="c-role-card__desc">@d.Subtitle</span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="Step1.PrimaryCategory"></span>
                </fieldset>

                <div class="c-field" data-combobox>
                    <label class="c-label" for="candidate-city-search">Primary City (India)</label>
                    <input id="candidate-city-search"
                           class="c-input"
                           type="text"
                           value="@selectedCityLabel"
                           placeholder="Search city (e.g. Bengaluru, Pune, Hyderabad, Mumbai, Chennai...)"
                           autocomplete="off"
                           data-combobox-input />
                    <input type="hidden" name="Step1.CityId" value="@Model.Step1.CityId" data-combobox-value />
                    <ul class="c-combobox__list" role="listbox" aria-label="Indian cities" style="max-height: 220px; overflow-y: auto;">
                        @foreach (var city in Model.Cities)
                        {
                            var isSelected = city.Id == Model.Step1.CityId;
                            var displayLabel = $"{city.Name}, {city.StateCode}";
                            var aliasKeywords = string.Join(' ', city.Aliases) + " " + city.State + " " + (city.MetroGroup ?? string.Empty);
                            <li class="c-combobox__option"
                                role="option"
                                aria-selected="@(isSelected ? "true" : "false")"
                                data-combobox-option
                                data-value="@city.Id"
                                data-label="@displayLabel"
                                data-search-keywords="@aliasKeywords">
                                <span>@city.Name, @city.State</span>
                                <span class="c-combobox__option-meta">@(city.IsHub ? $"Gaming Hub · {city.StateCode}" : city.StateCode)</span>
                            </li>
                        }
                    </ul>
                    <p class="c-combobox__empty" data-combobox-empty hidden>No matching Indian city found.</p>
                    <p class="c-hint">Gaming hubs are listed first; aliases like &ldquo;Bangalore&rdquo; resolve to canonical Bengaluru (+5 completeness points).</p>
                    <span asp-validation-for="Step1.CityId"></span>
                </div>

                <div class="c-field">
                    <label asp-for="Step1.Bio" class="c-label"></label>
                    <textarea asp-for="Step1.Bio"
                              class="c-textarea"
                              rows="4"
                              placeholder="Summarize the genres, engines, platforms, or systems you love building (up to 1500 characters)..."></textarea>
                    <p class="c-hint">Optional, up to 1500 characters (+10 completeness points when filled).</p>
                    <span asp-validation-for="Step1.Bio"></span>
                </div>

                <div class="c-alert c-alert--info" role="note">
                    <div class="c-alert__content">
                        <span class="c-alert__title">Photo &amp; Phone OTP Privacy</span>
                        <p>Profile photo upload (+5 pts, <code>M1.6</code>) and E.164 phone OTP verification (+10 pts, <code>M1.7</code> — never shown to studios before shortlist) attach directly to your profile without blocking onboarding.</p>
                    </div>
                </div>

                <div class="c-card__footer">
                    <span class="c-hint">Step 1 of 5</span>
                    <button type="submit" class="c-btn c-btn--primary c-btn--lg">Save &amp; Continue to Experience &rarr;</button>
                </div>
            </form>
        </section>
    }
    else if (Model.ActiveStep == 2)
    {
        var isFresherSelected = Model.Step2.YearsExperience < 1.0m || Model.Step2.Seniority == SeniorityLevel.Fresher;

        <section class="c-card" aria-labelledby="step2-heading">
            <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                <div>
                    <h2 id="step2-heading" style="font-size: 22px; margin-bottom: 4px;">Step 2 &middot; Experience &amp; Education</h2>
                    <p class="c-hint">
                        Seniority is suggested from your years of experience (&plusmn;1 level allowed). Add studio/software work history (+15% completeness) and education (+5% completeness).
                    </p>
                </div>
                <span class="c-badge c-badge--accent" data-seniority-hint>
                    Suggested: @suggestedSeniority.ToString().ToLowerInvariant()
                </span>
            </div>

            <form asp-controller="Candidate" asp-action="SaveStep2" method="post" class="c-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

                <div class="p-sg-grid-2">
                    <div class="c-field">
                        <label asp-for="Step2.YearsExperience" class="c-label"></label>
                        <input asp-for="Step2.YearsExperience"
                               class="c-input"
                               type="number"
                               min="0"
                               max="50"
                               step="0.5"
                               data-years-exp-input />
                        <p class="c-hint">Use 0.5-year increments (0 for students/freshers, up to 50).</p>
                        <span asp-validation-for="Step2.YearsExperience"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="Step2.Seniority" class="c-label"></label>
                        <select asp-for="Step2.Seniority" class="c-select" data-seniority-select>
                            @foreach (var level in Enum.GetValues<SeniorityLevel>())
                            {
                                var isAllowed = allowedSeniorities.Contains(level);
                                var label = level switch
                                {
                                    SeniorityLevel.Fresher => "Fresher (< 1 yr)",
                                    SeniorityLevel.Junior => "Junior (1–3 yrs)",
                                    SeniorityLevel.Mid => "Mid-level (3–7 yrs)",
                                    SeniorityLevel.Senior => "Senior (7–12 yrs)",
                                    SeniorityLevel.Lead => "Lead / Principal (12+ yrs)",
                                    _ => level.ToString()
                                };
                                <option value="@level"
                                        data-level-index="@((int)level)"
                                        disabled="@(!isAllowed ? "disabled" : null)">
                                    @label
                                </option>
                            }
                        </select>
                        <p class="c-hint">Allowed within &plusmn;1 level of your years-derived tier.</p>
                        <span asp-validation-for="Step2.Seniority"></span>
                    </div>
                </div>

                <div class="c-alert c-alert--info" role="note" data-fresher-banner hidden="@(!isFresherSelected ? "hidden" : null)">
                    <div class="c-alert__content">
                        <span class="c-alert__title">Fresher-Friendly Completeness Rule (&lt; 1 Year Experience)</span>
                        <p>
                            Starting your career in game development? You can skip Work Experience completely&mdash;adding at least <strong>1 Education entry</strong> below unlocks <strong>both</strong> the +15% experience credit and +5% education credit (+20% total) so freshers can still reach 100% completeness!
                        </p>
                    </div>
                </div>

                <hr />

                <!-- Work Experience Repeating Cards -->
                <div class="p-sg-stack"
                     data-repeat-section
                     data-repeat-prefix="Step2.Experiences"
                     data-repeat-max="@CandidateProfileRules.MaxCandidateExperiences"
                     data-repeat-template="hgd-exp-card-template">
                    <div class="c-card__header" style="padding: 0; border: 0; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <div>
                            <h3 style="font-size: 18px; margin: 0 0 2px 0;">
                                Work Experience
                                <span class="c-badge c-badge--neutral" data-repeat-count>@Model.Step2.Experiences.Count / @CandidateProfileRules.MaxCandidateExperiences</span>
                            </h3>
                            <p class="c-hint" style="margin: 0;">Game studios, freelance contracts, internships, or software engineering roles (+15% completeness).</p>
                        </div>
                        <button type="button"
                                class="c-btn c-btn--secondary c-btn--sm"
                                data-repeat-add
                                disabled="@(Model.Step2.Experiences.Count >= CandidateProfileRules.MaxCandidateExperiences ? "disabled" : null)">
                            + Add Work Experience
                        </button>
                    </div>

                    <p class="c-hint" data-repeat-empty hidden="@(Model.Step2.Experiences.Count > 0 ? "hidden" : null)">
                        No work experience entries added yet. Click <strong>+ Add Work Experience</strong> to add a studio, internship, or software role.
                    </p>

                    <div class="p-sg-stack" data-repeat-items>
                        @for (var i = 0; i < Model.Step2.Experiences.Count; i++)
                        {
                            var exp = Model.Step2.Experiences[i];
                            <article class="c-card" style="padding: 16px;" data-repeat-card>
                                <input type="hidden" name="Step2.Experiences[@i].Id" value="@exp.Id" data-field="Id" />

                                <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center;">
                                    <strong style="font-size: 14px;">Role <span data-card-index>#@(i + 1)</span></strong>
                                    <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                                </div>

                                <div class="p-sg-grid-2">
                                    <div class="c-field">
                                        <label class="c-label">Studio or Company Name</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step2.Experiences[@i].CompanyName"
                                               value="@exp.CompanyName"
                                               maxlength="160"
                                               placeholder="e.g. Nodding Heads Games"
                                               data-field="CompanyName" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Role / Job Title</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step2.Experiences[@i].Title"
                                               value="@exp.Title"
                                               maxlength="160"
                                               placeholder="e.g. Gameplay Programmer"
                                               data-field="Title" />
                                    </div>
                                </div>

                                <div class="p-sg-grid-2" style="margin-top: 12px;">
                                    <div class="c-field">
                                        <label class="c-label">Start Date</label>
                                        <input type="date"
                                               class="c-input"
                                               name="Step2.Experiences[@i].StartDate"
                                               value="@(exp.StartDate?.ToString("yyyy-MM-dd"))"
                                               data-field="StartDate" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">End Date</label>
                                        <input type="date"
                                               class="c-input"
                                               name="Step2.Experiences[@i].EndDate"
                                               value="@(exp.IsCurrent ? string.Empty : exp.EndDate?.ToString("yyyy-MM-dd"))"
                                               disabled="@(exp.IsCurrent ? "disabled" : null)"
                                               data-field="EndDate" />
                                    </div>
                                </div>

                                <label class="c-check" style="margin-top: 10px;">
                                    <input type="checkbox"
                                           name="Step2.Experiences[@i].IsCurrent"
                                           value="true"
                                           checked="@(exp.IsCurrent ? "checked" : null)"
                                           data-field="IsCurrent"
                                           data-exp-current />
                                    <span>I currently work here</span>
                                </label>

                                <div class="c-field" style="margin-top: 12px;">
                                    <label class="c-label">Highlights &amp; Responsibilities (optional)</label>
                                    <textarea class="c-textarea"
                                              rows="3"
                                              maxlength="1500"
                                              name="Step2.Experiences[@i].Description"
                                              placeholder="Systems owned, target platforms, frame-budget optimizations, or team collaboration (up to 1500 characters)..."
                                              data-field="Description">@exp.Description</textarea>
                                </div>
                            </article>
                        }
                    </div>

                    @if (Model.Step2.Experiences.Count == 0)
                    {
                        <noscript>
                            <article class="c-card" style="padding: 16px;">
                                <strong style="font-size: 14px; display: block; margin-bottom: 12px;">Optional Work Experience Entry</strong>
                                <div class="p-sg-grid-2">
                                    <div class="c-field">
                                        <label class="c-label">Studio or Company Name</label>
                                        <input type="text" class="c-input" name="Step2.Experiences[0].CompanyName" maxlength="160" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Role / Job Title</label>
                                        <input type="text" class="c-input" name="Step2.Experiences[0].Title" maxlength="160" />
                                    </div>
                                </div>
                                <div class="p-sg-grid-2" style="margin-top: 12px;">
                                    <div class="c-field">
                                        <label class="c-label">Start Date</label>
                                        <input type="date" class="c-input" name="Step2.Experiences[0].StartDate" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">End Date</label>
                                        <input type="date" class="c-input" name="Step2.Experiences[0].EndDate" />
                                    </div>
                                </div>
                                <label class="c-check" style="margin-top: 10px;">
                                    <input type="checkbox" name="Step2.Experiences[0].IsCurrent" value="true" />
                                    <span>I currently work here</span>
                                </label>
                                <div class="c-field" style="margin-top: 12px;">
                                    <label class="c-label">Highlights &amp; Responsibilities (optional)</label>
                                    <textarea class="c-textarea" rows="3" maxlength="1500" name="Step2.Experiences[0].Description"></textarea>
                                </div>
                            </article>
                        </noscript>
                    }
                </div>

                <hr />

                <!-- Education Repeating Cards -->
                <div class="p-sg-stack"
                     data-repeat-section
                     data-repeat-prefix="Step2.Education"
                     data-repeat-max="@CandidateProfileRules.MaxCandidateEducationEntries"
                     data-repeat-template="hgd-edu-card-template">
                    <div class="c-card__header" style="padding: 0; border: 0; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <div>
                            <h3 style="font-size: 18px; margin: 0 0 2px 0;">
                                Education
                                <span class="c-badge c-badge--neutral" data-repeat-count>@Model.Step2.Education.Count / @CandidateProfileRules.MaxCandidateEducationEntries</span>
                            </h3>
                            <p class="c-hint" style="margin: 0;">Degrees, game-design/art diplomas, or university programs (+5% completeness; +20% total for freshers).</p>
                        </div>
                        <button type="button"
                                class="c-btn c-btn--secondary c-btn--sm"
                                data-repeat-add
                                disabled="@(Model.Step2.Education.Count >= CandidateProfileRules.MaxCandidateEducationEntries ? "disabled" : null)">
                            + Add Education
                        </button>
                    </div>

                    <p class="c-hint" data-repeat-empty hidden="@(Model.Step2.Education.Count > 0 ? "hidden" : null)">
                        No education entries added yet. Click <strong>+ Add Education</strong> to add your university, college, or game-dev institute.
                    </p>

                    <div class="p-sg-stack" data-repeat-items>
                        @for (var i = 0; i < Model.Step2.Education.Count; i++)
                        {
                            var edu = Model.Step2.Education[i];
                            <article class="c-card" style="padding: 16px;" data-repeat-card>
                                <input type="hidden" name="Step2.Education[@i].Id" value="@edu.Id" data-field="Id" />

                                <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center;">
                                    <strong style="font-size: 14px;">Education <span data-card-index>#@(i + 1)</span></strong>
                                    <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                                </div>

                                <div class="p-sg-grid-2">
                                    <div class="c-field">
                                        <label class="c-label">Institution / University</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step2.Education[@i].Institution"
                                               value="@edu.Institution"
                                               maxlength="200"
                                               placeholder="e.g. DSK Supinfogame / IIT Bombay / VIT"
                                               data-field="Institution" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Degree / Diploma</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step2.Education[@i].Degree"
                                               value="@edu.Degree"
                                               maxlength="160"
                                               placeholder="e.g. B.Tech, B.Des, BCA, PG Diploma"
                                               data-field="Degree" />
                                    </div>
                                </div>

                                <div class="p-sg-grid-3" style="margin-top: 12px;">
                                    <div class="c-field">
                                        <label class="c-label">Field of Study (optional)</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step2.Education[@i].Field"
                                               value="@edu.Field"
                                               maxlength="160"
                                               placeholder="e.g. Computer Science / Game Design"
                                               data-field="Field" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Start Year (optional)</label>
                                        <input type="number"
                                               class="c-input"
                                               name="Step2.Education[@i].StartYear"
                                               value="@edu.StartYear"
                                               min="1950"
                                               max="2100"
                                               placeholder="2020"
                                               data-field="StartYear" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Completion / Expected Year</label>
                                        <input type="number"
                                               class="c-input"
                                               name="Step2.Education[@i].EndYear"
                                               value="@edu.EndYear"
                                               min="1950"
                                               max="2100"
                                               placeholder="2024"
                                               data-field="EndYear" />
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    @if (Model.Step2.Education.Count == 0)
                    {
                        <noscript>
                            <article class="c-card" style="padding: 16px;">
                                <strong style="font-size: 14px; display: block; margin-bottom: 12px;">Optional Education Entry</strong>
                                <div class="p-sg-grid-2">
                                    <div class="c-field">
                                        <label class="c-label">Institution / University</label>
                                        <input type="text" class="c-input" name="Step2.Education[0].Institution" maxlength="200" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Degree / Diploma</label>
                                        <input type="text" class="c-input" name="Step2.Education[0].Degree" maxlength="160" />
                                    </div>
                                </div>
                                <div class="p-sg-grid-3" style="margin-top: 12px;">
                                    <div class="c-field">
                                        <label class="c-label">Field of Study (optional)</label>
                                        <input type="text" class="c-input" name="Step2.Education[0].Field" maxlength="160" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Start Year (optional)</label>
                                        <input type="number" class="c-input" name="Step2.Education[0].StartYear" min="1950" max="2100" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Completion / Expected Year</label>
                                        <input type="number" class="c-input" name="Step2.Education[0].EndYear" min="1950" max="2100" />
                                    </div>
                                </div>
                            </article>
                        </noscript>
                    }
                </div>

                <div class="c-card__footer">
                    <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="1" class="c-btn c-btn--ghost">&larr; Back to Basics</a>
                    <div class="c-btn-group">
                        <button type="submit" name="nextStep" value="5" class="c-btn c-btn--secondary">Save &amp; Jump to Preferences</button>
                        <button type="submit" name="nextStep" value="3" class="c-btn c-btn--primary c-btn--lg">Save &amp; Continue &rarr;</button>
                    </div>
                </div>
            </form>

            <template id="hgd-exp-card-template">
                <article class="c-card" style="padding: 16px;" data-repeat-card>
                    <input type="hidden" value="" data-field="Id" />
                    <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center;">
                        <strong style="font-size: 14px;">Role <span data-card-index>#1</span></strong>
                        <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                    </div>
                    <div class="p-sg-grid-2">
                        <div class="c-field">
                            <label class="c-label">Studio or Company Name</label>
                            <input type="text" class="c-input" maxlength="160" placeholder="e.g. Nodding Heads Games" data-field="CompanyName" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Role / Job Title</label>
                            <input type="text" class="c-input" maxlength="160" placeholder="e.g. Gameplay Programmer" data-field="Title" />
                        </div>
                    </div>
                    <div class="p-sg-grid-2" style="margin-top: 12px;">
                        <div class="c-field">
                            <label class="c-label">Start Date</label>
                            <input type="date" class="c-input" data-field="StartDate" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">End Date</label>
                            <input type="date" class="c-input" data-field="EndDate" />
                        </div>
                    </div>
                    <label class="c-check" style="margin-top: 10px;">
                        <input type="checkbox" value="true" data-field="IsCurrent" data-exp-current />
                        <span>I currently work here</span>
                    </label>
                    <div class="c-field" style="margin-top: 12px;">
                        <label class="c-label">Highlights &amp; Responsibilities (optional)</label>
                        <textarea class="c-textarea" rows="3" maxlength="1500" placeholder="Systems owned, target platforms, frame-budget optimizations, or team collaboration (up to 1500 characters)..." data-field="Description"></textarea>
                    </div>
                </article>
            </template>

            <template id="hgd-edu-card-template">
                <article class="c-card" style="padding: 16px;" data-repeat-card>
                    <input type="hidden" value="" data-field="Id" />
                    <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center;">
                        <strong style="font-size: 14px;">Education <span data-card-index>#1</span></strong>
                        <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                    </div>
                    <div class="p-sg-grid-2">
                        <div class="c-field">
                            <label class="c-label">Institution / University</label>
                            <input type="text" class="c-input" maxlength="200" placeholder="e.g. DSK Supinfogame / IIT Bombay / VIT" data-field="Institution" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Degree / Diploma</label>
                            <input type="text" class="c-input" maxlength="160" placeholder="e.g. B.Tech, B.Des, BCA, PG Diploma" data-field="Degree" />
                        </div>
                    </div>
                    <div class="p-sg-grid-3" style="margin-top: 12px;">
                        <div class="c-field">
                            <label class="c-label">Field of Study (optional)</label>
                            <input type="text" class="c-input" maxlength="160" placeholder="e.g. Computer Science / Game Design" data-field="Field" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Start Year (optional)</label>
                            <input type="number" class="c-input" min="1950" max="2100" placeholder="2020" data-field="StartYear" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Completion / Expected Year</label>
                            <input type="number" class="c-input" min="1950" max="2100" placeholder="2024" data-field="EndYear" />
                        </div>
                    </div>
                </article>
            </template>
        </section>
    }
    else if (Model.ActiveStep == 3)
    {
        var selectedRows = Model.Step3.Skills;
        var selectedIdSet = selectedRows.Select(s => s.SkillId).ToHashSet();
        var primaryCount = selectedRows.Count(s => s.IsPrimary);

        (string Key, string Label)[] categoryFilters =
        [
            ("all", "All"),
            ("Engine", "Engines"),
            ("Language", "Languages"),
            ("ArtTool", "Art Tools"),
            ("DesignAudioTool", "Design & Audio"),
            ("Devops", "DevOps"),
            ("Genre", "Genres"),
            ("Platform", "Platforms"),
            ("Role", "Disciplines")
        ];

        <section class="c-card" aria-labelledby="step3-heading" data-skill-picker>
            <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                <div>
                    <h2 id="step3-heading" style="font-size: 22px; margin-bottom: 4px;">Step 3 &middot; Skills &amp; Proficiency</h2>
                    <p class="c-hint">
                        Pick <strong>3 to 25</strong> canonical game-dev skills, rate your proficiency (1–4), and mark up to <strong>5 primary skills</strong>. Adding at least 5 skills unlocks <strong>+15% completeness</strong>.
                    </p>
                </div>
                <div class="c-badge-row">
                    <span class="c-badge @(selectedRows.Count >= 3 ? "c-badge--success" : "c-badge--neutral")" data-skill-count-badge>
                        @selectedRows.Count / 25 selected (min 3)
                    </span>
                    <span class="c-badge c-badge--accent" data-primary-count-badge>
                        @primaryCount / 5 primary
                    </span>
                    <span class="c-badge @(selectedRows.Count >= 5 ? "c-badge--success" : "c-badge--info")" data-skill-completeness-badge>
                        @(selectedRows.Count >= 5 ? "+15% completeness unlocked ✓" : $"Add {Math.Max(0, 5 - selectedRows.Count)} more for +15% completeness")
                    </span>
                </div>
            </div>

            <form asp-controller="Candidate" asp-action="SaveStep3" method="post" class="c-form" data-skills-form novalidate>
                <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

                <!-- 1. Taxonomy Search & Category Filter -->
                <div class="c-card" style="background: var(--surface-2); padding: 16px;">
                    <div class="c-field">
                        <label class="c-label" for="candidate-skill-search">Search Game-Dev Skill Taxonomy</label>
                        <input id="candidate-skill-search"
                               class="c-input"
                               type="search"
                               placeholder="Search e.g. Unreal Engine, Unity, C++, Godot, HLSL, Blender, Wwise, Netcode..."
                               autocomplete="off"
                               data-skill-search-input />
                    </div>

                    <div class="c-chip-list" role="toolbar" aria-label="Filter skills by category" style="margin-top: 10px;">
                        @foreach (var cat in categoryFilters)
                        {
                            var isDefaultAll = cat.Key == "all";
                            <button type="button"
                                    class="c-chip c-chip--interactive"
                                    aria-pressed="@(isDefaultAll ? "true" : "false")"
                                    data-skill-cat-filter="@cat.Key">
                                @cat.Label
                            </button>
                        }
                    </div>

                    <div class="c-chip-list"
                         role="region"
                         aria-label="Available skills to add"
                         style="margin-top: 12px; max-height: 210px; overflow-y: auto; padding: 4px 2px;"
                         data-skill-catalog>
                        @foreach (var skill in Model.AvailableSkills)
                        {
                            var alreadyAdded = selectedIdSet.Contains(skill.Id) || (!selectedIdSet.Contains(skill.Id) && selectedRows.Count >= 25);
                            var isAdded = selectedIdSet.Contains(skill.Id);
                            var catLabel = HireGameDev.Web.Controllers.CandidateController.FormatCategoryLabel(skill.Category);
                            var searchTerms = $"{skill.Name} {skill.Slug} {skill.Subcategory} {string.Join(' ', skill.Aliases)}";
                            <button type="button"
                                    class="c-chip c-chip--interactive"
                                    data-skill-add-btn
                                    data-skill-id="@skill.Id"
                                    data-skill-name="@skill.Name"
                                    data-skill-category="@skill.Category"
                                    data-skill-category-label="@catLabel"
                                    data-search-keywords="@searchTerms"
                                    disabled="@(alreadyAdded ? "disabled" : null)">
                                <span data-skill-btn-label>@(isAdded ? $"{skill.Name} ✓" : $"+ {skill.Name}")</span>
                            </button>
                        }
                    </div>
                    <p class="c-hint" data-skill-catalog-empty hidden style="margin-top: 8px;">No matching taxonomy skills found for that filter.</p>
                </div>

                <!-- 2. Selected Skills Matrix -->
                <div class="c-empty" data-selected-skills-empty hidden="@(selectedRows.Count > 0 ? "hidden" : null)" style="padding: 24px;">
                    <p class="c-empty__title" style="font-size: 16px;">No skills added yet</p>
                    <p class="c-empty__desc">Click at least 3 skills from the taxonomy above to rate your proficiency.</p>
                </div>

                <div class="c-table-wrap" data-selected-skills-wrap hidden="@(selectedRows.Count == 0 ? "hidden" : null)">
                    <table class="c-table">
                        <thead>
                            <tr>
                                <th scope="col">Skill</th>
                                <th scope="col">Proficiency (1–4)</th>
                                <th scope="col">Years Used</th>
                                <th scope="col">Last Used Year</th>
                                <th scope="col">Primary (Max 5)</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody data-selected-skills-body>
                            @for (var i = 0; i < selectedRows.Count; i++)
                            {
                                var row = selectedRows[i];
                                var disablePrimary = !row.IsPrimary && primaryCount >= 5;
                                <tr data-skill-row data-skill-id="@row.SkillId">
                                    <td>
                                        <input type="hidden" name="Step3.Skills[@i].SkillId" value="@row.SkillId" data-field="SkillId" />
                                        @{
                                            var rowEvidenceBadgeClass = row.EvidenceLevel switch
                                            {
                                                SkillEvidenceLevel.Verified => "c-badge--success",
                                                SkillEvidenceLevel.Backed => "c-badge--info",
                                                _ => "c-badge--neutral"
                                            };
                                        }
                                        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                            <strong>@row.SkillName</strong>
                                            <span class="c-badge @rowEvidenceBadgeClass">@row.EvidenceLevel.ToDisplayLabel()</span>
                                        </div>
                                        <span class="c-hint">@row.CategoryLabel</span>
                                    </td>
                                    <td>
                                        <select name="Step3.Skills[@i].Proficiency"
                                                class="c-select"
                                                aria-label="Proficiency for @row.SkillName"
                                                data-field="Proficiency"
                                                style="min-width: 155px;">
                                            <option value="@SkillProficiency.Beginner" selected="@(row.Proficiency == SkillProficiency.Beginner ? "selected" : null)">1 &middot; Beginner</option>
                                            <option value="@SkillProficiency.Working" selected="@(row.Proficiency == SkillProficiency.Working ? "selected" : null)">2 &middot; Working</option>
                                            <option value="@SkillProficiency.Strong" selected="@(row.Proficiency == SkillProficiency.Strong ? "selected" : null)">3 &middot; Strong</option>
                                            <option value="@SkillProficiency.Expert" selected="@(row.Proficiency == SkillProficiency.Expert ? "selected" : null)">4 &middot; Expert</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number"
                                               name="Step3.Skills[@i].YearsUsed"
                                               value="@(row.YearsUsed?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                               class="c-input"
                                               min="0"
                                               max="50"
                                               step="0.5"
                                               placeholder="e.g. 3.0"
                                               aria-label="Years used for @row.SkillName"
                                               data-field="YearsUsed"
                                               style="width: 105px;" />
                                    </td>
                                    <td>
                                        <input type="number"
                                               name="Step3.Skills[@i].LastUsedYear"
                                               value="@row.LastUsedYear"
                                               class="c-input"
                                               min="1990"
                                               max="2100"
                                               placeholder="@DateTime.UtcNow.Year"
                                               aria-label="Last used year for @row.SkillName"
                                               data-field="LastUsedYear"
                                               style="width: 110px;" />
                                    </td>
                                    <td>
                                        <label class="c-check">
                                            <input type="checkbox"
                                                   name="Step3.Skills[@i].IsPrimary"
                                                   value="true"
                                                   checked="@(row.IsPrimary ? "checked" : null)"
                                                   disabled="@(disablePrimary ? "disabled" : null)"
                                                   data-field="IsPrimary"
                                                   data-skill-primary />
                                            <span>Primary</span>
                                        </label>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="c-btn c-btn--danger-outline c-btn--sm"
                                                data-skill-remove-btn
                                                aria-label="Remove @row.SkillName">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="c-card__footer">
                    <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="2" class="c-btn c-btn--ghost">&larr; Back to Experience</a>
                    <div class="c-btn-group">
                        <button type="submit" name="nextStep" value="5" class="c-btn c-btn--secondary">Save &amp; Jump to Preferences</button>
                        <button type="submit" name="nextStep" value="4" class="c-btn c-btn--primary c-btn--lg">Save Skills &amp; Continue &rarr;</button>
                    </div>
                </div>
            </form>

            <template id="hgd-skill-row-template">
                <tr data-skill-row data-skill-id="">
                    <td>
                        <input type="hidden" name="" value="" data-field="SkillId" />
                        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                            <strong data-tpl-skill-name></strong>
                            <span class="c-badge c-badge--neutral">@SkillEvidenceLevel.Claimed.ToDisplayLabel()</span>
                        </div>
                        <span class="c-hint" data-tpl-skill-cat></span>
                    </td>
                    <td>
                        <select name="" class="c-select" data-field="Proficiency" style="min-width: 155px;">
                            <option value="Beginner">1 &middot; Beginner</option>
                            <option value="Working" selected>2 &middot; Working</option>
                            <option value="Strong">3 &middot; Strong</option>
                            <option value="Expert">4 &middot; Expert</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" name="" class="c-input" min="0" max="50" step="0.5" placeholder="e.g. 2.0" data-field="YearsUsed" style="width: 105px;" />
                    </td>
                    <td>
                        <input type="number" name="" class="c-input" min="1990" max="2100" placeholder="@DateTime.UtcNow.Year" data-field="LastUsedYear" style="width: 110px;" />
                    </td>
                    <td>
                        <label class="c-check">
                            <input type="checkbox" name="" value="true" data-field="IsPrimary" data-skill-primary />
                            <span>Primary</span>
                        </label>
                    </td>
                    <td>
                        <button type="button" class="c-btn c-btn--danger-outline c-btn--sm" data-skill-remove-btn>Remove</button>
                    </td>
                </tr>
            </template>
        </section>
    }
    else if (Model.ActiveStep == 4)
    {
        (string Key, string Label)[] platformOptions =
        [
            ("pc", "PC"),
            ("android", "Android"),
            ("ios", "iOS"),
            ("console", "Console"),
            ("web", "Web")
        ];

        (PortfolioLinkType Value, string Label)[] linkTypes =
        [
            (PortfolioLinkType.Github, "GitHub"),
            (PortfolioLinkType.Itchio, "itch.io"),
            (PortfolioLinkType.Artstation, "ArtStation"),
            (PortfolioLinkType.Behance, "Behance"),
            (PortfolioLinkType.Youtube, "YouTube / Reel"),
            (PortfolioLinkType.Website, "Personal Website"),
            (PortfolioLinkType.Linkedin, "LinkedIn"),
            (PortfolioLinkType.Other, "Other HTTPS Link")
        ];

        <section class="c-card" aria-labelledby="step4-heading">
            <div class="c-card__header" style="align-items: flex-start; gap: 12px; flex-wrap: wrap;">
                <div>
                    <h2 id="step4-heading" style="font-size: 22px; margin-bottom: 4px;">Step 4 &middot; Shipped Titles &amp; Portfolio Proof</h2>
                    <p class="c-hint">
                        Adding at least <strong>1 shipped title</strong> or <strong>1 portfolio link</strong> unlocks <strong>+20% completeness</strong>&mdash;the single largest profile signal.
                    </p>
                </div>
                <span class="c-badge @(Model.Step4.ShippedTitles.Count > 0 || Model.Step4.PortfolioLinks.Count > 0 ? "c-badge--success" : "c-badge--accent")">
                    @(Model.Step4.ShippedTitles.Count > 0 || Model.Step4.PortfolioLinks.Count > 0 ? "+20% Proof Unlocked ✓" : "+20% Completeness Available")
                </span>
            </div>

            <form asp-controller="Candidate" asp-action="SaveStep4" method="post" class="c-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

                <div class="c-alert c-alert--info" role="note">
                    <div class="c-alert__content">
                        <span class="c-alert__title">Submitted Proof vs. Verified Proof &amp; NDA Protection</span>
                        <p>
                            Portfolio links and newly submitted game credits are recorded as <strong>submitted proof</strong> (powering <code>Backed</code> 0.90&times; skill evidence in <code>M1.5</code>).
                            <strong>Verified</strong> badges (<code>title_verified</code> / <code>credit_verified</code>, 1.00&times;) are strictly backend-controlled and cannot be self-assigned.
                            Enabling <strong>Under NDA</strong> masks confidential project names, store links, and optionally studio names on public/studio profiles while retaining your private internal record.
                        </p>
                    </div>
                </div>

                <!-- Shipped Titles Repeating Cards -->
                <div class="p-sg-stack"
                     data-repeat-section
                     data-repeat-prefix="Step4.ShippedTitles"
                     data-repeat-max="@CandidateProfileRules.MaxShippedTitles"
                     data-repeat-template="hgd-title-card-template">
                    <div class="c-card__header" style="padding: 0; border: 0; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <div>
                            <h3 style="font-size: 18px; margin: 0 0 2px 0;">
                                Shipped Game Credits
                                <span class="c-badge c-badge--neutral" data-repeat-count>@Model.Step4.ShippedTitles.Count / @CandidateProfileRules.MaxShippedTitles</span>
                            </h3>
                            <p class="c-hint" style="margin: 0;">Commercial releases, live-ops titles, indie launches, or NDA studio projects.</p>
                        </div>
                        <button type="button"
                                class="c-btn c-btn--secondary c-btn--sm"
                                data-repeat-add
                                disabled="@(Model.Step4.ShippedTitles.Count >= CandidateProfileRules.MaxShippedTitles ? "disabled" : null)">
                            + Add Shipped Title
                        </button>
                    </div>

                    <p class="c-hint" data-repeat-empty hidden="@(Model.Step4.ShippedTitles.Count > 0 ? "hidden" : null)">
                        No shipped game credits added yet. Click <strong>+ Add Shipped Title</strong> (or add a portfolio link below).
                    </p>

                    <div class="p-sg-stack" data-repeat-items>
                        @for (var i = 0; i < Model.Step4.ShippedTitles.Count; i++)
                        {
                            var title = Model.Step4.ShippedTitles[i];
                            var selectedPlatforms = title.Platforms.Select(p => p.Trim().ToLowerInvariant()).ToHashSet(StringComparer.Ordinal);
                            var verificationBadge = title.Verification switch
                            {
                                ShippedTitleVerification.CreditVerified => ("Credit verified", "c-badge--success"),
                                ShippedTitleVerification.TitleVerified => ("Title verified", "c-badge--success"),
                                _ => ("Submitted credit · Unverified", "c-badge--neutral")
                            };

                            <article class="c-card" style="padding: 16px;" data-repeat-card>
                                <input type="hidden" name="Step4.ShippedTitles[@i].Id" value="@title.Id" data-field="Id" />

                                <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                        <strong style="font-size: 14px;">Credit <span data-card-index>#@(i + 1)</span></strong>
                                        <span class="c-badge @verificationBadge.Item2">@verificationBadge.Item1</span>
                                    </div>
                                    <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                                </div>

                                <div class="p-sg-grid-3">
                                    <div class="c-field">
                                        <label class="c-label">Game / Project Name</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step4.ShippedTitles[@i].GameName"
                                               value="@title.GameName"
                                               maxlength="160"
                                               placeholder="e.g. Raji: An Ancient Epic"
                                               data-field="GameName" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Studio / Team Name</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step4.ShippedTitles[@i].StudioName"
                                               value="@title.StudioName"
                                               maxlength="160"
                                               placeholder="e.g. Nodding Heads Games"
                                               data-field="StudioName" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Your Credited Role</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step4.ShippedTitles[@i].Role"
                                               value="@title.Role"
                                               maxlength="120"
                                               placeholder="e.g. Gameplay Programmer"
                                               data-field="Role" />
                                    </div>
                                </div>

                                <div class="p-sg-grid-3" style="margin-top: 12px;">
                                    <div class="c-field">
                                        <label class="c-label">Engine (optional)</label>
                                        <select class="c-select" name="Step4.ShippedTitles[@i].EngineSkillId" data-field="EngineSkillId">
                                            <option value="">None / Custom</option>
                                            @foreach (var eng in Model.EngineSkills)
                                            {
                                                <option value="@eng.Id" selected="@(title.EngineSkillId == eng.Id ? "selected" : null)">@eng.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Release Year (optional)</label>
                                        <input type="number"
                                               class="c-input"
                                               name="Step4.ShippedTitles[@i].ReleaseYear"
                                               value="@title.ReleaseYear"
                                               min="1990"
                                               max="2100"
                                               placeholder="2024"
                                               data-field="ReleaseYear" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Store / Page URL (optional, https://)</label>
                                        <input type="url"
                                               class="c-input"
                                               name="Step4.ShippedTitles[@i].StoreUrl"
                                               value="@title.StoreUrl"
                                               maxlength="500"
                                               placeholder="https://store.steampowered.com/app/..."
                                               data-field="StoreUrl" />
                                    </div>
                                </div>

                                <div class="c-field" style="margin-top: 12px;">
                                    <span class="c-label">Platforms</span>
                                    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px;">
                                        @foreach (var plat in platformOptions)
                                        {
                                            <label class="c-check">
                                                <input type="checkbox"
                                                       name="Step4.ShippedTitles[@i].Platforms"
                                                       value="@plat.Key"
                                                       checked="@(selectedPlatforms.Contains(plat.Key) ? "checked" : null)"
                                                       data-field="Platforms" />
                                                <span>@plat.Label</span>
                                            </label>
                                        }
                                    </div>
                                </div>

                                <div class="c-card" style="margin-top: 12px; padding: 12px 14px; background: var(--surface-2);">
                                    <div style="display: flex; flex-direction: column; gap: 8px;">
                                        <label class="c-check">
                                            <input type="checkbox"
                                                   name="Step4.ShippedTitles[@i].IsNda"
                                                   value="true"
                                                   checked="@(title.IsNda ? "checked" : null)"
                                                   data-field="IsNda"
                                                   data-nda-toggle />
                                            <span><strong>Under NDA:</strong> Hide confidential project name &amp; store URL publicly (shows &ldquo;Confidential Project (Under NDA)&rdquo; + your role)</span>
                                        </label>
                                        <label class="c-check">
                                            <input type="checkbox"
                                                   name="Step4.ShippedTitles[@i].HideStudioInPublic"
                                                   value="true"
                                                   checked="@(title.IsNda && title.HideStudioInPublic ? "checked" : null)"
                                                   disabled="@(!title.IsNda ? "disabled" : null)"
                                                   data-field="HideStudioInPublic"
                                                   data-nda-hide-studio />
                                            <span>Also hide confidential studio / client name publicly (shows &ldquo;Confidential Studio&rdquo;)</span>
                                        </label>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    @if (Model.Step4.ShippedTitles.Count == 0)
                    {
                        <noscript>
                            <article class="c-card" style="padding: 16px;">
                                <strong style="font-size: 14px; display: block; margin-bottom: 12px;">Optional Shipped Title Entry</strong>
                                <div class="p-sg-grid-3">
                                    <div class="c-field">
                                        <label class="c-label">Game / Project Name</label>
                                        <input type="text" class="c-input" name="Step4.ShippedTitles[0].GameName" maxlength="160" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Studio / Team Name</label>
                                        <input type="text" class="c-input" name="Step4.ShippedTitles[0].StudioName" maxlength="160" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Your Credited Role</label>
                                        <input type="text" class="c-input" name="Step4.ShippedTitles[0].Role" maxlength="120" />
                                    </div>
                                </div>
                                <div class="p-sg-grid-3" style="margin-top: 12px;">
                                    <div class="c-field">
                                        <label class="c-label">Engine (optional)</label>
                                        <select class="c-select" name="Step4.ShippedTitles[0].EngineSkillId">
                                            <option value="">None / Custom</option>
                                            @foreach (var eng in Model.EngineSkills)
                                            {
                                                <option value="@eng.Id">@eng.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Release Year</label>
                                        <input type="number" class="c-input" name="Step4.ShippedTitles[0].ReleaseYear" min="1990" max="2100" />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Store URL (https://)</label>
                                        <input type="url" class="c-input" name="Step4.ShippedTitles[0].StoreUrl" maxlength="500" />
                                    </div>
                                </div>
                            </article>
                        </noscript>
                    }
                </div>

                <hr />

                <!-- Portfolio Links Repeating Cards -->
                <div class="p-sg-stack"
                     data-repeat-section
                     data-repeat-prefix="Step4.PortfolioLinks"
                     data-repeat-max="@CandidateProfileRules.MaxPortfolioLinks"
                     data-repeat-template="hgd-portfolio-card-template">
                    <div class="c-card__header" style="padding: 0; border: 0; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <div>
                            <h3 style="font-size: 18px; margin: 0 0 2px 0;">
                                Portfolio &amp; Playable Proof Links
                                <span class="c-badge c-badge--neutral" data-repeat-count>@Model.Step4.PortfolioLinks.Count / @CandidateProfileRules.MaxPortfolioLinks</span>
                            </h3>
                            <p class="c-hint" style="margin: 0;">GitHub repos, itch.io builds, ArtStation portfolios, demo reels, or technical write-ups (strictly <code>https://</code>).</p>
                        </div>
                        <button type="button"
                                class="c-btn c-btn--secondary c-btn--sm"
                                data-repeat-add
                                disabled="@(Model.Step4.PortfolioLinks.Count >= CandidateProfileRules.MaxPortfolioLinks ? "disabled" : null)">
                            + Add Portfolio Link
                        </button>
                    </div>

                    <p class="c-hint" data-repeat-empty hidden="@(Model.Step4.PortfolioLinks.Count > 0 ? "hidden" : null)">
                        No portfolio links added yet. Click <strong>+ Add Portfolio Link</strong> to attach GitHub, itch.io, ArtStation, or demo reel proof.
                    </p>

                    <div class="p-sg-stack" data-repeat-items>
                        @for (var i = 0; i < Model.Step4.PortfolioLinks.Count; i++)
                        {
                            var link = Model.Step4.PortfolioLinks[i];
                            var taggedSet = link.SkillIds.ToHashSet();

                            <article class="c-card" style="padding: 16px;" data-repeat-card>
                                <input type="hidden" name="Step4.PortfolioLinks[@i].Id" value="@link.Id" data-field="Id" />

                                <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <strong style="font-size: 14px;">Portfolio Link <span data-card-index>#@(i + 1)</span></strong>
                                        <span class="c-badge c-badge--info">Submitted proof</span>
                                    </div>
                                    <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                                </div>

                                <div class="p-sg-grid-3">
                                    <div class="c-field">
                                        <label class="c-label">Link Type</label>
                                        <select class="c-select" name="Step4.PortfolioLinks[@i].LinkType" data-field="LinkType">
                                            @foreach (var lt in linkTypes)
                                            {
                                                <option value="@lt.Value" selected="@(link.LinkType == lt.Value ? "selected" : null)">@lt.Label</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Public HTTPS URL</label>
                                        <input type="url"
                                               class="c-input"
                                               name="Step4.PortfolioLinks[@i].Url"
                                               value="@link.Url"
                                               maxlength="500"
                                               placeholder="https://github.com/yourhandle/project"
                                               data-field="Url" />
                                    </div>

                                    <div class="c-field">
                                        <label class="c-label">Title / Context (optional)</label>
                                        <input type="text"
                                               class="c-input"
                                               name="Step4.PortfolioLinks[@i].Title"
                                               value="@link.Title"
                                               maxlength="160"
                                               placeholder="e.g. Playable UE5 Combat Prototype"
                                               data-field="Title" />
                                    </div>
                                </div>

                                <div class="c-field" style="margin-top: 12px;">
                                    <span class="c-label">Skills Evidenced by This Link (optional, up to @CandidateProfileRules.MaxEvidencedSkillsPerLink)</span>
                                    @if (Model.CandidateSkillsForTagging.Count == 0)
                                    {
                                        <p class="c-hint" style="margin: 4px 0 0 0;">
                                            Add skills in <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="3">Step 3 (Skills)</a> first to tag which skills this link evidences.
                                        </p>
                                    }
                                    else
                                    {
                                        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px;">
                                            @foreach (var sk in Model.CandidateSkillsForTagging)
                                            {
                                                <label class="c-check">
                                                    <input type="checkbox"
                                                           name="Step4.PortfolioLinks[@i].SkillIds"
                                                           value="@sk.SkillId"
                                                           checked="@(taggedSet.Contains(sk.SkillId) ? "checked" : null)"
                                                           data-field="SkillIds" />
                                                    <span>@sk.SkillName</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>

                    @if (Model.Step4.PortfolioLinks.Count == 0)
                    {
                        <noscript>
                            <article class="c-card" style="padding: 16px;">
                                <strong style="font-size: 14px; display: block; margin-bottom: 12px;">Optional Portfolio Link Entry</strong>
                                <div class="p-sg-grid-3">
                                    <div class="c-field">
                                        <label class="c-label">Link Type</label>
                                        <select class="c-select" name="Step4.PortfolioLinks[0].LinkType">
                                            @foreach (var lt in linkTypes)
                                            {
                                                <option value="@lt.Value">@lt.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Public HTTPS URL</label>
                                        <input type="url" class="c-input" name="Step4.PortfolioLinks[0].Url" maxlength="500" placeholder="https://..." />
                                    </div>
                                    <div class="c-field">
                                        <label class="c-label">Title (optional)</label>
                                        <input type="text" class="c-input" name="Step4.PortfolioLinks[0].Title" maxlength="160" />
                                    </div>
                                </div>
                            </article>
                        </noscript>
                    }
                </div>

                <div class="c-card__footer">
                    <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="3" class="c-btn c-btn--ghost">&larr; Back to Skills</a>
                    <button type="submit" class="c-btn c-btn--primary c-btn--lg">Save Proof &amp; Continue to Preferences &rarr;</button>
                </div>
            </form>

            <template id="hgd-title-card-template">
                <article class="c-card" style="padding: 16px;" data-repeat-card>
                    <input type="hidden" value="" data-field="Id" />
                    <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <strong style="font-size: 14px;">Credit <span data-card-index>#1</span></strong>
                            <span class="c-badge c-badge--neutral">Submitted credit &middot; Unverified</span>
                        </div>
                        <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                    </div>
                    <div class="p-sg-grid-3">
                        <div class="c-field">
                            <label class="c-label">Game / Project Name</label>
                            <input type="text" class="c-input" maxlength="160" placeholder="e.g. Raji: An Ancient Epic" data-field="GameName" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Studio / Team Name</label>
                            <input type="text" class="c-input" maxlength="160" placeholder="e.g. Nodding Heads Games" data-field="StudioName" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Your Credited Role</label>
                            <input type="text" class="c-input" maxlength="120" placeholder="e.g. Gameplay Programmer" data-field="Role" />
                        </div>
                    </div>
                    <div class="p-sg-grid-3" style="margin-top: 12px;">
                        <div class="c-field">
                            <label class="c-label">Engine (optional)</label>
                            <select class="c-select" data-field="EngineSkillId">
                                <option value="">None / Custom</option>
                                @foreach (var eng in Model.EngineSkills)
                                {
                                    <option value="@eng.Id">@eng.Name</option>
                                }
                            </select>
                        </div>
                        <div class="c-field">
                            <label class="c-label">Release Year (optional)</label>
                            <input type="number" class="c-input" min="1990" max="2100" placeholder="2024" data-field="ReleaseYear" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Store / Page URL (optional, https://)</label>
                            <input type="url" class="c-input" maxlength="500" placeholder="https://store.steampowered.com/app/..." data-field="StoreUrl" />
                        </div>
                    </div>
                    <div class="c-field" style="margin-top: 12px;">
                        <span class="c-label">Platforms</span>
                        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px;">
                            @foreach (var plat in platformOptions)
                            {
                                <label class="c-check">
                                    <input type="checkbox" value="@plat.Key" data-field="Platforms" />
                                    <span>@plat.Label</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="c-card" style="margin-top: 12px; padding: 12px 14px; background: var(--surface-2);">
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <label class="c-check">
                                <input type="checkbox" value="true" data-field="IsNda" data-nda-toggle />
                                <span><strong>Under NDA:</strong> Hide confidential project name &amp; store URL publicly (shows &ldquo;Confidential Project (Under NDA)&rdquo; + your role)</span>
                            </label>
                            <label class="c-check">
                                <input type="checkbox" value="true" disabled data-field="HideStudioInPublic" data-nda-hide-studio />
                                <span>Also hide confidential studio / client name publicly (shows &ldquo;Confidential Studio&rdquo;)</span>
                            </label>
                        </div>
                    </div>
                </article>
            </template>

            <template id="hgd-portfolio-card-template">
                <article class="c-card" style="padding: 16px;" data-repeat-card>
                    <input type="hidden" value="" data-field="Id" />
                    <div class="c-card__header" style="padding-bottom: 12px; margin-bottom: 12px; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <strong style="font-size: 14px;">Portfolio Link <span data-card-index>#1</span></strong>
                            <span class="c-badge c-badge--info">Submitted proof</span>
                        </div>
                        <button type="button" class="c-btn c-btn--ghost c-btn--sm" data-repeat-remove>Remove</button>
                    </div>
                    <div class="p-sg-grid-3">
                        <div class="c-field">
                            <label class="c-label">Link Type</label>
                            <select class="c-select" data-field="LinkType">
                                @foreach (var lt in linkTypes)
                                {
                                    <option value="@lt.Value">@lt.Label</option>
                                }
                            </select>
                        </div>
                        <div class="c-field">
                            <label class="c-label">Public HTTPS URL</label>
                            <input type="url" class="c-input" maxlength="500" placeholder="https://github.com/yourhandle/project" data-field="Url" />
                        </div>
                        <div class="c-field">
                            <label class="c-label">Title / Context (optional)</label>
                            <input type="text" class="c-input" maxlength="160" placeholder="e.g. Playable UE5 Combat Prototype" data-field="Title" />
                        </div>
                    </div>
                    <div class="c-field" style="margin-top: 12px;">
                        <span class="c-label">Skills Evidenced by This Link (optional, up to @CandidateProfileRules.MaxEvidencedSkillsPerLink)</span>
                        @if (Model.CandidateSkillsForTagging.Count == 0)
                        {
                            <p class="c-hint" style="margin: 4px 0 0 0;">
                                Add skills in <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="3">Step 3 (Skills)</a> first to tag which skills this link evidences.
                            </p>
                        }
                        else
                        {
                            <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px;">
                                @foreach (var sk in Model.CandidateSkillsForTagging)
                                {
                                    <label class="c-check">
                                        <input type="checkbox" value="@sk.SkillId" data-field="SkillIds" />
                                        <span>@sk.SkillName</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </article>
            </template>
        </section>
    }
    else
    {
        <section class="c-card" aria-labelledby="step5-heading">
            <div class="c-card__header">
                <div>
                    <h2 id="step5-heading" style="font-size: 22px; margin-bottom: 4px;">Step 5 &middot; Compensation, Notice &amp; Work Preferences</h2>
                    <p class="c-hint">Used by upfront hard filters so you only spend time on roles that match your expectations (+10 completeness points).</p>
                </div>
                <span class="c-comp-pill">&#8377; LPA &middot; INR Lakhs Per Annum</span>
            </div>

            <form asp-controller="Candidate" asp-action="SaveStep5" method="post" class="c-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

                <div class="p-sg-grid-2">
                    <div class="c-field">
                        <label asp-for="Step5.ExpectedCtcLpa" class="c-label"></label>
                        <input asp-for="Step5.ExpectedCtcLpa"
                               class="c-input"
                               type="number"
                               min="0.5"
                               max="500"
                               step="0.5"
                               placeholder="e.g. 18.0" />
                        <p class="c-hint">Required (&gt; 0 &#8377; LPA). Used by the salary hard filter against studio budget ceilings.</p>
                        <span asp-validation-for="Step5.ExpectedCtcLpa"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="Step5.CurrentCtcLpa" class="c-label"></label>
                        <input asp-for="Step5.CurrentCtcLpa"
                               class="c-input"
                               type="number"
                               min="0"
                               max="500"
                               step="0.5"
                               placeholder="Optional — hidden by default" />
                        <label class="c-check" style="margin-top: 8px;">
                            <input asp-for="Step5.ShowCurrentCtc" type="checkbox" />
                            <span>Allow verified studios to see my current CTC (off by default)</span>
                        </label>
                        <span asp-validation-for="Step5.CurrentCtcLpa"></span>
                    </div>
                </div>

                <div class="p-sg-grid-2">
                    <div class="c-field">
                        <label asp-for="Step5.NoticePeriodDays" class="c-label"></label>
                        <select asp-for="Step5.NoticePeriodDays" class="c-select">
                            <option value="0">Immediate / 0 days</option>
                            <option value="15">15 days</option>
                            <option value="30">30 days</option>
                            <option value="45">45 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                        </select>
                        <span asp-validation-for="Step5.NoticePeriodDays"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="Step5.Availability" class="c-label"></label>
                        <select asp-for="Step5.Availability" class="c-select">
                            <option value="@CandidateAvailability.ActivelyLooking">Actively looking</option>
                            <option value="@CandidateAvailability.OpenToOffers">Open to offers</option>
                            <option value="@CandidateAvailability.NotLooking">Not looking right now</option>
                        </select>
                        <span asp-validation-for="Step5.Availability"></span>
                    </div>
                </div>

                <div class="c-card" style="background: var(--surface-2); padding: 14px 16px;">
                    <div class="c-form" style="gap: 10px;">
                        <label class="c-check">
                            <input asp-for="Step5.OpenToRemote" type="checkbox" />
                            <span><strong>Open to remote roles</strong> across India</span>
                        </label>
                        <label class="c-check">
                            <input asp-for="Step5.WillingToRelocate" type="checkbox" />
                            <span><strong>Willing to relocate</strong> for hybrid or on-site studio roles in another city</span>
                        </label>
                    </div>
                </div>

                <div class="c-card__footer">
                    <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="4" class="c-btn c-btn--ghost">&larr; Back to Proof</a>
                    <button type="submit" class="c-btn c-btn--primary c-btn--lg">Save Preferences &amp; View Profile &rarr;</button>
                </div>
            </form>
        </section>
    }
</div>
