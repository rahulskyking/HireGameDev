@model CandidateProfileOverviewViewModel
@{
    var p = Model.Profile;
    var c = Model.Completeness;
    ViewData["Title"] = $"{p.FullName} · Developer Profile";

    var matchVariant = c.TotalScore >= 70 ? "c-match--strong" : c.TotalScore >= 60 ? "c-match--good" : "c-match--partial";
    var availabilityBadge = p.Availability switch
    {
        CandidateAvailability.ActivelyLooking => ("Actively looking", "c-badge--success"),
        CandidateAvailability.OpenToOffers => ("Open to offers", "c-badge--info"),
        _ => ("Not looking", "c-badge--neutral")
    };

    var initials = !string.IsNullOrWhiteSpace(p.FullName)
        ? char.ToUpperInvariant(p.FullName.Trim()[0]).ToString()
        : "D";
}

<div class="p-sg-stack">
    @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="c-alert c-alert--success" role="status">
            <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 10.5 8 14.5 16 6.5" /></svg>
            <div class="c-alert__content"><p>@statusMessage</p></div>
        </div>
    }

    <!-- Profile Summary Header -->
    <section class="c-card" aria-labelledby="candidate-profile-heading">
        <div class="c-card__header" style="align-items: flex-start; gap: 16px; flex-wrap: wrap;">
            <div class="c-entity-head">
                <span class="c-entity-mark c-entity-mark--accent">@initials</span>
                <div>
                    <h1 id="candidate-profile-heading" style="margin: 0; font-size: 24px;">@p.FullName</h1>
                    <p class="u-muted" style="margin: 4px 0 0 0;">@p.Headline</p>
                </div>
            </div>

            <div class="c-btn-group">
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="1" class="c-btn c-btn--secondary c-btn--sm">Edit Basics</a>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="2" class="c-btn c-btn--secondary c-btn--sm">Edit Experience</a>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="3" class="c-btn c-btn--secondary c-btn--sm">Edit Skills</a>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="4" class="c-btn c-btn--secondary c-btn--sm">Edit Proof</a>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="5" class="c-btn c-btn--primary c-btn--sm">Edit Preferences</a>
            </div>
        </div>

        <div class="c-badge-row">
            <span class="c-badge @availabilityBadge.Item2">@availabilityBadge.Item1</span>
            <span class="c-badge c-badge--accent">@p.PrimaryCategory.ToString().ToLowerInvariant()</span>
            <span class="c-badge c-badge--neutral">@p.Seniority.ToString().ToLowerInvariant() &middot; @p.YearsExperience.ToString("0.#") yrs</span>
            @if (!string.IsNullOrWhiteSpace(p.CityName))
            {
                <span class="c-badge c-badge--neutral">@p.CityName, @p.CityStateCode</span>
            }
            @if (p.OpenToRemote)
            {
                <span class="c-badge c-badge--info">Open to remote</span>
            }
            @if (p.WillingToRelocate)
            {
                <span class="c-badge c-badge--info">Willing to relocate</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(p.Bio))
        {
            <p style="margin: 8px 0 0 0; white-space: pre-line;">@p.Bio</p>
        }

        <hr />

        <div class="p-sg-grid-3">
            <div>
                <span class="c-label">Expected Compensation</span>
                <div style="margin-top: 4px;">
                    @if (p.ExpectedCtcLpa.HasValue)
                    {
                        <span class="c-comp-pill">&#8377; @p.ExpectedCtcLpa.Value.ToString("0.##") LPA</span>
                    }
                    else
                    {
                        <span class="c-hint">Not set yet (<a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="5">add in Step 5</a>)</span>
                    }
                </div>
            </div>

            <div>
                <span class="c-label">Current CTC Privacy</span>
                <div style="margin-top: 4px;">
                    @if (p.CurrentCtcLpa.HasValue && p.ShowCurrentCtc)
                    {
                        <span class="c-badge c-badge--info">&#8377; @p.CurrentCtcLpa.Value.ToString("0.##") LPA (Visible to studios)</span>
                    }
                    else
                    {
                        <span class="c-badge c-badge--neutral">Locked &middot; Hidden from studios</span>
                    }
                </div>
            </div>

            <div>
                <span class="c-label">Notice &amp; Contact Gating</span>
                <div style="margin-top: 4px;">
                    <span class="c-badge c-badge--neutral">
                        @(p.NoticePeriodDays.HasValue ? (p.NoticePeriodDays.Value == 0 ? "Immediate joiner" : $"{p.NoticePeriodDays.Value}d notice") : "Notice not set")
                    </span>
                    <span class="c-badge c-badge--neutral">Phone gated until shortlist</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills & Proficiency Matrix (M1.2) -->
    <section class="c-card" aria-labelledby="candidate-skills-heading">
        <div class="c-card__header">
            <div>
                <h2 id="candidate-skills-heading" style="font-size: 20px; margin-bottom: 4px;">Skills &amp; Proficiency (@Model.Skills.Count)</h2>
                <p class="c-hint">Primary skills carry top visual prominence; shipped titles and portfolio links upgrade skills to Backed (0.90&times;) or Verified (1.00&times;).</p>
            </div>
            <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="3" class="c-btn c-btn--secondary c-btn--sm">
                @(Model.Skills.Count == 0 ? "Add Skills" : "Manage Skills")
            </a>
        </div>

        @if (Model.Skills.Count == 0)
        {
            <p class="c-hint" style="margin: 0;">No skills added yet. Add at least 5 skills in Step 3 to earn +15% completeness.</p>
        }
        else
        {
            <div class="c-chip-list">
                @foreach (var skill in Model.Skills)
                {
                    var chipClass = skill.EvidenceLevel == SkillEvidenceLevel.Verified
                        ? "c-chip c-chip--verified"
                        : skill.IsPrimary
                            ? "c-chip c-chip--accent"
                            : "c-chip";
                    var yearsSuffix = skill.YearsUsed.HasValue ? $" · {skill.YearsUsed.Value:0.#}y" : string.Empty;
                    var evidenceSuffix = skill.EvidenceLevel switch
                    {
                        SkillEvidenceLevel.Verified => " · Verified",
                        SkillEvidenceLevel.Backed => " · Proof submitted",
                        _ => string.Empty
                    };
                    <span class="@chipClass">
                        @(skill.IsPrimary ? "★ " : string.Empty)@skill.SkillName &middot; @skill.Proficiency@yearsSuffix@evidenceSuffix
                    </span>
                }
            </div>
        }
    </section>

    <!-- Shipped Titles & Portfolio Proof Showcase (M1.4) -->
    <div class="p-sg-grid-2" style="align-items: start;">
        <section class="c-card" aria-labelledby="candidate-shipped-heading">
            <div class="c-card__header">
                <div>
                    <h2 id="candidate-shipped-heading" style="font-size: 20px; margin-bottom: 4px;">Shipped Game Credits (@Model.PublicProof.ShippedTitles.Count)</h2>
                    <p class="c-hint">Public/studio-safe projection (NDA redaction active where configured).</p>
                </div>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="4" class="c-btn c-btn--secondary c-btn--sm">
                    @(Model.PublicProof.ShippedTitles.Count == 0 ? "Add" : "Manage")
                </a>
            </div>

            @if (Model.PublicProof.ShippedTitles.Count == 0)
            {
                <p class="c-hint" style="margin: 0;">No shipped credits added yet. Add 1 shipped title or portfolio link in Step 4 to unlock +20% completeness.</p>
            }
            else
            {
                var ownerTitlesById = Model.OwnerProof.ShippedTitles.ToDictionary(t => t.Id);
                <div class="p-sg-stack">
                    @foreach (var pubTitle in Model.PublicProof.ShippedTitles)
                    {
                        var verifyBadge = pubTitle.Verification switch
                        {
                            ShippedTitleVerification.CreditVerified => ("Credit verified", "c-badge--success"),
                            ShippedTitleVerification.TitleVerified => ("Title verified", "c-badge--success"),
                            _ => ("Submitted credit · Unverified", "c-badge--neutral")
                        };

                        string? resolvedStoreHref = !string.IsNullOrWhiteSpace(pubTitle.PublicStoreUrl) &&
                                                    HireGameDev.Domain.Rules.ExternalUrlRules.TryNormalizeHttpsUrl(pubTitle.PublicStoreUrl, out var safeStoreHref, out _)
                            ? safeStoreHref
                            : null;

                        <article style="padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
                            <div style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: baseline;">
                                <strong>@pubTitle.DisplayTitle</strong>
                                <div class="c-badge-row" style="gap: 6px;">
                                    @if (pubTitle.IsNda)
                                    {
                                        <span class="c-badge c-badge--warning">NDA Redacted</span>
                                    }
                                    <span class="c-badge @verifyBadge.Item2">@verifyBadge.Item1</span>
                                </div>
                            </div>

                            <div class="u-muted" style="font-size: 14px; margin-top: 2px;">
                                @pubTitle.Role &middot; @pubTitle.DisplayStudio@(pubTitle.ReleaseYear.HasValue ? $" · {pubTitle.ReleaseYear.Value}" : string.Empty)
                            </div>

                            <div class="c-badge-row" style="margin-top: 6px; gap: 6px;">
                                @if (!string.IsNullOrWhiteSpace(pubTitle.EngineSkillName))
                                {
                                    <span class="c-badge c-badge--accent">@pubTitle.EngineSkillName</span>
                                }
                                @foreach (var plat in pubTitle.Platforms)
                                {
                                    <span class="c-badge c-badge--neutral">@plat.ToUpperInvariant()</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(resolvedStoreHref))
                                {
                                    <a href="@resolvedStoreHref"
                                       target="_blank"
                                       rel="noopener noreferrer ugc"
                                       style="font-size: 13px;">
                                        Store / Page &nearr;
                                    </a>
                                }
                            </div>

                            @if (pubTitle.IsNda && ownerTitlesById.TryGetValue(pubTitle.Id, out var ownerCopy))
                            {
                                <p class="c-hint" style="margin: 6px 0 0 0;">
                                    <strong>Private owner record (hidden from studios &amp; public):</strong>
                                    @ownerCopy.GameName &middot; @ownerCopy.StudioName
                                </p>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="c-card" aria-labelledby="candidate-portfolio-heading">
            <div class="c-card__header">
                <div>
                    <h2 id="candidate-portfolio-heading" style="font-size: 20px; margin-bottom: 4px;">Portfolio &amp; Playable Links (@Model.PublicProof.PortfolioLinks.Count)</h2>
                    <p class="c-hint">Submitted external HTTPS proof mapped to skills.</p>
                </div>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="4" class="c-btn c-btn--secondary c-btn--sm">
                    @(Model.PublicProof.PortfolioLinks.Count == 0 ? "Add" : "Manage")
                </a>
            </div>

            @if (Model.PublicProof.PortfolioLinks.Count == 0)
            {
                <p class="c-hint" style="margin: 0;">No portfolio links added yet. Attach GitHub, itch.io, ArtStation, or demo reel links in Step 4.</p>
            }
            else
            {
                <div class="p-sg-stack">
                    @foreach (var link in Model.PublicProof.PortfolioLinks)
                    {
                        var isSafeUrl = HireGameDev.Domain.Rules.ExternalUrlRules.TryNormalizeHttpsUrl(link.Url, out var safePortfolioHref, out _);
                        var typeLabel = link.LinkType switch
                        {
                            PortfolioLinkType.Github => "GitHub",
                            PortfolioLinkType.Itchio => "itch.io",
                            PortfolioLinkType.Artstation => "ArtStation",
                            PortfolioLinkType.Behance => "Behance",
                            PortfolioLinkType.Youtube => "YouTube",
                            PortfolioLinkType.Website => "Website",
                            PortfolioLinkType.Linkedin => "LinkedIn",
                            _ => "Other"
                        };

                        <article style="padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
                            <div style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: baseline;">
                                <div>
                                    <span class="c-badge c-badge--neutral" style="margin-right: 6px;">@typeLabel</span>
                                    @if (isSafeUrl)
                                    {
                                        <a href="@safePortfolioHref" target="_blank" rel="noopener noreferrer ugc">
                                            <strong>@(string.IsNullOrWhiteSpace(link.Title) ? safePortfolioHref : link.Title)</strong> &nearr;
                                        </a>
                                    }
                                    else
                                    {
                                        <strong>@(string.IsNullOrWhiteSpace(link.Title) ? "Portfolio Item" : link.Title)</strong>
                                    }
                                </div>
                                <span class="c-badge c-badge--info">Submitted proof</span>
                            </div>

                            @if (link.EvidencedSkills.Count > 0)
                            {
                                <div class="c-chip-list" style="margin-top: 8px;">
                                    @foreach (var sk in link.EvidencedSkills)
                                    {
                                        <span class="c-chip">@sk.SkillName</span>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    <!-- Work Experience & Education Timeline (M1.3) -->
    <div class="p-sg-grid-2" style="align-items: start;">
        <section class="c-card" aria-labelledby="candidate-experience-heading">
            <div class="c-card__header">
                <div>
                    <h2 id="candidate-experience-heading" style="font-size: 20px; margin-bottom: 4px;">Work Experience (@Model.Experiences.Count)</h2>
                    <p class="c-hint">Studio, contract, and engineering timeline.</p>
                </div>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="2" class="c-btn c-btn--secondary c-btn--sm">
                    @(Model.Experiences.Count == 0 ? "Add" : "Edit")
                </a>
            </div>

            @if (Model.Experiences.Count == 0)
            {
                <p class="c-hint" style="margin: 0;">
                    @(p.YearsExperience < 1.0m || p.Seniority == SeniorityLevel.Fresher
                        ? "No work history yet — as a fresher, adding Education earns your +15% experience credit."
                        : "No work experience added yet. Add at least 1 role in Step 2 to earn +15% completeness.")
                </p>
            }
            else
            {
                <div class="p-sg-stack">
                    @foreach (var exp in Model.Experiences)
                    {
                        var dateRange = exp.IsCurrent
                            ? $"{exp.StartDate:MMM yyyy} – Present"
                            : exp.EndDate.HasValue
                                ? $"{exp.StartDate:MMM yyyy} – {exp.EndDate.Value:MMM yyyy}"
                                : $"{exp.StartDate:MMM yyyy}";
                        <article style="padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
                            <div style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: baseline;">
                                <strong>@exp.Title</strong>
                                <span class="c-badge @(exp.IsCurrent ? "c-badge--success" : "c-badge--neutral")">@dateRange</span>
                            </div>
                            <div class="u-muted" style="font-size: 14px; margin-top: 2px;">@exp.CompanyName</div>
                            @if (!string.IsNullOrWhiteSpace(exp.Description))
                            {
                                <p style="margin: 6px 0 0 0; font-size: 14px; white-space: pre-line;">@exp.Description</p>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="c-card" aria-labelledby="candidate-education-heading">
            <div class="c-card__header">
                <div>
                    <h2 id="candidate-education-heading" style="font-size: 20px; margin-bottom: 4px;">Education (@Model.Education.Count)</h2>
                    <p class="c-hint">Degrees, game-dev institutes, and diplomas.</p>
                </div>
                <a asp-controller="Candidate" asp-action="Onboarding" asp-route-step="2" class="c-btn c-btn--secondary c-btn--sm">
                    @(Model.Education.Count == 0 ? "Add" : "Edit")
                </a>
            </div>

            @if (Model.Education.Count == 0)
            {
                <p class="c-hint" style="margin: 0;">No education entries added yet. Add an entry in Step 2 for +5% completeness.</p>
            }
            else
            {
                <div class="p-sg-stack">
                    @foreach (var edu in Model.Education)
                    {
                        var yearsText = edu.StartYear.HasValue && edu.EndYear.HasValue
                            ? $"{edu.StartYear} – {edu.EndYear}"
                            : edu.EndYear.HasValue
                                ? $"Class of {edu.EndYear}"
                                : edu.StartYear.HasValue
                                    ? $"Started {edu.StartYear}"
                                    : null;
                        <article style="padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
                            <div style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: baseline;">
                                <strong>@edu.Degree@(!string.IsNullOrWhiteSpace(edu.Field) ? $" · {edu.Field}" : string.Empty)</strong>
                                @if (!string.IsNullOrWhiteSpace(yearsText))
                                {
                                    <span class="c-badge c-badge--neutral">@yearsText</span>
                                }
                            </div>
                            <div class="u-muted" style="font-size: 14px; margin-top: 2px;">@edu.Institution</div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    <!-- Points-Sorted Completeness Checklist (Blueprint Section 5) -->
    <section class="c-card" aria-labelledby="completeness-checklist-heading">
        <div class="c-card__header" style="align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
                <h2 id="completeness-checklist-heading" style="font-size: 20px; margin-bottom: 4px;">Profile Completion Checklist</h2>
                @if (c.NextBestStep is not null)
                {
                    <p class="c-hint">
                        <strong>Next best step:</strong> @c.NextBestStep.Label (<strong>+@c.NextBestStep.Points pts</strong>)
                    </p>
                }
                else
                {
                    <p class="c-hint">Your profile is 100% complete across every matching signal.</p>
                }
            </div>

            <div class="c-match @matchVariant" style="min-width: 220px;">
                <div class="c-match__top">
                    <span>@(c.MeetsDiscoverabilityThreshold ? "Studio-discoverable (≥70%)" : c.MeetsApplyThreshold ? "Apply-ready (≥60%)" : "Below 60% apply gate")</span>
                    <span class="c-match__score">@c.TotalScore%</span>
                </div>
                <div class="c-match__track">
                    <div class="c-match__fill" style="width: @(c.TotalScore)%;"></div>
                </div>
            </div>
        </div>

        <div class="c-table-wrap">
            <table class="c-table">
                <thead>
                    <tr>
                        <th scope="col">Signal</th>
                        <th scope="col">Points</th>
                        <th scope="col">Status</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in c.Items)
                    {
                        <tr>
                            <td>@item.Label</td>
                            <td class="u-mono">+@item.Points</td>
                            <td>
                                @if (item.IsComplete)
                                {
                                    <span class="c-badge c-badge--success">Complete</span>
                                }
                                else
                                {
                                    <span class="c-badge c-badge--neutral">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Candidate"
                                   asp-action="Onboarding"
                                   asp-route-step="@item.OnboardingStep"
                                   class="c-btn c-btn--ghost c-btn--sm">
                                    @(item.IsComplete ? "Review" : "Complete") (Step @item.OnboardingStep)
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
