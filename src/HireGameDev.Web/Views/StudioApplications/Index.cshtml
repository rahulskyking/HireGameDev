@model HireGameDev.Web.Models.Applications.ApplicantListPage
@{ ViewData["Title"] = "Applicants"; }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<main class="ap">@if (Model.StudioId.HasValue) { <a asp-controller="StudioJobs" asp-action="Manage" asp-route-id="@Model.JobId" asp-route-studioId="@Model.StudioId">← Back to job management</a> } else { <a asp-controller="StudioJobs" asp-action="Index">← Studio jobs</a> }<h1>Applicants</h1><p>Only applications you are currently allowed to access are shown.</p>
<form asp-action="Index" asp-route-jobId="@Model.JobId" method="get" class="ap-filter"><input type="hidden" name="studioId" value="@Model.StudioId" /><label for="applicationStatus">Filter by status</label><select id="applicationStatus" name="applicationStatus"><option value="">All visible applications</option>@foreach (var value in new[] { ApplicationStatus.Submitted, ApplicationStatus.Reviewing, ApplicationStatus.Shortlisted, ApplicationStatus.Rejected, ApplicationStatus.Hired }) { <option value="@value" selected="@(Model.Status == value)">@value</option> }</select><button class="c-btn c-btn--secondary" type="submit">Apply filter</button></form>
@if (Model.Results.Items.Count == 0) { <p>No applications to show.</p> }
@foreach (var item in Model.Results.Items) { <article class="ap-card"><h2>@(item.CandidateName ?? "Application") <small>@(item.ApplicationId.ToString("N")[..8])</small></h2><p>@item.Status · @item.SubmittedAt.ToString("dd MMM yyyy")</p><a asp-action="Detail" asp-route-applicationId="@item.ApplicationId">View snapshot →</a></article> }
<nav class="ap-actions" aria-label="Applicant pages">@if (Model.Page > 1) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-page="@(Model.Page - 1)" asp-route-applicationStatus="@Model.Status" asp-route-studioId="@Model.StudioId">Previous</a> } @if (Model.Results.HasMore) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-page="@(Model.Page + 1)" asp-route-applicationStatus="@Model.Status" asp-route-studioId="@Model.StudioId">Next</a> }</nav>
<p>List order can change between pages as applications or access change.</p></main>
