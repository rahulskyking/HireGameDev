@model HireGameDev.Web.Models.Applications.ApplicantListPage
@{ ViewData["Title"] = "Applicants"; }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<div class="ap">
    @if (Model.StudioId.HasValue) { <a class="ap-back" asp-controller="StudioJobs" asp-action="Manage" asp-route-id="@Model.JobId" asp-route-studioId="@Model.StudioId">← Back to job</a> } else { <a class="ap-back" asp-controller="StudioJobs" asp-action="Index">← Back to jobs</a> }
    <header class="ap-header"><div><span class="ap-label">Hiring workspace</span><h1>Applicants</h1><p class="ap-muted">Review applications for this job and update their status.</p></div></header>
    <section class="ap-panel" aria-label="Applications">
        <div class="ap-section-head"><div><h2>Applications</h2><p class="ap-muted">Only applicants you can currently access are shown.</p></div>
            <form asp-action="Index" asp-route-jobId="@Model.JobId" method="get" class="ap-filter">
                <input type="hidden" name="studioId" value="@Model.StudioId" /><label for="applicationStatus">Status</label>
                <select id="applicationStatus" name="applicationStatus"><option value="">All statuses</option>@foreach (var value in new[] { ApplicationStatus.Submitted, ApplicationStatus.Reviewing, ApplicationStatus.Shortlisted, ApplicationStatus.Rejected, ApplicationStatus.Hired }) { <option value="@value" selected="@(Model.Status == value)">@value</option> }</select>
                <button class="c-btn c-btn--secondary c-btn--sm" type="submit">Filter</button>
            </form>
        </div>
        @if (Model.Results.Items.Count == 0) { <div class="ap-empty"><h2>@(Model.Status.HasValue ? "No applicants with this status" : Model.Page > 1 ? "No applicants on this page" : "No applications yet")</h2><p>@(Model.Status.HasValue ? "Try a different status to see more applicants." : "Applications you can review will appear here.")</p>@if (Model.Status.HasValue) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-studioId="@Model.StudioId">Clear filter</a> }</div> }
        else { <div class="ap-list">@foreach (var item in Model.Results.Items) { <article class="ap-list-item"><div class="ap-list-main"><div class="ap-item-title"><h3>@(item.CandidateName ?? "Application")</h3><span class="ap-status" data-status="@item.Status">@item.Status</span></div><p>Applied <time datetime="@item.SubmittedAt.ToString("O")">@item.SubmittedAt.ToString("dd MMM yyyy")</time> · Ref @(item.ApplicationId.ToString("N")[..8])</p></div><a class="c-btn c-btn--secondary c-btn--sm" asp-action="Detail" asp-route-applicationId="@item.ApplicationId" asp-route-studioId="@Model.StudioId" asp-route-page="@Model.Page" asp-route-applicationStatus="@Model.Status" aria-label="Review application from @(item.CandidateName ?? "applicant")">Review application →</a></article> }</div> }
        @if (Model.Page > 1 || Model.Results.HasMore) { <nav class="ap-pagination" aria-label="Applicant pages">@if (Model.Page > 1) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-page="@(Model.Page - 1)" asp-route-applicationStatus="@Model.Status" asp-route-studioId="@Model.StudioId">← Previous</a> }<span>Page @Model.Page</span>@if (Model.Results.HasMore) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-page="@(Model.Page + 1)" asp-route-applicationStatus="@Model.Status" asp-route-studioId="@Model.StudioId">Next →</a> }</nav> }
    </section>
</div>
