@model HireGameDev.Web.Models.Applications.ApplicantListPage
@{ ViewData["Title"] = "Applicants"; }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<div class="ap ap-desk">
    <div class="ap-topline">@if (Model.StudioId.HasValue) { <a asp-controller="StudioJobs" asp-action="Manage" asp-route-id="@Model.JobId" asp-route-studioId="@Model.StudioId">← Back to job</a> } else { <a asp-controller="StudioJobs" asp-action="Index">← Back to jobs</a> }<span>HIRING / APPLICANTS</span></div>
    <header class="ap-hero"><div><span class="ap-hero-kicker">● &nbsp; HIRING WORKSPACE</span><h1>Meet your<br /><em>applicants.</em></h1><p>Get to know the people interested in this role. Review their submitted profile and keep their status up to date.</p></div><div class="ap-hero-aside"><span>YOUR WORKFLOW</span><strong>Review with<br />intention. ↗</strong><p>Applications for this job, in one place.</p></div></header>
    <div class="ap-workspace">
        <aside class="ap-rail"><span class="ap-rail-label">REFINE YOUR VIEW</span><h2>By status</h2><p>Choose a stage to focus on.</p>
            <form asp-action="Index" asp-route-jobId="@Model.JobId" method="get" class="ap-filter ap-filter--rail"><input type="hidden" name="studioId" value="@Model.StudioId" /><label for="applicationStatus">Application status</label><select id="applicationStatus" name="applicationStatus"><option value="">All statuses</option>@foreach (var value in new[] { ApplicationStatus.Submitted, ApplicationStatus.Reviewing, ApplicationStatus.Shortlisted, ApplicationStatus.Rejected, ApplicationStatus.Hired }) { <option value="@value" selected="@(Model.Status == value)">@value</option> }</select><button class="c-btn c-btn--secondary" type="submit">Apply filter</button></form>
            <div class="ap-rail-note"><strong>Private by design</strong><p>Only applicants you can currently access appear here.</p></div>
        </aside>
        <section class="ap-board" aria-label="Applications"><div class="ap-board-head"><div><span class="ap-rail-label">YOUR APPLICANTS / @(Model.Status?.ToString().ToUpperInvariant() ?? "ALL")</span><h2>Applicants <span>@(Model.Status?.ToString() ?? "All statuses")</span></h2><p>Open an application to view the submitted snapshot. Match scores compare assessed criteria; they are not hiring decisions.</p></div><span class="ap-board-mark">↗</span></div>
            @if (Model.Results.Items.Count == 0) { <div class="ap-empty"><span class="ap-empty-mark">↗</span><h2>@(Model.Status.HasValue ? "No applicants at this stage" : Model.Page > 1 ? "No applicants on this page" : "No applications yet")</h2><p>@(Model.Status.HasValue ? "Try another status to see more applicants." : "When someone applies, their application will appear here.")</p>@if (Model.Status.HasValue) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-studioId="@Model.StudioId">Clear filter →</a> }</div> }
            else { <div class="ap-people">@foreach (var item in Model.Results.Items) { <article class="ap-person"><div class="ap-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(item.CandidateName) ? "A" : item.CandidateName.Trim().Substring(0, 1).ToUpperInvariant())</div><div class="ap-person-info"><div class="ap-person-top"><span class="ap-status" data-status="@item.Status">@item.Status</span><span class="ap-reference">REF @(item.ApplicationId.ToString("N")[..8])</span></div><h3>@(item.CandidateName ?? "Application")</h3><p>Applied <time datetime="@item.SubmittedAt.ToString("O")">@item.SubmittedAt.ToString("dd MMM yyyy")</time></p><div class="ap-card-fit">
                @if (item.FitScore?.Percentage is int score)
                {
                    <div class="ap-match-ring" role="img" aria-label="@score percent profile match on assessed criteria">
                        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><circle class="ap-match-track" cx="20" cy="20" r="16" /><circle class="ap-match-progress" cx="20" cy="20" r="16" pathLength="100" stroke-dasharray="@score 100" /></svg>
                        <strong aria-hidden="true">@score%</strong>
                    </div>
                    <div class="ap-match-copy"><strong>Profile match</strong><span>@item.FitScore.Coverage% of applicable criteria assessed</span>@if (item.FitScore.Coverage < 70) { <span>Limited data</span> }@if (item.UsesCurrentJobRequirements) { <span>Current job requirements</span> }</div>
                }
                else { <div class="ap-match-copy"><strong>Match unavailable</strong><span>Open to review</span></div> }
            </div></div><a class="ap-open" asp-action="Detail" asp-route-applicationId="@item.ApplicationId" asp-route-studioId="@Model.StudioId" asp-route-page="@Model.Page" asp-route-applicationStatus="@Model.Status" aria-label="Review application from @(item.CandidateName ?? "applicant")">Review <span>↗</span></a></article> }</div> }
            @if (Model.Page > 1 || Model.Results.HasMore) { <nav class="ap-pagination" aria-label="Applicant pages">@if (Model.Page > 1) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-page="@(Model.Page - 1)" asp-route-applicationStatus="@Model.Status" asp-route-studioId="@Model.StudioId">← Previous</a> }<span>Page @Model.Page</span>@if (Model.Results.HasMore) { <a asp-action="Index" asp-route-jobId="@Model.JobId" asp-route-page="@(Model.Page + 1)" asp-route-applicationStatus="@Model.Status" asp-route-studioId="@Model.StudioId">Next →</a> }</nav> }
        </section>
    </div>
</div>
