@using HireGameDev.Application.Abstractions.Applications
@using HireGameDev.Application.Features.Applications
@model HireGameDev.Web.Models.Applications.StudioApplicantDetailPage
@{ ViewData["Title"] = "Applicant snapshot"; var application = Model.Application; var snapshot = new ApplicationSnapshotDraft(1, application.Candidate, application.Job, application.Phone); var options = Enum.GetValues<ApplicationStatus>().Where(x => ApplicationLifecycleRules.CanStudioTransition(application.Status, x)).ToArray(); }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<div class="ap">
    <a class="ap-back" asp-action="Index" asp-route-jobId="@application.JobId" asp-route-studioId="@Model.StudioId" asp-route-page="@Model.Page" asp-route-applicationStatus="@Model.Status">← Back to applicants</a>
    <header class="ap-header"><div><span class="ap-label">Applicant snapshot</span><h1>Applicant snapshot</h1><p class="ap-muted">@application.Candidate.FullName · @application.Job.JobTitle</p></div><span class="ap-status" data-status="@application.Status">@application.Status</span></header>
    @if (TempData["ApplicationMessage"] is string message) { <p class="ap-note" role="status">@message</p> }
    <p class="ap-muted">This is the submitted snapshot, not the Candidate’s live profile. Treat its contents as confidential.</p>
    @if (application.CanChangeStatus && options.Length > 0) {
        <section class="ap-card"><h2>Change status</h2><p class="ap-muted">Choose the next step. Marking an applicant as Hired is final and cannot be undone here.</p>
            <form class="ap-status-form" asp-action="ChangeStatus" asp-route-applicationId="@application.ApplicationId" method="post">
                <input type="hidden" name="studioId" value="@Model.StudioId" /><input type="hidden" name="page" value="@Model.Page" /><input type="hidden" name="applicationStatus" value="@Model.Status" />
                <label for="newStatus">New status</label><select id="newStatus" name="newStatus">@foreach (var option in options) { <option value="@option">@option</option> }</select>
                <label class="ap-check"><input type="checkbox" name="confirmed" value="true" required /> I confirm this status change</label><button class="c-btn c-btn--primary" type="submit">Update</button>
            </form>
        </section>
    } else if (!application.CanChangeStatus) { <p class="ap-note">Viewer access is read-only.</p> }
    <partial name="_ApplicationSnapshot" model="snapshot" />
</div>
