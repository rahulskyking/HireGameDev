@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Console";
    var c = Model.StudioCounts;
}

<div class="p-sg-stack">
    <header class="p-sg-section">
        <div class="c-badge-row">
            <span class="c-badge c-badge--accent">Admin Console &middot; hiregamedev.com/Admin</span>
            <span class="c-badge c-badge--success">Audit-Reason Enforced (ADR-010)</span>
            @if (Model.PastSlaPendingCount > 0)
            {
                <span class="c-badge c-badge--danger">@Model.PastSlaPendingCount Pending Over 24h SLA</span>
            }
        </div>
        <h1>Platform Administration</h1>
        <p class="u-muted">
            Restricted to verified <code>admin</code> role holders on the apex domain. Every administrative decision requires an internal audit reason persisted to <code>audit_logs</code>.
        </p>
    </header>

    <div class="p-sg-grid-3">
        <!-- Active Module: Studio Verification Queue (M1.10) -->
        <section class="c-card c-card--elevated" aria-labelledby="admin-studio-queue-heading">
            <div class="c-card__header">
                <h2 id="admin-studio-queue-heading" style="margin: 0; font-size: 19px;">Studio Verification Queue</h2>
                <span class="c-badge @(c.PendingCount > 0 ? "c-badge--accent" : "c-badge--neutral")">
                    @c.PendingCount Pending
                </span>
            </div>

            <p class="u-muted" style="margin-top: 0;">
                Review new studio verification submissions, indie store/domain proofs, and staged <code>Name</code> / <code>Slug</code> / <code>GSTIN</code> re-verification diffs.
            </p>

            <div class="c-badge-row" style="margin-bottom: 16px;">
                <span class="c-badge c-badge--info">@c.PendingInitialCount Initial</span>
                <span class="c-badge c-badge--info">@c.PendingIdentityChangeCount Identity Diffs</span>
                <span class="c-badge c-badge--success">@c.VerifiedCount Verified</span>
                <span class="c-badge c-badge--warning">@c.RejectedCount Rejected</span>
            </div>

            <div class="c-card__footer" style="margin-top: auto;">
                <a asp-controller="Admin"
                   asp-action="StudioVerification"
                   asp-route-status="pending"
                   class="c-btn c-btn--primary c-btn--block">
                    Open Studio Review Queue (@c.PendingCount)
                </a>
            </div>
        </section>

        <!-- Upcoming Module: Job Listing Moderation (M2.5) -->
        <section class="c-card" aria-labelledby="admin-jobs-heading">
            <div class="c-card__header">
                <h2 id="admin-jobs-heading" style="margin: 0; font-size: 19px;">Job Moderation</h2>
                <span class="c-badge c-badge--neutral">Phase 2 &middot; M2.5</span>
            </div>
            <p class="u-muted" style="margin: 0;">
                Flagged structured job listings, compensation range checks, and studio responsiveness enforcement mount here in Phase 2.
            </p>
        </section>

        <!-- Upcoming Module: Live Settings & Trust Reports (M4.5) -->
        <section class="c-card" aria-labelledby="admin-settings-heading">
            <div class="c-card__header">
                <h2 id="admin-settings-heading" style="margin: 0; font-size: 19px;">Settings &amp; Trust Reports</h2>
                <span class="c-badge c-badge--neutral">Phase 4 &middot; M4.5</span>
            </div>
            <p class="u-muted" style="margin: 0;">
                Runtime <code>app_settings</code> thresholds, taxonomy CSV import/export, and candidate/studio abuse reports mount here in Phase 4.
            </p>
        </section>
    </div>
</div>
