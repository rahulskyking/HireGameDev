@model HireGameDev.Web.Controllers.PlanAdminPage
@{ ViewData["Title"] = "Plans and limits"; }
<section class="p-sg-stack">
    <a asp-controller="Admin" asp-action="Index">← Admin console</a>
    <header><h1>Plans and limits</h1><p>Manage quota limits and assign Free or Premium manually. Changes require an audit reason. Billing is not implemented. Featured job placements are managed separately.</p></header>
    @if (TempData["PlanMessage"] is string message) { <p role="status">@message</p> }
    <section class="c-card"><h2>Plan limits</h2><p>Candidate limits count successful applications in a rolling 30 days, including withdrawals. Studio limits count unexpired Active, Paused and Full jobs. Other safety and posting limits still apply.</p>
        @foreach (var limit in Model.Limits)
        {
            <form asp-action="Limit" method="post" class="c-form">
                <input type="hidden" name="audience" value="@limit.Audience" /><input type="hidden" name="plan" value="@limit.Plan" />
                <label class="c-label" for="limit-@limit.Audience-@limit.Plan">@limit.Audience / @limit.Plan limit</label>
                <input class="c-input" id="limit-@limit.Audience-@limit.Plan" name="limit" type="number" min="1" max="10000" value="@limit.Limit" required />
                <label class="c-label" for="reason-@limit.Audience-@limit.Plan">Reason</label><input class="c-input" id="reason-@limit.Audience-@limit.Plan" name="reason" maxlength="500" required />
                <button class="c-btn c-btn--secondary" type="submit">Update @limit.Audience @limit.Plan</button>
            </form>
        }
    </section>
    <section class="c-card"><h2>Assign a plan</h2><p>Search by Candidate name or email, or Studio name. Profiles without an assignment use Free. Downgrades do not close jobs or remove applications.</p>
        <form asp-action="Index" method="get" class="c-form"><label class="c-label" for="audience">Account type</label><select class="c-select" id="audience" name="audience"><option value="candidate" selected="@(Model.Audience == "candidate")">Candidate</option><option value="studio" selected="@(Model.Audience == "studio")">Studio</option></select>
            <label class="c-label" for="search">Search (at least 3 characters)</label><input class="c-input" id="search" name="search" value="@Model.Search" minlength="3" maxlength="100" required /><button class="c-btn c-btn--primary" type="submit">Search</button></form>
        @if (Model.Search.Length >= 3 && Model.Targets.Count == 0) { <p>No profiles found.</p> }
        @if (Model.Targets.Count > 0) { <p>Showing up to 25 matches. Check the identifier before assigning.</p> }
        @foreach (var target in Model.Targets)
        {
            <article><h3>@target.Name</h3><p>@target.Detail · ID @target.Id · Current plan: @target.Plan</p>
                <form asp-action="Assign" method="post" class="c-form"><input type="hidden" name="audience" value="@Model.Audience" /><input type="hidden" name="profileId" value="@target.Id" />
                    <label class="c-label" for="plan-@target.Id">Plan for @target.Name</label><select class="c-select" id="plan-@target.Id" name="plan"><option value="free" selected="@(target.Plan == "free")">Free</option><option value="premium" selected="@(target.Plan == "premium")">Premium</option></select>
                    <label class="c-label" for="assignment-reason-@target.Id">Reason</label><input class="c-input" id="assignment-reason-@target.Id" name="reason" maxlength="500" required /><button class="c-btn c-btn--secondary" type="submit">Assign plan</button></form>
            </article>
        }
    </section>
</section>
