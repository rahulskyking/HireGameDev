@model HireGameDev.Web.Controllers.PlanAdminPage
@{ ViewData["Title"] = "Application control panel"; }
<section class="p-sg-stack">
    <a asp-controller="Admin" asp-action="Index">← Admin console</a>
    <header><h1>Application control panel</h1><p>Development-only controls for the Free release. Administrative changes require an audit reason.</p></header>
    @if (TempData["PlanMessage"] is string message) { <p role="status">@message</p> }
    <section class="c-card"><h2>Free allowances <span class="c-badge c-badge--success">Active</span></h2>
        <p>Applications count successful submissions in a rolling 30 days, including withdrawals. Job slots count unexpired Active, Paused and Full jobs. Changing a limit does not delete existing jobs or applications; other safety controls still apply.</p>
        @foreach (var limit in Model.Limits)
        {
            var label = limit.Audience == "candidate" ? "Candidate applications per 30 days" : "Studio occupied job slots";
            <form asp-action="Limit" method="post" class="c-form">
                <input type="hidden" name="audience" value="@limit.Audience" /><input type="hidden" name="plan" value="free" />
                <label class="c-label" for="limit-@limit.Audience">@label</label><input class="c-input" id="limit-@limit.Audience" name="limit" type="number" min="1" max="10000" value="@limit.Limit" required />
                <label class="c-label" for="reason-@limit.Audience">Reason</label><input class="c-input" id="reason-@limit.Audience" name="reason" maxlength="500" required />
                <button class="c-btn c-btn--secondary" type="submit">Update @label</button>
            </form>
        }
    </section>
    <section class="c-card"><h2>Daily searches <span class="c-badge c-badge--warning">Draft · not enforced</span></h2>
        <p><strong>Search counting and enforcement are not implemented.</strong> You can save proposed limits here, but they do not restrict searches or track usage. Blank means no number has been chosen, not an active unlimited plan.</p>
        <p>The intended window is rolling 24 hours. New or changed searches should count; refreshing and paging the same search should not. Guest job browsing currently remains public.</p>
        @if (Model.SearchDraft is null) { <p role="alert">The saved draft is invalid. Enter valid values and a reason to replace it.</p> }
        <form asp-action="SearchDraft" method="post" class="c-form">
            <label class="c-label" for="candidateDaily">Candidate searches per 24 hours (proposed)</label><input class="c-input" id="candidateDaily" name="candidateDaily" type="number" min="1" max="10000" value="@(Model.SearchDraft?.CandidateDaily)" placeholder="Not set" />
            <label class="c-label" for="studioDaily">Studio searches per 24 hours (proposed)</label><input class="c-input" id="studioDaily" name="studioDaily" type="number" min="1" max="10000" value="@(Model.SearchDraft?.StudioDaily)" placeholder="Not set" />
            <label class="c-label" for="draftReason">Reason</label><input class="c-input" id="draftReason" name="reason" maxlength="500" required /><button class="c-btn c-btn--secondary" type="submit">Save search limit draft</button>
        </form>
    </section>
    <section class="c-card"><h2>Future plans <span class="c-badge c-badge--neutral">Not active</span></h2><p>Plus, Pro and Elite are reserved for a later release. No paid plan can be assigned or purchased, and paid placement is disabled. Existing stored assignments and schedules are retained but have no effect.</p></section>
    <section class="c-card"><h2>Other controls</h2><p>Recommendation thresholds and privacy reviews have separate controls; they do not override the Free allowances.</p><div class="c-btn-group"><a class="c-btn c-btn--secondary" asp-controller="AdminRecommendationPolicy" asp-action="Index">Recommendation settings</a><a class="c-btn c-btn--secondary" asp-controller="ErasureRequests" asp-action="Review">Review erasure requests</a></div></section>
</section>
