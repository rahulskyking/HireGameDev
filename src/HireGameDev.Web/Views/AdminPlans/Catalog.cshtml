@model IReadOnlyList<HireGameDev.Application.Abstractions.Plans.PlanCatalogItem>
@{
    ViewData["Title"] = "Plan settings";
    var savedTier = TempData["CatalogSavedTier"] as string;
    var savedMessage = TempData["CatalogMessage"] as string;
}
@section Styles { <link rel="stylesheet" href="~/css/plan-admin.css" asp-append-version="true" /> }
<div class="plans" id="top">
    <a class="plans-back" asp-action="Index">← Back to plans &amp; entitlements</a>
    <partial name="_PlansNavigation" />
    <header class="plans-header"><div><p class="plans-eyebrow">ADMINISTRATION <span>/</span> PLAN CONFIGURATION</p><h1>Configure the tiers<span>.</span></h1><p>Choose a tier, then open any setting to edit its value.</p></div><div class="plans-header-meta"><span class="plans-chip">DEVELOPMENT ONLY</span></div></header>
    <div id="catalog-feedback" class="plans-feedback">@if (TempData["CatalogError"] is string error) { <div class="plans-notice plans-notice--error" role="alert">@error <span> Your changes were not saved.</span></div> }</div>
    <aside class="plans-note"><strong>Understand what’s active</strong><span>Manual Studio tiers enforce searches, occupied jobs, postings and seats. Other Premium benefits are planned, not available. Free quotas apply when the global switch is on; some Free limits are managed on the main panel. Billing and automatic payment activation are not connected.</span></aside>
    <nav class="plans-tabs" aria-label="Jump to plan tier"><span>JUMP TO</span>@foreach (var tier in new[] { "free", "plus", "pro", "elite" }) { <a href="#@tier">@(char.ToUpperInvariant(tier[0]) + tier.Substring(1))</a> }</nav>
    @foreach (var tier in new[] { "free", "plus", "pro", "elite" })
    {
        <section class="plans-tier-section" id="@tier" aria-labelledby="heading-@tier">
            <div class="plans-section-head"><div><p class="plans-eyebrow">PLAN / @tier.ToUpperInvariant()</p><h2 id="heading-@tier">@(char.ToUpperInvariant(tier[0]) + tier.Substring(1))</h2><p>Candidate and Studio settings</p></div><a class="plans-text-link" href="#top">Back to top ↑</a></div>
            @if (savedTier == tier && savedMessage is not null) { <div class="plans-notice" role="status">✓ &nbsp;@savedMessage</div> }
            <div class="plans-two">
            @foreach (var audience in new[] { "candidate", "studio" })
            {
                <div class="plans-panel plans-feature-panel"><div class="plans-feature-heading"><div><p class="plans-eyebrow">@audience.ToUpperInvariant() PLAN</p><h3>@(audience == "candidate" ? "Candidate" : "Studio")</h3></div><span aria-hidden="true">↗</span></div>
                @foreach (var item in Model.Where(x => x.Plan == tier && x.Audience == audience))
                {
                    var isLive = tier == "free" ? ((audience == "studio" && (item.Feature == "postings" || item.Feature == "seats")) || (audience == "candidate" && item.Feature == "saved_jobs")) : audience == "studio" && (item.Feature == "postings" || item.Feature == "seats" || item.Feature == "active_jobs" || item.Feature == "searches");
                    var freeControl = tier == "free" && (item.Feature == "searches" || (audience == "candidate" && item.Feature == "applications") || (audience == "studio" && item.Feature == "active_jobs"));
                    var fieldId = $"{tier}-{audience}-{item.Feature}";
                    if (freeControl)
                    {
                        <div class="plans-setting plans-setting--linked"><div><strong>@item.Label</strong><small>MANAGED ON MAIN PANEL</small></div><a asp-action="Index" asp-fragment="free-limits">Manage →</a></div>
                    }
                    else
                    {
                        <details class="plans-setting"><summary><span><strong>@item.Label</strong><small>@(isLive ? (tier == "free" ? "APPLIES WHEN ON" : "MANUAL TIER QUOTA") : "PLANNED")</small></span><span class="plans-setting-value">@item.Value <span class="plans-chevron" aria-hidden="true">⌄</span></span></summary>
                            <form asp-action="CatalogValue" method="post" class="plans-form plans-setting-form"><input type="hidden" name="audience" value="@item.Audience" /><input type="hidden" name="plan" value="@item.Plan" /><input type="hidden" name="feature" value="@item.Feature" /><input type="hidden" name="version" value="@item.Version" />
                                <label for="@fieldId">Value</label>
                                @if (item.ValueType == "choice")
                                {
                                    <select id="@fieldId" name="value" class="c-select">@foreach (var choice in item.AllowedValues) { <option value="@choice" selected="@(choice == item.Value)">@choice</option> }</select>
                                }
                                else if (item.AllowsUnlimited)
                                {
                                    <input id="@fieldId" name="value" class="c-input" value="@item.Value" required maxlength="32" aria-describedby="@(fieldId)-help" /><small class="plans-hint" id="@(fieldId)-help">Enter a whole number from 0 to 10000, or unlimited.</small>
                                }
                                else
                                {
                                    <input id="@fieldId" name="value" type="number" min="0" max="10000" step="1" class="c-input" value="@item.Value" required /><small class="plans-hint">Enter a whole number from 0 to 10000.</small>
                                }
                                <label for="@(fieldId)-reason">Reason for change</label><input id="@(fieldId)-reason" name="reason" class="c-input" required maxlength="500" placeholder="Add a short reason" />
                                <button class="c-btn c-btn--secondary" type="submit">Save setting</button>
                            </form>
                        </details>
                    }
                }</div>
            }</div>
        </section>
    }
</div>
