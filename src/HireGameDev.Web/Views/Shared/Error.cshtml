@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="l-auth" aria-labelledby="error-heading">
    <div class="c-empty">
        <div class="c-empty__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
        </div>
        <h1 id="error-heading" class="c-empty__title">Something went wrong</h1>
        <p class="c-empty__desc">An unexpected error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="c-hint">Request ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="c-btn c-btn--primary">Return to home</a>
    </div>
</section>
