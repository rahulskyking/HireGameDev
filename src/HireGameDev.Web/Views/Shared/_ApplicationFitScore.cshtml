@model HireGameDev.Application.Features.Applications.ApplicationFitScore
<section class="match-card" aria-labelledby="fit-heading">
    <div class="match-head"><div><span class="match-label">PROFILE &amp; JOB</span><h2 id="fit-heading">Profile match</h2></div><div class="match-score">@if (Model.Percentage.HasValue) { <strong>@Model.Percentage%</strong><small>of assessed criteria</small> } else { <strong class="match-unavailable">Not enough information</strong> }</div></div>
    @if (Model.Percentage.HasValue) { <div class="match-progress" role="progressbar" aria-label="Profile match on assessed criteria" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.Percentage"><span style="width: @(Model.Percentage.Value)%"></span></div> }
    @{ var unknownRequired = Model.Criteria.Count(x => x.Label.StartsWith("Required: ", StringComparison.Ordinal) && !x.Fraction.HasValue); var belowRequired = Model.Criteria.Count(x => x.Label.StartsWith("Required: ", StringComparison.Ordinal) && x.Fraction == 0m); }
    @if (unknownRequired > 0 || belowRequired > 0) { <p class="match-attention">Required skills: @unknownRequired not listed · @belowRequired below requested level</p> }
    @if (!Model.Percentage.HasValue) { <p class="match-attention">There is no comparable information yet. Add relevant profile skills and check the job requirements.</p> }
    else if (Model.Coverage < 70) { <p class="match-attention">Limited data: only @Model.Coverage% of the applicable criteria were assessed. The score may change when more information is available.</p> }
    <p class="match-explainer">@Model.Coverage% of applicable criteria could be assessed. This compares self-reported profile data with the job—not a prediction of hiring or an automatic decision. Missing information is not a mismatch.</p>
    <details><summary class="match-summary">See how this is calculated</summary><div class="match-list">@foreach (var criterion in Model.Criteria) { <div class="match-row"><div><strong>@criterion.Label</strong><small>@criterion.Explanation</small></div><span class="match-result @(criterion.Fraction == 1m ? "match-result--met" : "")">@(criterion.Fraction is null ? "Unknown" : criterion.Fraction == 1m ? "Matches" : "Review")</span></div> }</div><p class="match-explainer">Weights: required skills 45%, preferred skills 15%, minimum experience 25%, work preferences 15%. Criteria the job does not specify are excluded. Unknown criteria are excluded from the score but reduce coverage. The score is based only on assessed criteria, even when coverage is low; it is not the percentage of all requirements met.</p></details>
</section>
