@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = isAuthenticated
        ? (User.FindFirst(HireGameDevClaimTypes.DisplayName)?.Value ?? User.Identity?.Name ?? "Account")
        : string.Empty;
    var accountType = isAuthenticated
        ? (User.FindFirst(HireGameDevClaimTypes.AccountType)?.Value ?? "candidate")
        : string.Empty;

    var rawTheme = isAuthenticated
        ? (User.FindFirst(HireGameDevClaimTypes.ThemePreference)?.Value
            ?? Context.Request.Cookies[HireGameDev.Web.Controllers.PreferencesController.ThemeCookieName]
            ?? "system")
        : (Context.Request.Cookies[HireGameDev.Web.Controllers.PreferencesController.ThemeCookieName] ?? "system");

    var activeTheme = rawTheme is "light" or "dark" ? rawTheme : "system";
    string? htmlDataTheme = activeTheme is "light" or "dark" ? activeTheme : null;
    var hasCandidateBottomNav = isAuthenticated && string.Equals(accountType, "candidate", StringComparison.OrdinalIgnoreCase);
    var hasCookieDecision = !string.IsNullOrWhiteSpace(
        Context.Request.Cookies[HireGameDev.Web.Controllers.PreferencesController.CookieConsentCookieName]);

    var currentPath = $"{Context.Request.Path}{Context.Request.QueryString}";
    var avatarInitial = !string.IsNullOrWhiteSpace(displayName)
        ? char.ToUpperInvariant(displayName.Trim()[0]).ToString()
        : "U";
    var fullTitle = ViewData["Title"] is string pageTitle && !string.IsNullOrWhiteSpace(pageTitle)
        ? $"{pageTitle} · HireGameDev"
        : "HireGameDev · Game Industry Hiring in India";
}
<!DOCTYPE html>
<html lang="en" data-theme="@htmlDataTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preload" href="~/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(hasCandidateBottomNav ? "has-bottom-nav" : null)">
    <a class="c-skip-link" href="#main-content">Skip to main content</a>

    <header class="c-navbar">
        <div class="l-container c-navbar__inner">
            <a class="c-brand" asp-controller="Home" asp-action="Index">
                <svg class="c-brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                    <rect width="32" height="32" rx="7" fill="#0b0b0c" />
                    <path d="M7.5 8.5h4.25v5.6h5.5V8.5h4.25v15h-4.25v-5.8h-5.5v5.8H7.5v-15z" fill="#f4f3ee" />
                    <polygon points="21.5,8.5 25.5,8.5 25.5,14.5 21.5,12.5" fill="#ffe600" />
                    <rect x="22.5" y="19.5" width="3" height="4" rx="0.8" fill="#ffe600" />
                </svg>
                <span>HireGameDev</span>
                <span class="c-brand__tag">IN</span>
            </a>

            <nav class="c-navbar__links" aria-label="Primary">
                <a class="c-nav-link"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-current="@(Context.Request.Path == "/" ? "page" : null)">Jobs</a>

                @if (isAuthenticated && accountType == "studio")
                {
                    <a class="c-nav-link" asp-controller="Home" asp-action="Index">Studio Workspace</a>
                }
                else if (isAuthenticated && accountType == "admin")
                {
                    <a class="c-nav-link" asp-controller="Home" asp-action="Index">Admin Console</a>
                }
                else
                {
                    <a class="c-nav-link" asp-controller="Account" asp-action="Register" asp-route-type="studio">For Studios</a>
                }

                @if (HostEnvironment.IsDevelopment())
                {
                    <a class="c-nav-link" href="/Dev/Styleguide">Styleguide</a>
                }
            </nav>

            <div class="c-navbar__actions">
                <form asp-controller="Preferences"
                      asp-action="Theme"
                      method="post"
                      class="c-theme-switch"
                      data-theme-form
                      role="group"
                      aria-label="Color theme">
                    <input type="hidden" name="returnUrl" value="@currentPath" />

                    <button type="submit"
                            name="theme"
                            value="system"
                            data-theme-value="system"
                            class="c-theme-switch__btn"
                            aria-pressed="@(activeTheme == "system" ? "true" : "false")"
                            title="System theme"
                            aria-label="System theme">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="3" width="20" height="14" rx="2" />
                            <line x1="8" y1="21" x2="16" y2="21" />
                            <line x1="12" y1="17" x2="12" y2="21" />
                        </svg>
                    </button>

                    <button type="submit"
                            name="theme"
                            value="light"
                            data-theme-value="light"
                            class="c-theme-switch__btn"
                            aria-pressed="@(activeTheme == "light" ? "true" : "false")"
                            title="Light theme"
                            aria-label="Light theme">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                        </svg>
                    </button>

                    <button type="submit"
                            name="theme"
                            value="dark"
                            data-theme-value="dark"
                            class="c-theme-switch__btn"
                            aria-pressed="@(activeTheme == "dark" ? "true" : "false")"
                            title="Dark theme"
                            aria-label="Dark theme">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                        </svg>
                    </button>
                </form>

                @if (isAuthenticated)
                {
                    <div class="c-user-pill" title="@displayName (@accountType)">
                        <span class="c-user-pill__avatar" aria-hidden="true">@avatarInitial</span>
                        <span class="c-user-pill__name">@displayName</span>
                        <span class="c-user-pill__role">@accountType</span>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="u-inline-form">
                        <button type="submit" class="c-shell-btn">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="c-shell-btn c-shell-btn--ghost" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="c-shell-btn c-shell-btn--primary" asp-controller="Account" asp-action="Register">Create account</a>
                }

                <button type="button"
                        class="c-icon-btn c-mobile-toggle"
                        data-mobile-menu-toggle
                        aria-expanded="false"
                        aria-controls="hgd-mobile-drawer"
                        aria-label="Toggle navigation menu">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <line x1="4" y1="7" x2="20" y2="7" />
                        <line x1="4" y1="12" x2="20" y2="12" />
                        <line x1="4" y1="17" x2="20" y2="17" />
                    </svg>
                </button>
            </div>
        </div>

        <div id="hgd-mobile-drawer" class="c-mobile-drawer">
            <div class="l-container">
                <nav class="c-mobile-drawer__nav" aria-label="Mobile navigation">
                    <a class="c-nav-link" asp-controller="Home" asp-action="Index">Jobs</a>
                    @if (!isAuthenticated)
                    {
                        <a class="c-nav-link" asp-controller="Account" asp-action="Register" asp-route-type="studio">For Studios</a>
                        <a class="c-nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="c-nav-link" asp-controller="Account" asp-action="Register">Create account</a>
                    }
                    else
                    {
                        <span class="c-nav-link">@displayName (@accountType)</span>
                    }

                    @if (HostEnvironment.IsDevelopment())
                    {
                        <a class="c-nav-link" href="/Dev/Styleguide">Styleguide (Dev)</a>
                    }
                </nav>
            </div>
        </div>
    </header>

    <main id="main-content" role="main" class="l-main">
        <div class="l-container">
            @RenderBody()
        </div>
    </main>

    <footer class="c-footer">
        <div class="l-container c-footer__grid">
            <div class="c-footer__meta">
                <strong>HireGameDev</strong> &middot; Evidence-backed hiring for game developers and studios in India.
            </div>
            <nav class="c-footer__links" aria-label="Legal">
                <a href="/Legal/Terms">Terms</a>
                <a href="/Legal/Privacy">Privacy</a>
                <a href="/Legal/Grievance">DPDP Grievance</a>
                <span>&copy; @DateTime.UtcNow.Year</span>
            </nav>
        </div>
    </footer>

    @if (hasCandidateBottomNav)
    {
        <nav class="c-bottom-nav" aria-label="Candidate quick navigation">
            <a class="c-bottom-nav__item"
               asp-controller="Home"
               asp-action="Index"
               aria-current="@(Context.Request.Path == "/" ? "page" : null)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="7" width="20" height="14" rx="2" />
                    <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                </svg>
                <span>Jobs</span>
            </a>

            <a class="c-bottom-nav__item" href="/Candidate/Applications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
                <span>Applications</span>
            </a>

            <a class="c-bottom-nav__item" href="/Candidate/Alerts">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <span>Alerts</span>
            </a>

            <a class="c-bottom-nav__item" href="/Account/Manage">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <span>Profile</span>
            </a>
        </nav>
    }

    @if (!hasCookieDecision)
    {
        <aside id="hgd-cookie-banner" class="c-cookie-banner" role="region" aria-label="Cookie notice">
            <form asp-controller="Preferences"
                  asp-action="Cookies"
                  method="post"
                  class="c-cookie-banner__inner"
                  data-cookie-form>
                <input type="hidden" name="returnUrl" value="@currentPath" />
                <p class="c-cookie-banner__text">
                    We use strictly necessary cookies for secure sign-in, CSRF protection, and your theme preference. No third-party ad trackers are loaded.
                </p>
                <div class="c-cookie-banner__actions">
                    <button type="submit"
                            name="choice"
                            value="essential"
                            data-cookie-choice="essential"
                            class="c-shell-btn">
                        Essential only
                    </button>
                    <button type="submit"
                            name="choice"
                            value="accepted"
                            data-cookie-choice="accepted"
                            class="c-shell-btn c-shell-btn--primary">
                        Accept
                    </button>
                </div>
            </form>
        </aside>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
