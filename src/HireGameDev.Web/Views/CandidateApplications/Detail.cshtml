@using HireGameDev.Application.Abstractions.Applications
@model CandidateApplicationDetail
@{ ViewData["Title"] = "Application timeline"; }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<div class="ap">
    <a class="ap-back" asp-action="Index">← My applications</a>
    <header class="ap-detail-hero"><div><span class="ap-hero-kicker">● &nbsp; YOUR APPLICATION</span><h1>@Model.JobTitle</h1><p>@Model.StudioName</p></div><span class="ap-status" data-status="@Model.Status">@Model.Status</span></header>
    @if (TempData["ApplicationMessage"] is string message) { <p class="ap-note" role="status">@message</p> }
    <div class="ap-detail-layout"><div class="ap-detail-main">
    @if (Model.UsesCurrentJobRequirements) { <p class="ap-note">Compared with current job requirements; these may have changed since you applied.</p> }
    @if (Model.FitScore is not null) { <partial name="_ApplicationFitScore" model="Model.FitScore" /> }
    @if (Model.FitScore is null && Model.SkillMatch is not null) { <p class="ap-note">A profile percentage is unavailable for this older application. Its required-skills comparison is shown below.</p><partial name="_ApplicationSkillMatch" model="Model.SkillMatch" /> }
    else if (Model.FitScore is null && Model.Status != ApplicationStatus.Withdrawn) { <section class="ap-card"><h2>Profile match unavailable</h2><p>A score cannot be calculated from the available application and job data.</p></section> }
    <section class="ap-card"><span class="ap-label">Current status</span><h2>@Model.Status</h2><p>@HireGameDev.Web.Models.Applications.ApplicationStatusUi.Description(Model.Status)</p></section>
    <section class="ap-card" aria-labelledby="timeline-heading"><div class="ap-section-head"><div><h2 id="timeline-heading">Application timeline</h2><p class="ap-muted">Updates are shown most recent first, in UTC.</p></div></div>
        <ol class="ap-timeline">@foreach (var item in Model.Events) { <li><strong>@item.NewStatus</strong><time datetime="@item.OccurredAt.ToString("O")">@item.OccurredAt.ToUniversalTime().ToString("dd MMM yyyy, HH:mm") UTC</time></li> }</ol>
        @if (Model.HasEarlierEvents) { <p class="ap-muted">Only the 50 most recent status changes are shown.</p> }
    </section>
    <section class="ap-card"><h2>Your submitted information</h2>
        @if (Model.SubmittedSnapshot is not null) {
            <p>This is the saved snapshot from when you applied, not your current profile. Your phone is shown here for you; the Studio can only see it when shortlisted or hired.</p>
            @if (Model.Status == ApplicationStatus.Withdrawn) { <p>The Studio cannot access this snapshot because you withdrew. It is still stored until it is deleted.</p> }
            <details class="ap-submitted"><summary>View your submitted snapshot</summary><partial name="_ApplicationSnapshot" model="Model.SubmittedSnapshot" /></details>
        } else if (Model.SnapshotPurged) { <p>Your submitted snapshot has been removed. Your application status history remains.</p> }
        else { <p>The submitted snapshot is unavailable. <a href="/Legal/Grievance">Contact us</a> if you have questions about your data.</p> }
    </section>
    </div><aside class="ap-detail-aside" aria-label="Application actions">
    @if (ApplicationLifecycleRules.CanCandidateWithdraw(Model.Status)) { <section class="ap-card ap-card--subtle"><h2>Need to withdraw?</h2><p>You can withdraw your application if you no longer wish to be considered.</p><a class="c-btn c-btn--secondary" asp-action="ConfirmWithdrawal" asp-route-applicationId="@Model.ApplicationId">Withdraw application</a></section> }
    <section class="ap-card ap-card--subtle"><h2>Privacy &amp; data</h2><p>Withdrawing removes Studio access but does not automatically delete stored data. Account erasure and automatic snapshot deletion are not yet available.</p><a href="/Legal/Grievance">Contact us about your data →</a></section>
    </aside></div>
    <p class="ap-muted ap-footnote">Job and Studio names reflect their current values.</p>
</div>
