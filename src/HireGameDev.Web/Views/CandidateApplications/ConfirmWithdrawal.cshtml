@model Guid
@{ ViewData["Title"] = "Withdraw application"; }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<div class="ap"><a class="ap-back" asp-action="Detail" asp-route-applicationId="@Model">← Back to application</a><span class="ap-label">Application details</span><h1>Withdraw application?</h1>
<section class="ap-card"><p>The Studio will no longer be able to view your submitted snapshot. You cannot apply to the same job again. The stored snapshot and application record are not automatically deleted when you withdraw.</p>
<p>For questions about your data, see the <a href="/Legal/Grievance">privacy contact</a>.</p>
<form asp-action="Withdraw" asp-route-applicationId="@Model" method="post"><div class="ap-actions"><button class="c-btn c-btn--primary" type="submit">Confirm withdrawal</button><a asp-action="Detail" asp-route-applicationId="@Model">Keep application</a></div></form></section></div>
