@model Guid
@{ ViewData["Title"] = "Delete submitted snapshot"; }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<div class="ap"><a class="ap-back" asp-action="Detail" asp-route-applicationId="@Model">← Back to application</a><span class="ap-label">Your application data</span><h1>Delete your submitted snapshot?</h1>
<section class="ap-card"><p>This permanently deletes the saved application snapshot, including the submitted profile, screening answer and saved phone number. It cannot be undone.</p><p>Your application record, consent receipt, status history and audit record remain linked to your account. You still cannot apply to this job again. This does not delete your account, live profile, copies already downloaded by a Studio or data in backups.</p><form asp-action="DeleteSnapshot" asp-route-applicationId="@Model" method="post"><label class="ap-check"><input type="checkbox" name="confirmed" value="true" required /> I understand what will be deleted and what remains.</label><div class="ap-actions"><button class="c-btn c-btn--primary" type="submit">Delete snapshot permanently</button><a asp-action="Detail" asp-route-applicationId="@Model">Keep snapshot</a></div></form></section></div>
