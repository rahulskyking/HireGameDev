@model HireGameDev.Web.Models.Applications.ApplicationReviewPage
@{ ViewData["Title"] = "Review your application"; var usage = ViewData["ApplicationUsage"] as HireGameDev.Application.Abstractions.Plans.CandidateApplicationUsage; }
@section Styles { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
<div class="ap"><header class="ap-detail-hero"><div><span class="ap-hero-kicker">● &nbsp; REVIEW &amp; SUBMIT</span><h1>Review before applying</h1><p>Check what you’re sharing before sending your application.</p></div><span class="ap-hero-step">01 / REVIEW</span></header>
<p class="ap-muted">This is the snapshot the Studio can see. Phone is available only after shortlist or hire. Check your text and links for sensitive or confidential information.</p>
@{ var fit = HireGameDev.Application.Features.Applications.ApplicationFitScore.Create(Model.Offer.Snapshot.Candidate, Model.Offer.Snapshot.Job); }
@if (fit is not null) { <partial name="_ApplicationFitScore" model="fit" /> }
@{ var match = HireGameDev.Application.Features.Applications.ApplicationSkillMatch.Create(Model.Offer.Snapshot.Candidate, Model.Offer.Snapshot.Job); }
@if (fit is null && match is not null) { <partial name="_ApplicationSkillMatch" model="match" /> }
<details class="ap-review-details" open><summary>Review the information you will share</summary><partial name="_ApplicationSnapshot" model="Model.Offer.Snapshot" /></details>
@if (usage is not null) { <p class="ap-note">@usage.Used / @usage.Limit applications used in the last @usage.WindowDays days. This is checked again when you submit.@if (usage.NextAvailableAt.HasValue) { <span> Next available: @usage.NextAvailableAt.Value.ToUniversalTime().ToString("dd MMM yyyy, HH:mm") UTC.</span> }</p> }
<section class="ap-card"><h2>Consent</h2><p>@Model.Offer.ConsentText</p><p>Review expires at @Model.Offer.ExpiresAt.ToString("u"). If your profile or the job changes, you will need to review again.</p>
<form asp-action="Submit" asp-route-jobId="@Model.JobId" method="post">
<input type="hidden" name="jobSlug" value="@Model.JobSlug" /><input type="hidden" name="reviewToken" value="@Model.Offer.ReviewToken" />
@if (Model.ScreeningAnswer is not null) { <input type="hidden" name="encodedAnswer" value="@Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(Model.ScreeningAnswer))" /> }
<label><input type="checkbox" name="consent" value="true" required /> I agree to share the reviewed information.</label>
<div class="ap-actions"><button class="c-btn c-btn--primary" type="submit">Submit application</button><a asp-action="Index">Cancel</a></div></form></section></div>
