@model CompleteExternalRegistrationViewModel
@{
    ViewData["Title"] = "Complete your account";
    var isStudio = Model.AccountType == AccountType.Studio;
}

<section class="l-auth l-auth--wide" aria-labelledby="complete-account-heading">
    <div class="c-auth-card">
        <header class="c-auth-card__header">
            <span class="c-auth-card__eyebrow">Connected Account</span>
            <h1 id="complete-account-heading" class="c-auth-card__title">Complete your HireGameDev account</h1>
            <p class="c-auth-card__subtitle">
                Connected with <strong>@Model.ProviderDisplayName</strong> as <strong>@Model.Email</strong>.
                Confirm your details and consent to finish signing up.
            </p>
        </header>

        <form asp-controller="Account" asp-action="CompleteExternalRegistration" method="post" class="c-form" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

            @if (Model.IsPortalRoleLocked)
            {
                <input type="hidden" asp-for="AccountType" />
                <div class="c-alert c-alert--neutral">
                    <div class="c-alert__content">
                        <span class="c-alert__title">
                            @(isStudio ? "Activating Studio Hiring Workspace" : "Activating Game Developer (Candidate) Profile")
                        </span>
                        <p>
                            This email will belong only to this account type. Candidate and Studio accounts require different email addresses.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <fieldset class="c-fieldset">
                    <legend class="c-fieldset__legend">1. I am joining as a</legend>
                    <div class="c-role-grid">
                        <label class="c-role-card @(Model.AccountType == AccountType.Candidate ? "is-selected" : null)">
                            <input type="radio" asp-for="AccountType" value="@AccountType.Candidate" data-account-type-radio />
                            <span class="c-role-card__body">
                                <span class="c-role-card__title">Game Developer</span>
                                <span class="c-role-card__desc">Find verified game studio roles across India.</span>
                            </span>
                        </label>

                        @if (Model.AllowedForStudios)
                        {
                            <label class="c-role-card @(Model.AccountType == AccountType.Studio ? "is-selected" : null)">
                                <input type="radio" asp-for="AccountType" value="@AccountType.Studio" data-account-type-radio />
                                <span class="c-role-card__body">
                                    <span class="c-role-card__title">Game Studio</span>
                                    <span class="c-role-card__desc">Build your studio profile and hire game talent.</span>
                                </span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="AccountType"></span>
                </fieldset>
            }

            <div class="c-field">
                <label asp-for="DisplayName" class="c-label"></label>
                <input asp-for="DisplayName" class="c-input" autocomplete="name" />
                <span asp-validation-for="DisplayName"></span>
            </div>

            <div class="c-field">
                <label class="c-check">
                    <input asp-for="ConfirmAge18Plus" />
                    <span>@Html.DisplayNameFor(m => m.ConfirmAge18Plus)</span>
                </label>
                <span asp-validation-for="ConfirmAge18Plus"></span>
            </div>

            <div class="c-field">
                <label class="c-check">
                    <input asp-for="AcceptTermsAndPrivacy" />
                    <span>I agree to the <a href="/Legal/Terms">Terms of Use</a> and <a href="/Legal/Privacy">Privacy Notice</a>.</span>
                </label>
                <span asp-validation-for="AcceptTermsAndPrivacy"></span>
            </div>

            <button type="submit" class="c-btn c-btn--primary c-btn--lg c-btn--block">Finish creating account</button>
        </form>

        <footer class="c-auth-card__footer">
            <span>Changed your mind?</span>
            <a asp-controller="Account" asp-action="Login">Cancel and return to sign in</a>
        </footer>
    </div>
</section>
