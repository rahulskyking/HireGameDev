@model ResetPasswordViewModel
@{
    var isSetMode = string.Equals(Model.Mode, "set", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isSetMode ? "Set password" : "Reset password";
}

<section class="l-auth" aria-labelledby="reset-heading">
    <div class="c-auth-card">
        <header class="c-auth-card__header">
            <span class="c-auth-card__eyebrow">@(isSetMode ? "Set Password" : "Password Update")</span>
            <h1 id="reset-heading" class="c-auth-card__title">@(isSetMode ? "Set a password for your account" : "Choose a new password")</h1>
            <p class="c-auth-card__subtitle">Use at least 10 characters including uppercase, lowercase, and a number.</p>
        </header>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="c-form" novalidate>
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="Mode" />

            <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

            <div class="c-field">
                <label asp-for="Email" class="c-label"></label>
                <input asp-for="Email" class="c-input" type="email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="c-field">
                <label asp-for="NewPassword" class="c-label">@(isSetMode ? "Password" : "New password")</label>
                <input asp-for="NewPassword" class="c-input" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>

            <div class="c-field">
                <label asp-for="ConfirmPassword" class="c-label"></label>
                <input asp-for="ConfirmPassword" class="c-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="c-btn c-btn--primary c-btn--lg c-btn--block">
                @(isSetMode ? "Save password" : "Update password")
            </button>
        </form>

        <footer class="c-auth-card__footer">
            <span>Need another link?</span>
            <a asp-controller="Account" asp-action="ForgotPassword">Request a fresh password link</a>
        </footer>
    </div>
</section>
