@model ResetPasswordViewModel
@{
    var isSetMode = string.Equals(Model.Mode, "set", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isSetMode ? "Set password" : "Reset password";
}

<section aria-labelledby="reset-heading">
    <h1 id="reset-heading">@(isSetMode ? "Set a password for your account" : "Choose a new password")</h1>

    <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
        <input type="hidden" asp-for="Code" />
        <input type="hidden" asp-for="Mode" />

        <div asp-validation-summary="ModelOnly" role="alert"></div>

        <div>
            <label asp-for="Email"></label><br />
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email"></span>
        </div>

        <div>
            <label asp-for="NewPassword">@(isSetMode ? "Password" : "New password")</label><br />
            <input asp-for="NewPassword" autocomplete="new-password" />
            <small>At least 10 characters with uppercase, lowercase, and a number.</small>
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword"></label><br />
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <div>
            <button type="submit">@(isSetMode ? "Save password" : "Update password")</button>
        </div>
    </form>
</section>
