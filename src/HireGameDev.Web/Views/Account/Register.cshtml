@model RegisterViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Create account";
}

<section class="l-auth l-auth--wide" aria-labelledby="register-heading">
    <div class="c-auth-card">
        <header class="c-auth-card__header">
            <span class="c-auth-card__eyebrow">Get Started</span>
            <h1 id="register-heading" class="c-auth-card__title">Create your HireGameDev account</h1>
            <p class="c-auth-card__subtitle">Choose whether you are joining as a Game Developer or a Game Studio first.</p>
        </header>

        <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

        @if (Model.ExternalProviders.Count > 0)
        {
            <form asp-controller="Account" asp-action="ExternalLogin" method="post" id="external-register-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="preferredAccountType" id="external-preferred-account-type" value="@Model.AccountType" />
            </form>
        }

        <form asp-controller="Account" asp-action="Register" method="post" id="email-register-form" class="c-form" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <fieldset class="c-fieldset">
                <legend class="c-fieldset__legend">1. I am joining as a</legend>
                <div class="c-role-grid">
                    <label class="c-role-card @(Model.AccountType == AccountType.Candidate ? "is-selected" : null)">
                        <input type="radio" asp-for="AccountType" value="@AccountType.Candidate" data-account-type-radio />
                        <span class="c-role-card__body">
                            <span class="c-role-card__title">Game Developer</span>
                            <span class="c-role-card__desc">Candidate profile, playable builds, and verified roles across India.</span>
                        </span>
                    </label>

                    <label class="c-role-card @(Model.AccountType == AccountType.Studio ? "is-selected" : null)">
                        <input type="radio" asp-for="AccountType" value="@AccountType.Studio" data-account-type-radio />
                        <span class="c-role-card__body">
                            <span class="c-role-card__title">Game Studio</span>
                            <span class="c-role-card__desc">Studio page, domain or indie verification, and structured hiring.</span>
                        </span>
                    </label>
                </div>
                <span asp-validation-for="AccountType"></span>
                <p class="c-hint">
                    Studios can register with any valid email (company domain, Gmail, or Outlook). Company-domain studios follow standard verification; personal-email indie studios can submit for manual admin review.
                </p>
            </fieldset>

            @if (Model.ExternalProviders.Count > 0)
            {
                <section class="c-field" aria-label="Quick social sign-up">
                    <span class="c-label">2. Quick sign-up with a connected account</span>
                    <div class="c-sso-grid">
                        @foreach (var provider in Model.ExternalProviders)
                        {
                            var disabledForSelectedRole = Model.AccountType == AccountType.Studio && !provider.AllowedForStudios;
                            <button type="submit"
                                    form="external-register-form"
                                    name="provider"
                                    value="@provider.Scheme"
                                    class="c-btn c-btn--secondary c-btn--block"
                                    data-allowed-for-studios="@provider.AllowedForStudios.ToString().ToLowerInvariant()"
                                    disabled="@(disabledForSelectedRole ? "disabled" : null)">
                                Sign up with @provider.DisplayName@(provider.AllowedForStudios ? string.Empty : " (Candidates only)")
                            </button>
                        }
                    </div>
                    <p class="c-hint">First-time social sign-up confirms your role and DPDP consent on the next step.</p>
                </section>

                <div class="c-divider" role="separator">Or register with email</div>
            }
            else if (HostEnvironment.IsDevelopment())
            {
                <aside class="c-alert c-alert--info" aria-label="Local OAuth setup note">
                    <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="8" /><line x1="10" y1="9" x2="10" y2="14" /><circle cx="10" cy="6.2" r="0.8" fill="currentColor" /></svg>
                    <div class="c-alert__content">
                        <span class="c-alert__title">Local Development Note</span>
                        <p>
                            Add <code>Authentication:Google</code> and/or <code>Authentication:GitHub</code> in
                            <code>appsettings.Development.local.json</code> to enable Google (all users) and GitHub (Candidates) sign-up.
                        </p>
                    </div>
                </aside>
            }

            <div class="c-field">
                <label asp-for="DisplayName" class="c-label"></label>
                <input asp-for="DisplayName" class="c-input" autocomplete="name" placeholder="e.g. Aarav Sharma or Nila Verse Studio" />
                <span asp-validation-for="DisplayName"></span>
            </div>

            <div class="c-field">
                <label asp-for="Email" class="c-label"></label>
                <input asp-for="Email" class="c-input" type="email" autocomplete="email" placeholder="you@example.com" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="c-field">
                <label asp-for="Password" class="c-label"></label>
                <input asp-for="Password" class="c-input" autocomplete="new-password" />
                <p class="c-hint">At least 10 characters with uppercase, lowercase, and a number.</p>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="c-field">
                <label asp-for="ConfirmPassword" class="c-label"></label>
                <input asp-for="ConfirmPassword" class="c-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="c-field">
                <label class="c-check">
                    <input asp-for="ConfirmAge18Plus" />
                    <span>@Html.DisplayNameFor(m => m.ConfirmAge18Plus)</span>
                </label>
                <span asp-validation-for="ConfirmAge18Plus"></span>
            </div>

            <div class="c-field">
                <label class="c-check">
                    <input asp-for="AcceptTermsAndPrivacy" />
                    <span>I agree to the <a href="/Legal/Terms">Terms of Use</a> and <a href="/Legal/Privacy">Privacy Notice</a>.</span>
                </label>
                <span asp-validation-for="AcceptTermsAndPrivacy"></span>
            </div>

            <button type="submit" class="c-btn c-btn--primary c-btn--lg c-btn--block">Create account</button>
        </form>

        <footer class="c-auth-card__footer">
            <span>Already have an account?</span>
            <a asp-controller="Account" asp-action="Login">Sign in</a>
        </footer>
    </div>
</section>
