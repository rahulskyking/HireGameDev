@model EnableRoleViewModel
@{ ViewData["Title"] = "Separate accounts required"; }
<section class="l-auth">
    <div class="c-auth-card">
        <h1>Candidate and Studio accounts are separate</h1>
        <p>Each email belongs to one account type. To use the other type, sign out and register with a different email.</p>
        <a asp-controller="Account" asp-action="Manage">Back to account settings</a>
    </div>
</section>
