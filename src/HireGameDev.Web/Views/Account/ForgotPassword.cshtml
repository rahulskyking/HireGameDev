@model ForgotPasswordViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Reset or set password";
}

<section aria-labelledby="forgot-heading">
    <h1 id="forgot-heading">Reset or set your password</h1>

    @if (Model.LinkSent)
    {
        <div role="status">
            <p>
                If a confirmed account matches <strong>@Model.Email</strong>, we have emailed a secure link to set or reset your password.
            </p>
        </div>

        @if (HostEnvironment.IsDevelopment())
        {
            <p>
                <small>
                    <strong>Local Development Note:</strong> Check <code>src/HireGameDev.Web/logs/emails/</code> for the generated HTML email preview.
                </small>
            </p>
        }

        <p><a asp-controller="Account" asp-action="Login">Return to sign in</a></p>
    }
    else
    {
        <p>Enter your account email address. Works both if you forgot your password or if you signed up with Google/GitHub and want to add a password.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <div>
                <label asp-for="Email"></label><br />
                <input asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div>
                <button type="submit">Send password link</button>
            </div>
        </form>

        <p><a asp-controller="Account" asp-action="Login">Back to sign in</a></p>
    }
</section>
