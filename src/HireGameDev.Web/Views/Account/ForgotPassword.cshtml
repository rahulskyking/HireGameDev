@model ForgotPasswordViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Reset or set password";
}

<section class="l-auth" aria-labelledby="forgot-heading">
    <div class="c-auth-card">
        <header class="c-auth-card__header">
            <span class="c-auth-card__eyebrow">Account Recovery</span>
            <h1 id="forgot-heading" class="c-auth-card__title">Reset or set your password</h1>
            @if (!Model.LinkSent)
            {
                <p class="c-auth-card__subtitle">
                    Enter your account email. Works both if you forgot your password or if you signed up with Google/GitHub and want to add a password.
                </p>
            }
        </header>

        @if (Model.LinkSent)
        {
            <div class="c-alert c-alert--success" role="status">
                <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 10.5 8 14.5 16 6.5" /></svg>
                <div class="c-alert__content">
                    <span class="c-alert__title">Check your inbox</span>
                    <p>
                        If a confirmed account matches <strong>@Model.Email</strong>, we have emailed a secure link to set or reset your password.
                    </p>
                </div>
            </div>

            @if (HostEnvironment.IsDevelopment())
            {
                <aside class="c-alert c-alert--info" aria-label="Local email preview note">
                    <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="8" /><line x1="10" y1="9" x2="10" y2="14" /><circle cx="10" cy="6.2" r="0.8" fill="currentColor" /></svg>
                    <div class="c-alert__content">
                        <span class="c-alert__title">Local Development Note</span>
                        <p>Check <code>src/HireGameDev.Web/logs/emails/</code> for the generated HTML email preview.</p>
                    </div>
                </aside>
            }

            <a asp-controller="Account" asp-action="Login" class="c-btn c-btn--primary c-btn--block">Return to sign in</a>
        }
        else
        {
            <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="c-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

                <div class="c-field">
                    <label asp-for="Email" class="c-label"></label>
                    <input asp-for="Email" class="c-input" type="email" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email"></span>
                </div>

                <button type="submit" class="c-btn c-btn--primary c-btn--lg c-btn--block">Send password link</button>
            </form>

            <footer class="c-auth-card__footer">
                <span>Remembered your password?</span>
                <a asp-controller="Account" asp-action="Login">Back to sign in</a>
            </footer>
        }
    </div>
</section>
