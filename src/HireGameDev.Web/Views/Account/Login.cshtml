@model LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var eyebrow = Model.Portal switch
    {
        PortalSite.Studio => "Studio Hiring Workspace",
        PortalSite.Jobs => "Candidate Portal",
        _ => "HireGameDev Account"
    };

    var heading = Model.Portal switch
    {
        PortalSite.Studio => "Sign in to your Studio workspace",
        PortalSite.Jobs => "Sign in to browse & apply",
        _ => "Sign in to HireGameDev"
    };

    var subtitle = Model.Portal switch
    {
        PortalSite.Studio => "Manage your studio profile, verification status, job listings, and applicant pipeline.",
        PortalSite.Jobs => "Access your developer profile, shipped credits, applications, and job alerts.",
        _ => "One verified identity works across Candidate, Studio, and Admin workspaces."
    };

    ViewData["Title"] = heading;
}

<section class="l-auth" aria-labelledby="login-heading">
    <div class="c-auth-card">
        <header class="c-auth-card__header">
            <span class="c-auth-card__eyebrow">@eyebrow</span>
            <h1 id="login-heading" class="c-auth-card__title">@heading</h1>
            <p class="c-auth-card__subtitle">@subtitle</p>
        </header>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="c-alert c-alert--success" role="status">
                <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 10.5 8 14.5 16 6.5" /></svg>
                <div class="c-alert__content">
                    <p>@statusMessage</p>
                </div>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="c-alert c-alert--danger" role="alert"></div>

        @if (Model.ExternalProviders.Count > 0)
        {
            <section aria-label="Social sign-in">
                <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="c-sso-grid">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    @foreach (var provider in Model.ExternalProviders)
                    {
                        <button type="submit"
                                name="provider"
                                value="@provider.Scheme"
                                class="c-btn c-btn--secondary c-btn--block">
                            Continue with @provider.DisplayName@(Model.Portal == PortalSite.Landing && !provider.AllowedForStudios ? " (Candidates)" : string.Empty)
                        </button>
                    }
                </form>
            </section>

            <div class="c-divider" role="separator">Or with email</div>
        }
        else if (HostEnvironment.IsDevelopment())
        {
            <aside class="c-alert c-alert--info" aria-label="Local OAuth setup note">
                <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="8" /><line x1="10" y1="9" x2="10" y2="14" /><circle cx="10" cy="6.2" r="0.8" fill="currentColor" /></svg>
                <div class="c-alert__content">
                    <span class="c-alert__title">Local Development Note</span>
                    <p>
                        Add <code>Authentication:Google</code> and/or <code>Authentication:GitHub</code> in
                        <code>appsettings.Development.local.json</code> to enable social sign-in.
                    </p>
                </div>
            </aside>
        }

        <form asp-controller="Account" asp-action="Login" method="post" class="c-form" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="c-field">
                <label asp-for="Email" class="c-label"></label>
                <input asp-for="Email" class="c-input" type="email" autocomplete="email" placeholder="you@studio.in" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="c-field">
                <div class="c-field__label-row">
                    <label asp-for="Password" class="c-label"></label>
                    <a asp-controller="Account" asp-action="ForgotPassword" style="font-size: 13px;">Forgot or set password?</a>
                </div>
                <input asp-for="Password" class="c-input" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <label class="c-check">
                <input asp-for="RememberMe" />
                <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
            </label>

            <button type="submit" class="c-btn c-btn--primary c-btn--lg c-btn--block">Sign in</button>
        </form>

        @if (Model.ShowResendConfirmation && !string.IsNullOrWhiteSpace(Model.Email))
        {
            <section class="c-alert c-alert--warning" aria-label="Resend email confirmation">
                <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="8" /><line x1="10" y1="6" x2="10" y2="11" /><circle cx="10" cy="14" r="0.8" fill="currentColor" /></svg>
                <div class="c-alert__content">
                    <span class="c-alert__title">Email confirmation required</span>
                    <p>Need a fresh link for <strong>@Model.Email</strong>?</p>
                    <form asp-controller="Account" asp-action="ResendConfirmation" method="post" style="margin-top: 8px;">
                        <input type="hidden" name="email" value="@Model.Email" />
                        <button type="submit" class="c-btn c-btn--secondary c-btn--sm">Resend confirmation email</button>
                    </form>
                </div>
            </section>
        }

        @if (Model.ShowSetPasswordPrompt && !string.IsNullOrWhiteSpace(Model.Email))
        {
            <section class="c-alert c-alert--info" aria-label="Set a password for email sign-in">
                <svg class="c-alert__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="8" /><line x1="10" y1="9" x2="10" y2="14" /><circle cx="10" cy="6.2" r="0.8" fill="currentColor" /></svg>
                <div class="c-alert__content">
                    <span class="c-alert__title">Add email &amp; password sign-in</span>
                    <p>Want to sign in with a password in addition to your connected account?</p>
                    <form asp-controller="Account" asp-action="ForgotPassword" method="post" style="margin-top: 8px;">
                        <input type="hidden" name="Email" value="@Model.Email" />
                        <button type="submit" class="c-btn c-btn--secondary c-btn--sm">Email me a Set-Password link</button>
                    </form>
                </div>
            </section>
        }

        <footer class="c-auth-card__footer">
            <span>New here? <a href="@Model.RegisterUrl">Create an account</a></span>
            @if (Model.Portal == PortalSite.Jobs)
            {
                <a href="@Model.AlternatePortalLoginUrl">Studio sign in &rarr;</a>
            }
            else if (Model.Portal == PortalSite.Studio)
            {
                <a href="@Model.AlternatePortalLoginUrl">Candidate sign in &rarr;</a>
            }
        </footer>
    </div>
</section>
