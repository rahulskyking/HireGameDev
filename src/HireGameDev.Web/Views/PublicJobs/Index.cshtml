@using HireGameDev.Web.Models.Jobs
@using HireGameDev.Application.Features.Jobs
@model PublicJobBrowsePage
@{
    ViewData["Title"] = "Game development jobs in India";
    var results = Model.Results;
    var filtered = PublicJobUi.HasFilters(Model.Search) || (results?.Page ?? 1) > 1 || User.Identity?.IsAuthenticated == true;
}
@section Styles {
    <meta name="description" content="Explore game development jobs from verified Studios. Find roles in programming, art, design, audio, QA and production with transparent salary ranges." />
    <link rel="canonical" href="@Model.CanonicalUrl" />
    @if (filtered || results is null) { <meta name="robots" content="noindex, follow" /> }
    <link rel="stylesheet" href="~/css/public-jobs.css" asp-append-version="true" />
}
<div class="jb">
<header class="jb-hero"><div><span class="jb-eyebrow">Built for the people who build games</span><h1>Your next role.<br /><span>Your kind of industry.</span></h1><p>Discover game development opportunities from verified Studios. Real roles. Transparent pay. No signup to explore.</p></div><div class="jb-hero-mark" aria-hidden="true">PLAY.<br />BUILD.<br /><span>BELONG.</span></div></header>
@if (User.Identity?.IsAuthenticated == true && User.FindFirst(HireGameDevClaimTypes.AccountType)?.Value == HireGameDevRoleNames.Candidate)
{ <p class="jb-muted">Your blocked Studios are excluded while signed in. <a asp-controller="Candidate" asp-action="Settings">Manage your preferences</a>. Public browsing stays open when signed out.</p> }
<div class="jb-layout">
<details class="jb-filters" open id="job-filters"><summary>Search &amp; filters <span>⌄</span></summary>
<form asp-controller="PublicJobs" asp-action="Index" method="get" class="jb-filter-form" role="search" aria-label="Find game development jobs">
@if (Model.Search.StudioId.HasValue) { <input type="hidden" name="StudioId" value="@Model.Search.StudioId" /> <div class="jb-note"><strong>Showing jobs from one Studio</strong><p>Other filters apply to this Studio’s open roles.</p><a href="@(PublicJobUi.PageUrl(Model.Search with { StudioId = null }, 1))">Browse all Studios</a></div> }
<div class="jb-field"><label for="Keyword">Search jobs</label><input class="c-input" id="Keyword" name="Keyword" value="@Model.Search.Keyword" maxlength="100" placeholder="Role, Studio or skill" aria-describedby="keyword-help" /><small id="keyword-help">Search title, description, Studio name or listed skills.</small></div>
<div class="jb-field"><label for="Category">Discipline</label><select class="c-select" id="Category" name="Category"><option value="">All disciplines</option>@foreach (var value in Enum.GetValues<DisciplineCategory>()) { <option value="@value" selected="@(Model.Search.Category == value)">@value</option> }</select></div>
<div class="jb-field"><label for="JobType">Employment type</label><select class="c-select" id="JobType" name="JobType"><option value="">All types</option>@foreach (var value in Enum.GetValues<JobType>()) { <option value="@value" selected="@(Model.Search.JobType == value)">@PublicJobUi.Type(value)</option> }</select></div>
<div class="jb-field"><label for="WorkMode">Work arrangement</label><select class="c-select" id="WorkMode" name="WorkMode"><option value="">Any arrangement</option>@foreach (var value in Enum.GetValues<JobWorkMode>()) { <option value="@value" selected="@(Model.Search.WorkMode == value)">@value</option> }</select></div>
<div class="jb-field"><label for="CityId">Office city</label><select class="c-select" id="CityId" name="CityId"><option value="">All cities</option>@if (Model.Search.CityId.HasValue && Model.Search.CityId > 0 && !Model.Cities.Any(x => x.Id == Model.Search.CityId)) { <option value="@Model.Search.CityId" selected>Unavailable city (ID @Model.Search.CityId)</option> }@foreach (var city in Model.Cities) { <option value="@city.Id" selected="@(Model.Search.CityId == city.Id)">@city.Name, @city.StateCode</option> }</select><small>For Remote jobs, leave city blank.</small></div>
<div class="jb-field"><label for="ExperienceYears">Your experience (years)</label><input class="c-input" id="ExperienceYears" name="ExperienceYears" type="number" min="0" max="99.9" step="0.1" value="@(Model.Search.ExperienceYears?.ToString(System.Globalization.CultureInfo.InvariantCulture))" placeholder="Any experience" /></div>
<div class="jb-field"><label for="SkillIds">Skills</label><select class="c-select jb-multiselect" id="SkillIds" name="SkillIds" multiple size="6" aria-describedby="skills-help">@foreach (var unavailable in (Model.Search.SkillIds ?? Array.Empty<int>()).Distinct().Where(id => id > 0 && !Model.Skills.Any(x => x.Id == id)).Take(12)) { <option value="@unavailable" selected>Unavailable skill (ID @unavailable)</option> }@foreach (var skill in Model.Skills) { <option value="@skill.Id" selected="@(Model.Search.SkillIds?.Contains(skill.Id) == true)">@skill.Name</option> }</select><small id="skills-help">All chosen skills must appear in the job. Up to 12. Use Ctrl/Cmd to select more than one on desktop.</small></div>
<div class="jb-field"><label for="Sort">Sort results</label><select class="c-select" id="Sort" name="Sort"><option value="Newest" selected="@(Model.Search.Sort == PublicJobSort.Newest)">Newest first</option><option value="ClosingSoon" selected="@(Model.Search.Sort == PublicJobSort.ClosingSoon)">Closing soon</option><option value="HighestStartingPay" selected="@(Model.Search.Sort == PublicJobSort.HighestStartingPay)">Highest starting pay</option></select><small>Pay sorting compares the advertised minimum, annualizing monthly amounts.</small></div>
<label class="jb-check"><input type="checkbox" name="FresherFriendlyOnly" value="true" checked="@Model.Search.FresherFriendlyOnly" /> Fresher-friendly only</label>
<button class="c-btn c-btn--primary" type="submit">Find my next role →</button><a class="jb-clear" asp-action="Index">Clear all filters</a>
</form></details>
<section class="jb-stack" aria-labelledby="job-results-heading">
@if (TempData["SavedJobMessage"] is string savedMessage) { <div class="jb-note" role="status">@savedMessage <a asp-controller="SavedJobsPage" asp-action="Index">View saved jobs</a></div> }
@if (User.IsInRole(HireGameDevRoleNames.Candidate) && User.FindFirst(HireGameDevClaimTypes.AccountType)?.Value == HireGameDevRoleNames.Candidate && Model.Results is not null && Model.SavedJobIds is null)
{ <p class="jb-muted">Saving from this page is unavailable. You can still open a job to save it.</p> }
<nav class="jb-quick-filters" aria-label="Quick job filters">
    <span>Explore:</span>
    <a href="@PublicJobUi.PageUrl(Model.Search with { WorkMode = JobWorkMode.Remote, CityId = null }, 1)" aria-current="@(Model.Search.WorkMode == JobWorkMode.Remote && !Model.Search.CityId.HasValue ? "true" : null)" title="Select remote jobs and clear the office city filter">Remote</a>
    <a href="@PublicJobUi.PageUrl(Model.Search with { FresherFriendlyOnly = true }, 1)" aria-current="@(Model.Search.FresherFriendlyOnly ? "true" : null)">Fresher-friendly</a>
    <a href="@PublicJobUi.PageUrl(Model.Search with { JobType = JobType.Internship }, 1)" aria-current="@(Model.Search.JobType == JobType.Internship ? "true" : null)">Internships</a>
</nav>
@if (PublicJobUi.HasFilters(Model.Search))
{
    <div class="jb-active-filters" aria-label="Active filters">
        <span>Active filters:</span>
        @if (!string.IsNullOrWhiteSpace(Model.Search.Keyword)) { <a href="@PublicJobUi.PageUrl(Model.Search with { Keyword = null }, 1)" aria-label="Remove keyword filter">@Model.Search.Keyword ×</a> }
        @if (Model.Search.StudioId.HasValue) { <a href="@PublicJobUi.PageUrl(Model.Search with { StudioId = null }, 1)" aria-label="Remove Studio filter">One Studio ×</a> }
        @if (Model.Search.Category.HasValue) { <a href="@PublicJobUi.PageUrl(Model.Search with { Category = null }, 1)" aria-label="Remove discipline filter">@Model.Search.Category ×</a> }
        @if (Model.Search.JobType.HasValue) { <a href="@PublicJobUi.PageUrl(Model.Search with { JobType = null }, 1)" aria-label="Remove employment type filter">@PublicJobUi.Type(Model.Search.JobType.Value) ×</a> }
        @if (Model.Search.WorkMode.HasValue) { <a href="@PublicJobUi.PageUrl(Model.Search with { WorkMode = null }, 1)" aria-label="Remove work arrangement filter">@Model.Search.WorkMode ×</a> }
        @if (Model.Search.CityId.HasValue) { <a href="@PublicJobUi.PageUrl(Model.Search with { CityId = null }, 1)" aria-label="Remove city filter">@(Model.Cities.FirstOrDefault(c => c.Id == Model.Search.CityId)?.Name ?? "City") ×</a> }
        @if (Model.Search.ExperienceYears.HasValue) { <a href="@PublicJobUi.PageUrl(Model.Search with { ExperienceYears = null }, 1)" aria-label="Remove experience filter">@Model.Search.ExperienceYears years ×</a> }
        @foreach (var skillId in (Model.Search.SkillIds ?? Array.Empty<int>()).Distinct()) { var skillName = Model.Skills.FirstOrDefault(s => s.Id == skillId)?.Name ?? "Skill"; <a href="@PublicJobUi.PageUrl(Model.Search with { SkillIds = Model.Search.SkillIds.Where(id => id != skillId).ToArray() }, 1)" aria-label="Remove @skillName skill filter">@skillName ×</a> }
        @if (Model.Search.FresherFriendlyOnly) { <a href="@PublicJobUi.PageUrl(Model.Search with { FresherFriendlyOnly = false }, 1)" aria-label="Remove fresher-friendly filter">Fresher-friendly ×</a> }
        <a asp-action="Index">Clear all</a>
    </div>
}
<div class="jb-results-head"><h2 id="job-results-heading">@(results is null ? "Check your filters" : $"{results.TotalCount} open {(results.TotalCount == 1 ? "role" : "roles")}")</h2><span class="jb-muted">@(Model.Search.Sort switch { PublicJobSort.ClosingSoon => "Closing soon", PublicJobSort.HighestStartingPay => "Highest starting pay", _ => "Newest published first" })</span></div>
@if (!ViewData.ModelState.IsValid) { <div class="jb-alert" role="alert"><strong>We couldn’t run that search.</strong><div asp-validation-summary="All"></div></div> }
@if (results is not null && results.Items.Count == 0)
{ <section class="jb-panel jb-empty"><span class="jb-eyebrow">Keep exploring</span><h2>No roles match just yet.</h2><p>@(Model.Search.StudioId.HasValue ? "This Studio has no matching open roles right now. Try fewer filters or explore all Studios." : "Try fewer skills, a wider experience range or a different work arrangement.")</p><a class="c-btn c-btn--secondary" asp-action="Index">See all open jobs</a></section> }
@if (results is not null)
{
    foreach (var job in results.Items)
    {
        var returnToJob = PublicJobUi.PageUrl(Model.Search, results.Page) + "#job-" + job.Id;
        var fit = Model.FitScores is not null && Model.FitScores.TryGetValue(job.Id, out var foundFit) ? foundFit : null;
        <article class="jb-job" id="job-@job.Id"><div class="jb-job-top"><div class="jb-studio">@if (job.Studio.LogoUrl is not null) { <img src="@job.Studio.LogoUrl" alt="" width="44" height="44" loading="lazy" /> } else { <span class="jb-monogram" aria-hidden="true">@job.Studio.Name.FirstOrDefault()</span> }<div><a asp-controller="PublicDirectory" asp-action="StudioProfile" asp-route-slug="@job.Studio.Slug">@job.Studio.Name</a><span class="jb-verified">✓ Verified Studio</span></div></div><time datetime="@job.PublishedAt.ToString("O")">@job.PublishedAt.ToString("dd MMM yyyy")</time></div>
        <h2><a asp-action="Detail" asp-route-slug="@job.Slug">@job.Title</a></h2><div class="jb-tags"><span>@PublicJobUi.Type(job.JobType)</span><span>@job.WorkMode@(job.CityName is null ? "" : " · " + job.CityName)</span><span>@PublicJobUi.Experience(job)</span>@if (job.FresherFriendly) { <span>Fresher-friendly</span> }</div>@if (Model.ShowMatches) { <div class="jb-card-fit">@if (fit?.Percentage is int score) { <span><strong>@score% match</strong><small>@fit.Coverage% of criteria assessed@(fit.Coverage < 50 ? " · Limited data" : "")</small></span> } else { <span><strong>Match unavailable</strong><small>See job for details</small></span> }</div> }<footer><strong>@PublicJobUi.Salary(job)</strong><div class="jb-job-actions">
        @if (Model.SavedJobIds is not null)
        {
            var isSaved = Model.SavedJobIds.Contains(job.Id);
            <form asp-controller="SavedJobsPage" asp-action="@(isSaved ? "Remove" : "Save")" asp-route-jobId="@job.Id" method="post">
                <input type="hidden" name="returnUrl" value="@returnToJob" />
                <button type="submit" class="c-btn c-btn--secondary c-btn--sm" aria-label="@(isSaved ? $"Remove {job.Title} from saved jobs" : $"Save {job.Title}")">@(isSaved ? "Saved ✓" : "Save job")</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnToJob" aria-label="Sign in to save @job.Title">Sign in to save</a>
        }
        <a asp-action="Detail" asp-route-slug="@job.Slug" aria-label="View @job.Title">View role →</a></div></footer></article>
    }
    if (results.TotalPages > 1)
    {
        <nav class="jb-pagination" aria-label="Search results pages"><span>Page @results.Page of @results.TotalPages</span><div>
        @if (results.Page > 1) { <a href="@PublicJobUi.PageUrl(Model.Search, results.Page - 1)" rel="prev">← Previous</a> }
        @if (results.Page < results.TotalPages) { <a href="@PublicJobUi.PageUrl(Model.Search, results.Page + 1)" rel="next">Next →</a> }
        </div></nav>
    }
}
<partial name="_ProfileCta" model="Model.RegistrationUrl" />
</section></div>
</div>
