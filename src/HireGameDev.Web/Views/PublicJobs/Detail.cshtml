@using HireGameDev.Web.Models.Jobs
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@model PublicJobDetailPage
@{
    var detail = Model.Job;
    var job = detail.Summary;
    ViewData["Title"] = $"{job.Title} at {job.Studio.Name}";
}
@section Styles {
    @if (User.Identity?.IsAuthenticated == true) { <meta name="robots" content="noindex, follow" /> }
    <link rel="canonical" href="@Model.CanonicalUrl" />
    <meta name="description" content="@($"{job.Title} at {job.Studio.Name}. {PublicJobUi.Salary(job)}. {job.WorkMode}. Explore the role, requirements and team.")" />
    <link rel="stylesheet" href="~/css/public-jobs.css" asp-append-version="true" />
    @if (Model.FitScore is not null) { <link rel="stylesheet" href="~/css/applications.css" asp-append-version="true" /> }
}
<div class="jb">
<a class="jb-back" asp-action="Index">← Explore all roles</a>
<div class="jb-detail-layout"><article class="jb-panel jb-detail">
<div class="jb-studio">@if (job.Studio.LogoUrl is not null) { <img src="@job.Studio.LogoUrl" alt="" width="56" height="56" /> } else { <span class="jb-monogram" aria-hidden="true">@job.Studio.Name.FirstOrDefault()</span> }<div><a asp-controller="PublicDirectory" asp-action="StudioProfile" asp-route-slug="@job.Studio.Slug">@job.Studio.Name</a><span class="jb-verified">✓ Verified Studio</span></div></div>
<header class="jb-detail-heading"><span class="jb-eyebrow">@detail.Category / @PublicJobUi.Type(job.JobType)</span><h1>@job.Title</h1><div class="jb-tags"><span>@job.WorkMode@(job.CityName is null ? "" : " · " + job.CityName + ", " + job.CityStateCode)</span>@if (job.FresherFriendly) { <span>Fresher-friendly</span> }@if (detail.RelocationAssistance) { <span>Relocation assistance</span> }</div></header>
<div class="jb-facts"><div><small>Compensation</small><strong>@PublicJobUi.Salary(job)</strong></div><div><small>Experience</small><strong>@PublicJobUi.Experience(job)</strong></div><div><small>Seniority</small><strong>@detail.SeniorityMin – @detail.SeniorityMax</strong></div><div><small>Openings</small><strong>@detail.Openings</strong></div></div>
<section class="jb-stack"><h2>About the opportunity</h2><p class="jb-description">@detail.Description</p></section>
<section class="jb-stack"><h2>Skills that matter</h2>
@foreach (var required in new[] { true, false })
{
    var skills = detail.Skills.Where(x => x.IsRequired == required).ToArray();
    if (skills.Length > 0)
    { <div class="jb-stack jb-stack--small"><h3>@(required ? "Required" : "Nice to have")</h3><div class="jb-tags">@foreach (var skill in skills) { <span>@skill.Name · @skill.MinProficiency</span> }</div></div> }
}
</section>
@if (!string.IsNullOrWhiteSpace(detail.ScreeningQuestion)) { <section class="jb-stack"><h2>A question to think about</h2><p class="jb-description">@detail.ScreeningQuestion</p></section> }
<footer class="jb-detail-footer"><span>Published <time datetime="@job.PublishedAt.ToString("O")">@job.PublishedAt.ToString("dd MMM yyyy")</time></span><span>Expires <time datetime="@job.ExpiresAt.ToString("O")">@job.ExpiresAt.ToString("dd MMM yyyy, HH:mm") UTC</time></span></footer>
</article>
<aside class="jb-stack">
@if (Model.FitScore is not null) { <partial name="_ApplicationFitScore" model="Model.FitScore" /> <p>Based on your current profile. Your submitted application uses a saved snapshot.</p> }
@if (TempData["SavedJobMessage"] is string savedMessage) { <div class="jb-note" role="status">@savedMessage</div> }
<section class="jb-panel jb-stack jb-stack--small" aria-label="Save this job">
@if (User.Identity?.IsAuthenticated != true)
{ <h2>Keep this role handy</h2><p>Sign in or create a Candidate account, then confirm Save when you return.</p><a class="c-btn c-btn--primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/jobs/{job.Slug}")">Sign in to save</a><a href="@Model.RegistrationUrl">Create a Candidate account</a> }
else if (Model.IsSaved.HasValue)
{ <h2>@(Model.IsSaved.Value ? "Saved to your list" : "Save for later")</h2><p>Only you can see your saved jobs.</p><form asp-controller="SavedJobsPage" asp-action="@(Model.IsSaved.Value ? "Remove" : "Save")" asp-route-jobId="@job.Id" method="post"><input type="hidden" name="slug" value="@job.Slug" /><button class="c-btn c-btn--primary" type="submit">@(Model.IsSaved.Value ? "Remove from saved jobs" : "Save job")</button></form><a asp-controller="SavedJobsPage" asp-action="Index">View saved jobs</a> }
else { <h2>Save for later</h2><p>Saving jobs is available to active Candidate accounts.</p> }
</section>
<section class="jb-panel jb-summary"><span class="jb-eyebrow">The essentials</span><h2>@PublicJobUi.Salary(job)</h2><p>@PublicJobUi.Type(job.JobType) · @job.WorkMode</p><dl><div><dt>Experience</dt><dd>@PublicJobUi.Experience(job)</dd></div><div><dt>Notice period</dt><dd>@(detail.MaxNoticeDays.HasValue ? $"Up to {detail.MaxNoticeDays} days" : "Not specified")</dd></div><div><dt>Openings</dt><dd>@detail.Openings</dd></div></dl>@if (HireGameDev.Web.Models.Applications.ApplicationFeature.Enabled(Environment) && User.IsInRole(HireGameDevRoleNames.Candidate) && User.FindFirst(HireGameDevClaimTypes.AccountType)?.Value == HireGameDevRoleNames.Candidate)
{ <div class="jb-note jb-apply"><strong>Ready to apply?</strong><p>Review your profile and consent before submitting.</p><form asp-controller="CandidateApplications" asp-action="Review" asp-route-jobId="@job.Id" method="post"><input type="hidden" name="jobSlug" value="@job.Slug" />@if (!string.IsNullOrWhiteSpace(detail.ScreeningQuestion)) { <label for="screeningAnswer">Your answer (optional)</label><textarea id="screeningAnswer" name="screeningAnswer" maxlength="2000" rows="4" placeholder="Share your answer with the Studio"></textarea> }<button type="submit" class="c-btn c-btn--primary">Review application</button></form><a asp-controller="CandidateApplications" asp-action="Index">My applications</a></div> }
else if (HireGameDev.Web.Models.Applications.ApplicationFeature.Enabled(Environment) && User.Identity?.IsAuthenticated != true) { <div class="jb-note"><strong>Applications</strong><p>Sign in with a Candidate account to review and apply.</p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/jobs/{job.Slug}")">Sign in to apply</a></div> }
else if (HireGameDev.Web.Models.Applications.ApplicationFeature.Enabled(Environment)) { <div class="jb-note"><strong>Applications</strong><p>Application submission is available only to Candidate accounts.</p></div> }
else { <div class="jb-note"><strong>Applications are not available yet.</strong><p>You can explore this role and Studio now. Application submission and tracking will be available in a future release.</p></div> }<a class="c-btn c-btn--secondary" asp-action="Index" asp-route-StudioId="@job.Studio.Id">More jobs from this Studio →</a><a class="c-btn c-btn--secondary" asp-controller="PublicDirectory" asp-action="StudioProfile" asp-route-slug="@job.Studio.Slug">Meet the Studio →</a></section>
<partial name="_ProfileCta" model="Model.RegistrationUrl" />
</aside></div>
</div>
