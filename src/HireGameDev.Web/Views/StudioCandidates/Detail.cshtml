@model HireGameDev.Web.Controllers.StudioCandidateDiscoveryDetailViewModel
@{ ViewData["Title"] = "Candidate profile"; var candidate = Model.Candidate; }
@section Styles { <meta name="robots" content="noindex, nofollow" /><link rel="stylesheet" href="~/css/candidate-discovery.css" asp-append-version="true" /> }
<div class="td">
    <div class="td-top">@if (Model.ReturnUrl is not null) { <a href="@Model.ReturnUrl">← Back to discovery</a> } else { <a asp-action="Index" asp-route-studioId="@Model.StudioId">← Back to discovery</a> }<span>HIRING / PROFILE</span></div>
    <header class="td-profile-head"><div class="td-profile-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(candidate.Name) ? "C" : candidate.Name.Trim().Substring(0, 1).ToUpperInvariant())</div><div><span class="td-kicker"><span class="td-dot"></span> DISCOVERABLE PROFILE</span><h1>@candidate.Name</h1><p>@candidate.Headline</p><div class="td-tags"><span>@candidate.Category</span><span>@candidate.Seniority</span><span>@candidate.YearsExperience.ToString("0.#") years</span>@if (!string.IsNullOrWhiteSpace(candidate.City)) { <span>@candidate.City</span> }</div></div><span class="td-status">@(candidate.Availability == CandidateAvailability.ActivelyLooking ? "Actively looking" : "Open to offers")</span></header>
    <div class="td-profile-layout"><div class="td-profile-main">
        <section class="td-profile-panel"><span class="td-section-label">01 / INTRODUCTION</span><h2>About</h2>@if (string.IsNullOrWhiteSpace(candidate.Bio)) { <p class="td-muted">No introduction provided.</p> } else { <p class="td-bio">@candidate.Bio</p> }</section>
        <section class="td-profile-panel"><span class="td-section-label">02 / EXPERTISE</span><h2>Listed skills</h2><p class="td-muted">Skills and proficiency are self-reported.</p>@if (candidate.Skills.Count == 0) { <p>No skills listed.</p> } else { <ul class="td-skill-list">@foreach (var skill in candidate.Skills) { <li><strong>@skill.Name</strong><span>@skill.Proficiency</span></li> }</ul> }</section>
    </div><aside class="td-profile-aside"><section class="td-profile-panel"><span class="td-section-label">THE DETAILS</span><h2>Work preferences</h2><p>@(candidate.OpenToRemote ? "Open to remote work" : "Remote work not selected")</p><p>@(candidate.WillingToRelocate ? "Open to relocating" : "Relocation not selected")</p></section><section class="td-profile-note"><strong>Private by design.</strong><p>This is a live profile, not an application. Contact details, compensation, private files and project credits are not shown here.</p></section><section class="td-profile-panel"><h2>Looking for a role match?</h2><p>Open one of your active jobs to see its candidate suggestions and match explanations.</p><a asp-controller="StudioJobs" asp-action="Index" asp-route-studioId="@Model.StudioId">Go to jobs →</a></section></aside></div>
</div>
