@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@model HireGameDev.Web.Models.Jobs.JobListPage
@{
    ViewData["Title"] = "Studio Jobs";
    var planUsage = ViewData["StudioPlanUsage"] as HireGameDev.Web.Models.Jobs.StudioPlanUsage;
    var canWrite = Model.Studio.MemberRole is StudioMemberRole.Owner or StudioMemberRole.Recruiter;
}
@section Styles { <link rel="stylesheet" href="~/css/studio-jobs.css" asp-append-version="true" /> }
<div class="jw jw-desk">
    <div class="desk-topline"><a asp-controller="Studio" asp-action="EditProfile" asp-route-studioId="@Model.Studio.StudioId">← Studio workspace</a><span>HIRING / JOBS</span></div>
    <header class="desk-hero">
        <div><div class="desk-kicker"><span class="desk-dot"></span> @Model.Studio.Name · HIRING WORKSPACE</div><h1>Make your next<br /><em>great hire.</em></h1><p>Manage your open roles and the people applying to them, all in one place.</p></div>
        <div class="desk-hero-action">@if (canWrite) { <a class="desk-primary" asp-action="Create" asp-route-studioId="@Model.Studio.StudioId"><span>＋</span> Create a job</a> }<span>@(canWrite ? "Start with a draft, publish when ready." : "You have view-only access.")</span></div>
    </header>
    @if (HireGameDev.Web.Models.Applications.ApplicationFeature.Enabled(Environment)) { <p><a asp-controller="StudioCandidates" asp-action="Index" asp-route-studioId="@Model.Studio.StudioId">Discover candidates →</a></p> }
    @if (Model.Memberships.Count > 1) { <nav class="desk-workspaces" aria-label="Workspaces"><span>WORKSPACE</span>@foreach (var membership in Model.Memberships) { <a asp-action="Index" asp-route-studioId="@membership.StudioId" aria-current="@(membership.StudioId == Model.Studio.StudioId ? "page" : null)">@membership.Name</a> }</nav> }
    @if (planUsage is not null) { <div class="jw-note"><strong>@planUsage.Plan plan · @planUsage.Occupied / @planUsage.Limit job slots occupied</strong><p>Unexpired active, paused and full jobs use slots. @if (planUsage.Postings is { } posting) { <span>@posting.Used / @posting.Limit postings used in the last 30 days. First publication and renewal count; closing a job does not refund a posting. @if (posting.NextAvailableAt.HasValue) { <span>Next posting available: @posting.NextAvailableAt.Value.ToUniversalTime().ToString("dd MMM yyyy, HH:mm") UTC.</span> } else if (posting.Limit == 0) { <span>The posting allowance is currently zero.</span> }</span> } Limits are checked again when you act.</p></div> }
    @if (TempData["StatusMessage"] is string message) { <div class="jw-notice jw-notice--success" role="status">@message</div> }
    @if (Model.Studio.VerificationStatus != StudioVerificationStatus.Verified) { <div class="jw-notice"><strong>Prepare now. Publish once verified.</strong><p>You can save drafts while your Studio is @Model.Studio.VerificationStatus.ToString().ToLowerInvariant().</p><a asp-controller="Studio" asp-action="Verification" asp-route-studioId="@Model.Studio.StudioId">View Studio verification →</a></div> }
    <div class="desk-layout">
        <aside class="desk-sidebar"><div class="desk-sidebar-title">YOUR PIPELINE <span>↗</span></div><nav aria-label="Job status" class="desk-nav">
            <a asp-action="Index" asp-route-studioId="@Model.Studio.StudioId" aria-current="@(!Model.Filter.HasValue ? "page" : null)"><span>All jobs</span><b>@Model.Jobs.Counts.Values.Sum()</b></a>
            @foreach (var status in Enum.GetValues<JobStatus>()) { <a asp-action="Index" asp-route-studioId="@Model.Studio.StudioId" asp-route-status="@status" aria-current="@(Model.Filter == status ? "page" : null)"><span>@status</span><b>@Model.Jobs.Counts.GetValueOrDefault(status)</b></a> }
        </nav><div class="desk-sidebar-note"><strong>A little help</strong><p>Select a role to manage it, or open its applicants to review submissions.</p></div></aside>
        <section class="desk-content" aria-label="Job listings">
            <div class="desk-section-head"><div><span class="desk-overline">YOUR JOBS / @(Model.Filter?.ToString().ToUpperInvariant() ?? "ALL")</span><h2>@(Model.Filter.HasValue ? $"{Model.Filter} jobs" : "All jobs") <span>@(Model.Filter.HasValue ? Model.Jobs.Counts.GetValueOrDefault(Model.Filter.Value) : Model.Jobs.Counts.Values.Sum())</span></h2><p>Roles in @Model.Studio.Name</p></div></div>
            @if (Model.Jobs.Items.Count == 0) { <div class="desk-empty"><span class="desk-empty-icon">↗</span><h3>@(Model.Filter.HasValue ? "Nothing in this view" : "Your next hire starts here")</h3><p>@(Model.Filter.HasValue ? "There are no jobs with this status. Try another view." : canWrite ? "Create your first job and build it at your own pace." : "Jobs created by your team will appear here.")</p>@if (Model.Filter.HasValue) { <a asp-action="Index" asp-route-studioId="@Model.Studio.StudioId">View all jobs →</a> } else if (canWrite) { <a class="desk-primary" asp-action="Create" asp-route-studioId="@Model.Studio.StudioId">Create a job →</a> }</div> }
            else { <div class="desk-jobs">@foreach (var job in Model.Jobs.Items) { var title = string.IsNullOrWhiteSpace(job.Title) ? "Untitled draft" : job.Title;
                <article class="desk-job"><div class="desk-job-index" aria-hidden="true">↗</div><div class="desk-job-info"><div class="desk-job-heading"><span class="jw-badge" data-status="@job.Status">@job.Status</span><span class="desk-job-date">UPDATED @job.UpdatedAt.ToString("dd MMM yyyy").ToUpperInvariant()</span></div><h3><a asp-action="Manage" asp-route-id="@job.Id" asp-route-studioId="@Model.Studio.StudioId">@title</a></h3><p>Expires @(job.ExpiresAt?.ToString("dd MMM yyyy") ?? "when published")</p></div><div class="desk-job-links">@if (HireGameDev.Web.Models.Applications.ApplicationFeature.Enabled(Environment)) { <a class="desk-applicants" asp-controller="StudioApplications" asp-action="Index" asp-route-jobId="@job.Id" asp-route-studioId="@Model.Studio.StudioId" aria-label="View applicants for @title">Applicants <span>↗</span></a> }@if (HireGameDev.Web.Models.Applications.ApplicationFeature.Enabled(Environment) && Model.Studio.VerificationStatus == StudioVerificationStatus.Verified && job.Status == JobStatus.Active && job.ExpiresAt > DateTimeOffset.UtcNow) { <a class="desk-manage" asp-controller="StudioCandidateRecommendations" asp-action="Index" asp-route-jobId="@job.Id" asp-route-studioId="@Model.Studio.StudioId" aria-label="Find matching candidates for @title">Find candidates →</a> }<a class="desk-manage" asp-action="Manage" asp-route-id="@job.Id" asp-route-studioId="@Model.Studio.StudioId" aria-label="Manage @title">Manage job →</a></div></article>
            }</div> }
            @if (Model.Jobs.TotalPages > 1) { <nav class="desk-pages" aria-label="Pagination"><span>Page @Model.Jobs.Page of @Model.Jobs.TotalPages</span><div>@for (var pageNumber = Math.Max(1, Model.Jobs.Page - 2); pageNumber <= Math.Min(Model.Jobs.TotalPages, Model.Jobs.Page + 2); pageNumber++) { <a class="jw-tab" asp-action="Index" asp-route-studioId="@Model.Studio.StudioId" asp-route-status="@Model.Filter" asp-route-page="@pageNumber" aria-current="@(pageNumber == Model.Jobs.Page ? "page" : null)">@pageNumber</a> }</div></nav> }
            <p class="desk-footnote">Expired jobs cannot accept applications, even before their stored status updates. All dates shown in UTC.</p>
        </section>
    </div>
</div>
