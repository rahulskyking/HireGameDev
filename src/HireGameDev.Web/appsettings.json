{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Portals": {
    "DeploymentMode": "All",
    "LandingBaseUrl": "https://hiregamedev.com",
    "JobsBaseUrl": "https://jobs.hiregamedev.com",
    "StudioBaseUrl": "https://studio.hiregamedev.com",
    "SharedCookieDomain": "",
    "RedirectWwwToApex": true,
    "DataProtectionApplicationName": "HireGameDev",
    "DataProtectionKeysPath": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Email": {
    "Provider": "Dev",
    "FromAddress": "noreply@hiregamedev.com",
    "FromName": "HireGameDev",
    "ResendApiKey": "",
    "DevOutputDirectory": "logs/emails"
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/uploads",
      "PublicRoutePrefix": "/Media/Public"
    },
    "CloudflareR2": {
      "AccountId": "",
      "ServiceUrl": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "PrivateBucket": "",
      "PublicBucket": "",
      "PublicBaseUrl": ""
    }
  },
  "Networking": {
    "ForwardLimit": 1,
    "TrustedProxies": [],
    "TrustedNetworks": []
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hiregamedev-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({RequestId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
