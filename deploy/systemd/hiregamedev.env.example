# /etc/hiregamedev/hiregamedev.env (chmod 0600, chown root:hiregamedev)
# Template only — NEVER commit real production secrets to Git.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
DOTNET_PRINT_TELEMETRY_MESSAGE=false

# Allowed Host headers (strictly enforced by HostFilteringMiddleware & XForwardedHost)
AllowedHosts=hiregamedev.com;www.hiregamedev.com;jobs.hiregamedev.com;studio.hiregamedev.com

# PostgreSQL 16 connection string
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=hiregamedev;Username=hiregamedev_app;Password=CHANGE_ME_STRONG_DB_PASSWORD

# Three-domain portal & shared cookie/DataProtection settings (ADR-012)
Portals__DeploymentMode=All
Portals__LandingHost=hiregamedev.com
Portals__JobsHost=jobs.hiregamedev.com
Portals__StudioHost=studio.hiregamedev.com
Portals__SharedCookieDomain=.hiregamedev.com
Portals__DataProtectionApplicationName=HireGameDev
Portals__DataProtectionKeysPath=/var/lib/hiregamedev/keys

# Transactional Email (ADR-007 — Resend)
Email__Provider=Resend
Email__FromAddress=no-reply@hiregamedev.com
Email__FromName=HireGameDev
Email__Resend__ApiKey=CHANGE_ME_RESEND_API_KEY

# Object Storage (ADR-016 — Local outside wwwroot now; switch Storage__Provider=CloudflareR2 later)
Storage__Provider=Local
Storage__Local__RootPath=/var/lib/hiregamedev/uploads
Storage__Local__PublicRoutePrefix=/Media/Public

# OAuth SSO (ADR-006 — Google for Candidate+Studio, GitHub for Candidate only)
Authentication__Google__ClientId=CHANGE_ME_GOOGLE_CLIENT_ID
Authentication__Google__ClientSecret=CHANGE_ME_GOOGLE_CLIENT_SECRET
Authentication__GitHub__ClientId=CHANGE_ME_GITHUB_CLIENT_ID
Authentication__GitHub__ClientSecret=CHANGE_ME_GITHUB_CLIENT_SECRET
